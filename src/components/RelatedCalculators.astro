---
import type { RelatedLink } from '../lib/internal-links';
import { getCalculatorLinks } from '../lib/internal-links';

interface Props {
  /** Current calculator href, used to auto-look up related links. */
  currentHref?: string;
  /** Override the auto-lookup with explicit links. */
  calculators?: RelatedLink[];
  /** Section heading override. */
  heading?: string;
}

type HubLink = { href: string; title: string; icon: string };
type QuickAnswer = {
  heading: string;
  summary: string;
  assumptions: string[];
  sources: Array<{ label: string; href: string }>;
};

const {
  currentHref = Astro.url.pathname,
  calculators: explicitCalcs,
  heading = 'เครื่องคำนวณที่เกี่ยวข้อง',
} = Astro.props;

const links = explicitCalcs ?? getCalculatorLinks(currentHref).calculators;

const decodedHref = (() => {
  try {
    return decodeURIComponent(currentHref).toLowerCase();
  } catch {
    return currentHref.toLowerCase();
  }
})();

const includesAny = (needles: string[]) => needles.some((needle) => decodedHref.includes(needle));

const quickAnswer: QuickAnswer = (() => {
  if (includesAny(['tax', 'ภาษี', 'ลดหย่อน', 'vat'])) {
    return {
      heading: 'สรุปก่อนใช้ตัวเลขนี้',
      summary: 'ผลคำนวณเป็นค่าประมาณเพื่อวางแผนภาษีหรือค่าใช้จ่าย ก่อนยื่นจริงควรตรวจสอบอัตราและเงื่อนไขล่าสุดจากหน่วยงานทางการ',
      assumptions: [
        'คำนวณจากข้อมูลที่คุณกรอกและอัตราที่ระบุในหน้าเครื่องมือ',
        'กรณีพิเศษอาจต้องใช้หลักฐานหรือเงื่อนไขเพิ่มเติม',
        'ตัวเลขสุดท้ายอาจเปลี่ยนตามเอกสารจริงและประกาศของหน่วยงานรัฐ',
      ],
      sources: [
        { label: 'กรมสรรพากร', href: 'https://www.rd.go.th/' },
        { label: 'วิธีคำนวณและแหล่งอ้างอิง', href: '/about/methodology/' },
      ],
    };
  }

  if (includesAny(['loan', 'ผ่อน', 'สินเชื่อ', 'กู้', 'บ้าน', 'รถ'])) {
    return {
      heading: 'ใช้ผลลัพธ์เพื่อเทียบข้อเสนอ',
      summary: 'ค่างวดและดอกเบี้ยเป็นตัวเลขสำหรับคัดกรองแผนเบื้องต้น ก่อนสมัครจริงควรเทียบอัตรา ค่าธรรมเนียม และเงื่อนไขจากผู้ให้บริการ',
      assumptions: [
        'คำนวณตามเงินต้น อัตรา และระยะเวลาที่คุณป้อน',
        'ยังไม่รวมค่าธรรมเนียมบางประเภท ประกัน หรือเงื่อนไขโปรโมชันเฉพาะราย',
        'ควรให้ค่างวดรวมไม่กดดันกระแสเงินสดรายเดือน',
      ],
      sources: [
        { label: 'ธนาคารแห่งประเทศไทย', href: 'https://www.bot.or.th/' },
        { label: 'วิธีคำนวณและแหล่งอ้างอิง', href: '/about/methodology/' },
      ],
    };
  }

  if (includesAny(['salary', 'เงินเดือน', 'ค่าแรง', 'โอที', 'ชดเชย'])) {
    return {
      heading: 'อ่านผลลัพธ์คู่กับสลิปจริง',
      summary: 'ผลเงินเดือนและค่าแรงเป็นการคำนวณจากข้อมูลที่กรอก ใช้เพื่อวางแผนและตรวจสอบเบื้องต้นก่อนเทียบกับสลิปหรือเอกสารจากนายจ้าง',
      assumptions: [
        'ใช้ฐานภาษี ประกันสังคม และเงื่อนไขมาตรฐานของเครื่องมือ',
        'ไม่รวมสวัสดิการหรือข้อตกลงเฉพาะของแต่ละบริษัท',
        'กรณีข้อพิพาทควรตรวจสอบเอกสารจ้างงานและกฎหมายแรงงานล่าสุด',
      ],
      sources: [
        { label: 'สำนักงานประกันสังคม', href: 'https://www.sso.go.th/' },
        { label: 'กรมสรรพากร', href: 'https://www.rd.go.th/' },
      ],
    };
  }

  return {
    heading: 'สรุปก่อนตัดสินใจ',
    summary: 'ผลคำนวณนี้เหมาะสำหรับวางแผนเบื้องต้น ควรตรวจสอบตัวเลขจริงจากเอกสารหรือแหล่งทางการก่อนใช้ตัดสินใจสำคัญ',
    assumptions: [
      'ระบบคำนวณจากข้อมูลที่คุณป้อนในหน้านี้',
      'กรณีพิเศษอาจต้องใช้ข้อมูลเพิ่มเติม',
      'แนะนำให้บันทึกหรือเทียบผลกับเครื่องมือที่เกี่ยวข้องด้านล่าง',
    ],
    sources: [
      { label: 'วิธีคำนวณและแหล่งอ้างอิง', href: '/about/methodology/' },
    ],
  };
})();

const hubLinks: HubLink[] = [];

if (includesAny(['ภาษี', 'ลดหย่อน', 'tax', 'vat'])) {
  hubLinks.push(
    { href: '/เปรียบเทียบเครื่องคำนวณภาษี/', title: 'เปรียบเทียบเครื่องคำนวณภาษี', icon: '📊' },
    { href: '/ตรวจสอบหักลดหย่อนภาษี/', title: 'เช็กลิสต์ลดหย่อนภาษี', icon: '✅' },
    { href: '/ตัวช่วยคำนวณการเงิน/', title: 'ศูนย์รวมเครื่องคำนวณการเงิน', icon: '💰' },
  );
} else if (includesAny(['loan', 'ผ่อน', 'สินเชื่อ', 'กู้', 'รถ', 'บ้าน'])) {
  hubLinks.push(
    { href: '/เปรียบเทียบสินเชื่อ/', title: 'เปรียบเทียบสินเชื่อทุกประเภท', icon: '🏦' },
    { href: '/เครื่องคำนวณรถยนต์/', title: 'เครื่องคำนวณรถยนต์', icon: '🚗' },
    { href: '/ตัวช่วยคำนวณการเงิน/', title: 'ศูนย์รวมเครื่องคำนวณการเงิน', icon: '💰' },
  );
} else if (includesAny(['เงินเดือน', 'เงินค่า', 'ค่าแรง', 'โบนัส', 'ชดเชย'])) {
  hubLinks.push(
    { href: '/เครื่องคำนวณเงินเดือนและค่าแรง/', title: 'เครื่องคำนวณเงินเดือนและค่าแรง', icon: '💼' },
    { href: '/ตัวช่วยคำนวณการเงิน/', title: 'ศูนย์รวมเครื่องคำนวณการเงิน', icon: '💰' },
  );
} else if (includesAny(['bmi', 'สุขภาพ', 'แคลอรี', 'วันคลอด', 'น้ำหนัก'])) {
  hubLinks.push({ href: '/เครื่องคำนวณสุขภาพ/', title: 'เครื่องคำนวณสุขภาพทั้งหมด', icon: '🏥' });
} else if (includesAny(['ไฟฟ้า', 'น้ำ', 'ค่าส่ง', 'internet', 'ค่าใช้จ่าย'])) {
  hubLinks.push({ href: '/เครื่องคำนวณค่าใช้จ่ายบ้าน/', title: 'เครื่องคำนวณค่าใช้จ่ายในบ้าน', icon: '🔧' });
} else if (includesAny(['ออม', 'ลงทุน', 'rmf', 'ssf', 'เกษียณ'])) {
  hubLinks.push(
    { href: '/เครื่องคำนวณออมเงินและการลงทุน/', title: 'เครื่องคำนวณออมเงินและลงทุน', icon: '💹' },
    { href: '/แผนการเกษียณ/', title: 'วางแผนเกษียณ', icon: '🌴' },
  );
} else {
  hubLinks.push(
    { href: '/ตัวช่วยคำนวณการเงิน/', title: 'ศูนย์รวมเครื่องคำนวณการเงิน', icon: '💰' },
    { href: '/เครื่องคำนวณการเงินชั้นยอด/', title: 'เครื่องคำนวณยอดนิยม', icon: '⭐' },
  );
}
---

<section class="ct-related-calculators" aria-labelledby="related-calculators-heading">
  <div class="ct-trust-panel ai-quick-answer">
    <div class="ct-trust-panel__eyebrow">ตรวจสอบก่อนใช้ผลลัพธ์</div>
    <h2 class="ct-trust-panel__title">{quickAnswer.heading}</h2>
    <p class="ct-trust-panel__summary">{quickAnswer.summary}</p>
    <ul class="ct-trust-panel__list">
      {quickAnswer.assumptions.map((assumption) => <li>{assumption}</li>)}
    </ul>
    <div class="ct-trust-panel__sources" aria-label="แหล่งอ้างอิง">
      {quickAnswer.sources.map((source) => (
        <a
          href={source.href}
          target={source.href.startsWith('http') ? '_blank' : undefined}
          rel={source.href.startsWith('http') ? 'noopener noreferrer' : undefined}
        >
          {source.label}
        </a>
      ))}
    </div>
  </div>

  {links.length > 0 && (
    <div class="ct-related-block">
      <div class="ct-section-heading-row">
        <h2 id="related-calculators-heading">{heading}</h2>
        <span>เลือกต่อจากผลลัพธ์นี้</span>
      </div>
      <div class="ct-related-grid">
        {links.slice(0, 5).map((link) => (
          <a
            href={link.href}
            data-preserve-utm
            data-ct-event="related_calc_click"
            class="ct-related-card"
          >
            <span class="ct-related-card__title">{link.title}</span>
            {link.desc && <span class="ct-related-card__desc">{link.desc}</span>}
          </a>
        ))}
      </div>
    </div>
  )}

  <div class="ct-hub-links" aria-label="คู่มือและเครื่องมือที่เกี่ยวข้อง">
    <h2>คู่มือและเครื่องมือที่เกี่ยวข้อง</h2>
    <div class="ct-hub-links__row">
      {hubLinks.map((hub) => (
        <a href={hub.href} class="ct-hub-link">
          <span aria-hidden="true">{hub.icon}</span>
          <span>{hub.title}</span>
        </a>
      ))}
      <a href="/เลือกเครื่องคำนวณ/" class="ct-hub-link ct-hub-link--muted">
        <span aria-hidden="true">⌕</span>
        <span>ช่วยเลือกเครื่องคำนวณ</span>
      </a>
    </div>
  </div>
</section>
