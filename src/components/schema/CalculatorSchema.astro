---
/**
 * CalculatorSchema.astro
 *
 * Generates valid WebApplication JSON-LD for calculator pages.
 * Keeps calculator semantics in supported properties instead of using
 * non-standard schema.org types such as TaxCalculator or LoanCalculator.
 */

interface Props {
  siteUrl: string;
  name: string;
  description: string;
  url: string;
  calculatorType: 'TaxCalculator' | 'LoanCalculator' | 'SalaryCalculator' | 'Calculator';
  currency?: string;
}

const {
  siteUrl,
  name,
  description,
  url,
  calculatorType,
  currency = 'THB',
} = Astro.props;

const applicationCategoryByType = {
  TaxCalculator: 'FinanceApplication',
  LoanCalculator: 'FinanceApplication',
  SalaryCalculator: 'FinanceApplication',
  Calculator: 'UtilitiesApplication',
} as const;

const topicByType = {
  TaxCalculator: 'Thai tax calculator',
  LoanCalculator: 'Loan and installment calculator',
  SalaryCalculator: 'Salary and payroll calculator',
  Calculator: 'Online calculator',
} as const;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': `${url}#calculator-app`,
  name,
  description,
  url,
  'applicationCategory': applicationCategoryByType[calculatorType],
  'operatingSystem': 'Any',
  'inLanguage': 'th-TH',
  'isAccessibleForFree': true,
  'mainEntityOfPage': url,
  'about': {
    '@type': 'Thing',
    'name': topicByType[calculatorType],
  },
  'featureList': [
    'Instant online calculation',
    'Thai-language user interface',
    'Mobile-friendly calculator inputs',
    'No account required',
  ],
  'author': {
    '@type': 'Organization',
    'name': 'Kamnuanlek',
    'url': siteUrl,
  },
  'publisher': {
    '@type': 'Organization',
    'name': 'Kamnuanlek',
    'url': siteUrl,
  },
  'offers': {
    '@type': 'Offer',
    'price': '0',
    'priceCurrency': currency,
    'availability': 'https://schema.org/InStock',
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
