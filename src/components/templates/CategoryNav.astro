---
// CategoryNav — Professional redesign with full dark/light mode support
// Desktop: collapsible left sidebar with 8 categories + search shortcut
// Mobile: sticky bottom tab bar with top 5 categories
// Renders on every page via BaseLayout.

export interface NavCategory {
  slug: string;
  name: string;
  shortName: string;
  icon: string;
  mobileTab?: boolean;
}

const categories: NavCategory[] = [
  { slug: 'ภาษี',               name: 'เครื่องคำนวณภาษี',              shortName: 'ภาษี',         icon: '💰', mobileTab: true  },
  { slug: 'สินเชื่อ',            name: 'เครื่องคำนวณสินเชื่อ',            shortName: 'สินเชื่อ',        icon: '🏠', mobileTab: true  },
  { slug: 'การออม',           name: 'เครื่องคำนวณการออมและการลงทุน',  shortName: 'ออมทรัพย์',    icon: '🏦', mobileTab: false },
  { slug: 'เงินเดือน',       name: 'เครื่องคำนวณเงินเดือนและแรงงาน', shortName: 'เงินเดือน',   icon: '📊', mobileTab: true  },
  { slug: 'ค่าใช้จ่ายบ้าน',  name: 'เครื่องคำนวณค่าใช้จ่ายบ้าน',  shortName: 'บ้าน',        icon: '🏡', mobileTab: false },
  { slug: 'บัตรเครดิต',       name: 'เครื่องคำนวณบัตรเครดิต',        shortName: 'บัตร',         icon: '💳', mobileTab: false },
  { slug: 'สุขภาพ',          name: 'เครื่องคำนวณสุขภาพและชีวิต',  shortName: 'สุขภาพ',      icon: '❤️',    mobileTab: true  },
  { slug: 'เครื่องมือทั่วไป', name: 'เครื่องมือคำนวณทั่วไป',   shortName: 'ทั่วไป',       icon: '🧰', mobileTab: false },
];

const mobileTabs = categories.filter(c => c.mobileTab);

const currentPath = Astro.url.pathname;
---

<!-- Desktop: Sticky left sidebar (hidden on mobile) -->
<aside class="ct-cat-sidebar" aria-label="หมวดหมู่เครื่องคำนวณ">
  <div class="ct-cat-sidebar-inner">

    <div class="ct-cat-sidebar-header">
      <div class="ct-cat-header-label">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" class="ct-cat-header-icon">
          <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <span class="ct-cat-sidebar-title">หมวดหมู่</span>
      </div>
      <button
        type="button"
        class="ct-cat-sidebar-toggle"
        aria-label="ย่อ/ขยายเมนู"
        aria-expanded="true"
        data-sidebar-toggle
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M15 18l-6-6 6-6"/>
        </svg>
      </button>
    </div>

    <nav class="ct-cat-list" data-sidebar-content>
      {categories.map((cat) => (
        <a
          href={`/หมวดหมู่/${cat.slug}/`}
          class={`ct-cat-item${currentPath.includes(cat.slug) ? ' ct-cat-active' : ''}`}
          aria-current={currentPath.includes(cat.slug) ? 'page' : undefined}
        >
          <span class="ct-cat-icon" aria-hidden="true">{cat.icon}</span>
          <span class="ct-cat-label">{cat.name}</span>
          <svg class="ct-cat-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M9 18l6-6-6-6"/>
          </svg>
        </a>
      ))}
    </nav>

    <div class="ct-cat-sidebar-footer">
      <a href="/" class="ct-cat-all-link">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
        </svg>
        ดูทุกหมวดหมู่
      </a>
    </div>

  </div>
</aside>

<!-- Mobile: Sticky bottom tabs (hidden on desktop) -->
<nav class="ct-cat-tabs" aria-label="เมนูหมวดหมู่">
  {mobileTabs.map((cat) => (
    <a
      href={`/หมวดหมู่/${cat.slug}/`}
      class={`ct-tab-item${currentPath.includes(cat.slug) ? ' ct-tab-active' : ''}`}
      aria-current={currentPath.includes(cat.slug) ? 'page' : undefined}
    >
      <span class="ct-tab-icon" aria-hidden="true">{cat.icon}</span>
      <span class="ct-tab-label">{cat.shortName}</span>
      {currentPath.includes(cat.slug) && <span class="ct-tab-pip" aria-hidden="true"></span>}
    </a>
  ))}
</nav>

<style>
  /* ─────────────────────────────────────────────────────────
     CSS Custom Properties — light defaults, dark overrides
  ───────────────────────────────────────────────────────── */
  .ct-cat-sidebar,
  .ct-cat-tabs {
    --nav-bg:          rgba(255, 255, 255, 0.78);
    --nav-bg-hover:    rgba(0, 122, 255, 0.08);
    --nav-bg-active:   rgba(0, 199, 190, 0.12);
    --nav-border:      rgba(15, 23, 42, 0.1);
    --nav-border-accent: #007aff;
    --nav-shadow:      0 14px 32px rgba(15, 23, 42, 0.1), 0 1px 0 rgba(255, 255, 255, 0.72) inset;
    --nav-text:        #1e293b;
    --nav-text-muted:  #64748b;
    --nav-text-active: #007aff;
    --nav-title-color: #64748b;
    --nav-icon-bg:     rgba(255, 255, 255, 0.72);
    --nav-footer-bg:   rgba(243, 247, 251, 0.72);
    --nav-footer-text: #64748b;
    --nav-footer-hover:#007aff;
    --nav-tab-bg:      rgba(255, 255, 255, 0.78);
    --nav-tab-border:  rgba(15, 23, 42, 0.1);
    --nav-tab-text:    #64748b;
    --nav-tab-active:  #007aff;
    --nav-pip:         #00c7be;
    --nav-shadow-top:  0 14px 36px rgba(15, 23, 42, 0.18), 0 1px 0 rgba(255, 255, 255, 0.72) inset;
  }

  /* Dark mode overrides */
  html[data-theme='dark'] .ct-cat-sidebar,
  html[data-theme='dark'] .ct-cat-tabs {
    --nav-bg:          rgba(15, 23, 42, 0.78);
    --nav-bg-hover:    rgba(96, 165, 250, 0.12);
    --nav-bg-active:   rgba(34, 211, 238, 0.14);
    --nav-border:      rgba(148, 163, 184, 0.2);
    --nav-border-accent: #67e8f9;
    --nav-shadow:      0 16px 36px rgba(0,0,0,0.34), 0 1px 0 rgba(255, 255, 255, 0.06) inset;
    --nav-text:        #cbd5e1;
    --nav-text-muted:  #94a3b8;
    --nav-text-active: #67e8f9;
    --nav-title-color: #94a3b8;
    --nav-icon-bg:     rgba(148, 163, 184, 0.12);
    --nav-footer-bg:   rgba(15, 23, 42, 0.54);
    --nav-footer-text: #94a3b8;
    --nav-footer-hover:#67e8f9;
    --nav-tab-bg:      rgba(15, 23, 42, 0.8);
    --nav-tab-border:  rgba(148, 163, 184, 0.22);
    --nav-tab-text:    #94a3b8;
    --nav-tab-active:  #67e8f9;
    --nav-pip:         #22d3ee;
    --nav-shadow-top:  0 14px 38px rgba(0,0,0,0.5), 0 1px 0 rgba(255, 255, 255, 0.06) inset;
  }

  /* ─────────────────────────────────────────────────────────
     Desktop Sidebar
  ───────────────────────────────────────────────────────── */
  .ct-cat-sidebar {
    display: none;
  }

  @media (min-width: 1024px) {
    .ct-cat-sidebar {
      display: block;
      width: 220px;
      flex-shrink: 0;
    }

    .ct-cat-sidebar-inner {
      position: sticky;
      top: 72px;
      background: var(--nav-bg);
      border: 1px solid var(--nav-border);
      border-radius: 18px;
      overflow: hidden;
      box-shadow: var(--nav-shadow);
      -webkit-backdrop-filter: blur(20px) saturate(1.18);
      backdrop-filter: blur(20px) saturate(1.18);
      transition: background 0.2s, border-color 0.2s, box-shadow 0.2s;
    }

    /* Header */
    .ct-cat-sidebar-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 14px 10px;
      border-bottom: 1px solid var(--nav-border);
      background: var(--nav-bg);
    }

    .ct-cat-header-label {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .ct-cat-header-icon {
      color: var(--nav-text-muted);
      flex-shrink: 0;
    }

    .ct-cat-sidebar-title {
      font-size: 0.68rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0;
      color: var(--nav-title-color);
      transition: color 0.2s;
    }

    .ct-cat-sidebar-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      background: var(--nav-icon-bg);
      border: 1px solid var(--nav-border);
      border-radius: 999px;
      cursor: pointer;
      color: var(--nav-text-muted);
      transition: color 0.15s, background 0.15s, border-color 0.15s;
    }
    .ct-cat-sidebar-toggle:hover {
      color: var(--nav-text-active);
      background: var(--nav-bg-hover);
      border-color: var(--nav-border-accent);
    }
    .ct-cat-sidebar-toggle svg {
      transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .ct-cat-sidebar-toggle[aria-expanded="false"] svg {
      transform: rotate(180deg);
    }

    /* Nav list */
    .ct-cat-list {
      padding: 6px 0;
    }
    .ct-cat-list[hidden] { display: none; }

    .ct-cat-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 9px 14px;
      font-size: 0.8rem;
      font-weight: 500;
      color: var(--nav-text);
      text-decoration: none;
      border-left: 3px solid transparent;
      border-radius: 12px;
      margin: 2px 6px;
      transition: background 0.15s, color 0.15s, border-color 0.15s, transform 0.15s;
      position: relative;
    }

    .ct-cat-item:hover {
      background: var(--nav-bg-hover);
      color: var(--nav-text-active);
      border-left-color: color-mix(in srgb, var(--nav-border-accent) 40%, transparent);
      transform: translateX(2px);
    }

    .ct-cat-item.ct-cat-active {
      background: var(--nav-bg-active);
      color: var(--nav-text-active);
      font-weight: 600;
      border-left-color: var(--nav-border-accent);
    }

    .ct-cat-icon {
      font-size: 1rem;
      flex-shrink: 0;
      line-height: 1;
      width: 22px;
      text-align: center;
    }

    .ct-cat-label {
      flex: 1;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      line-height: 1.3;
    }

    .ct-cat-chevron {
      color: var(--nav-text-muted);
      opacity: 0;
      transform: translateX(-4px);
      transition: opacity 0.15s, transform 0.15s, color 0.15s;
      flex-shrink: 0;
    }
    .ct-cat-item:hover .ct-cat-chevron,
    .ct-cat-item.ct-cat-active .ct-cat-chevron {
      opacity: 1;
      transform: translateX(0);
      color: var(--nav-text-active);
    }

    /* Footer */
    .ct-cat-sidebar-footer {
      border-top: 1px solid var(--nav-border);
      background: var(--nav-footer-bg);
      padding: 8px 14px;
      transition: background 0.2s, border-color 0.2s;
    }

    .ct-cat-all-link {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--nav-footer-text);
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 0;
      transition: color 0.15s;
    }
    .ct-cat-all-link:hover {
      color: var(--nav-footer-hover);
    }
    .ct-cat-all-link svg {
      flex-shrink: 0;
    }
  }

  /* ─────────────────────────────────────────────────────────
     Mobile Bottom Tabs
  ───────────────────────────────────────────────────────── */
  .ct-cat-tabs {
    display: flex;
    position: fixed;
    bottom: calc(10px + env(safe-area-inset-bottom, 0px));
    left: max(12px, env(safe-area-inset-left, 0px));
    right: max(12px, env(safe-area-inset-right, 0px));
    min-height: var(--ct-mobile-nav-height, 76px);
    background: var(--nav-tab-bg);
    border: 1px solid var(--nav-tab-border);
    border-radius: 22px;
    box-shadow: var(--nav-shadow-top);
    z-index: 100;
    padding: 6px;
    -webkit-backdrop-filter: blur(22px) saturate(1.22);
    backdrop-filter: blur(22px) saturate(1.22);
    transition: background 0.2s, border-color 0.2s, box-shadow 0.2s;
  }

  .ct-tab-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 8px 4px 7px;
    text-decoration: none;
    color: var(--nav-tab-text);
    min-height: 58px;
    position: relative;
    border-radius: 16px;
    transition: color 0.15s, background 0.15s;
    -webkit-tap-highlight-color: transparent;
  }

  .ct-tab-item::before {
    content: '';
    position: absolute;
    top: auto;
    left: 18%;
    right: 18%;
    bottom: 4px;
    height: 3px;
    background: var(--nav-tab-active);
    border-radius: 999px;
    opacity: 0;
    transform: scaleX(0);
    transition: opacity 0.2s, transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ct-tab-item.ct-tab-active {
    color: var(--nav-tab-active);
    background: color-mix(in srgb, var(--nav-tab-active) 9%, transparent);
  }

  .ct-tab-item.ct-tab-active::before {
    opacity: 1;
    transform: scaleX(1);
  }

  .ct-tab-item:hover {
    color: var(--nav-tab-active);
    background: color-mix(in srgb, var(--nav-tab-active) 6%, transparent);
  }

  .ct-tab-icon {
    font-size: 1.2rem;
    line-height: 1;
    margin-bottom: 3px;
    transition: transform 0.15s;
  }

  .ct-tab-item.ct-tab-active .ct-tab-icon {
    transform: scale(1.1);
  }

  .ct-tab-label {
    max-width: 100%;
    font-size: 0.62rem;
    font-weight: 600;
    line-height: 1.05;
    text-align: center;
    white-space: nowrap;
    letter-spacing: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ct-tab-pip {
    position: absolute;
    bottom: 4px;
    left: 50%;
    transform: translateX(-50%);
    width: 28px;
    height: 3px;
    background: var(--nav-pip);
    border-radius: 999px;
  }

  @media (min-width: 1024px) {
    .ct-cat-tabs {
      display: none;
    }
  }
</style>

<script is:inline>
(function initCategoryNav() {
  function bindSidebar() {
    var toggle = document.querySelector('[data-sidebar-toggle]');
    var content = document.querySelector('[data-sidebar-content]');
    if (!toggle || !content) return;

    toggle.addEventListener('click', function() {
      var isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isExpanded));
      content.hidden = isExpanded;
      try {
        localStorage.setItem('ct.cat-sidebar-collapsed.v1', isExpanded ? '1' : '0');
      } catch (e) {}
    });

    // Restore collapsed state
    try {
      var collapsed = localStorage.getItem('ct.cat-sidebar-collapsed.v1') === '1';
      if (collapsed) {
        toggle.setAttribute('aria-expanded', 'false');
        content.hidden = true;
      }
    } catch (e) {}
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bindSidebar);
  } else {
    bindSidebar();
  }
})();
</script>
