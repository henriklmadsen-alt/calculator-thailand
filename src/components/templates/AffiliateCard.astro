---
import { AFFILIATE_PARTNERS, isAffiliatePartnerConfigured } from '../../data/affiliate-config';

type Category = 'car-loan' | 'home-loan' | 'personal-loan' | 'credit-card' | 'insurance' | 'investment' | 'savings';

interface Props {
  category: Category;
  affiliateUrl: string;
  partnerName?: string;
  ctaText: string;
  headline?: string;
  subtext?: string;
  isVisible?: boolean;
}

const {
  category,
  affiliateUrl,
  partnerName: customPartnerName,
  ctaText,
  headline: customHeadline,
  subtext,
  isVisible = false,
} = Astro.props;

const headlineMap: Record<Category, string> = {
  'car-loan':       'คำนวณค่างวดแล้ว ดูข้อเสนอรถที่เหมาะกับงบคุณ',
  'home-loan':      'รู้ค่างวดบ้านแล้ว ดูทางเลือกสมัครต่อ',
  'personal-loan':  'เห็นภาระผ่อนแล้ว เช็กข้อเสนอที่พอดีกับรายรับ',
  'credit-card':    'ตรวจต้นทุนบัตรแล้ว ดูข้อเสนอที่เหมาะกับพฤติกรรมใช้จริง',
  'insurance':      'คำนวณแล้ว เปรียบเทียบแผนประกันที่เหมาะกับงบคุณ',
  'investment':     'เห็นตัวเลขแล้ว ดูทางเลือกต่อที่เหมาะกับเป้าหมาย',
  'savings':        'คำนวณดอกเบี้ยแล้ว ดูทางเลือกออมที่ให้ผลตอบแทนดีกว่า',
};

const headline = customHeadline ?? headlineMap[category];
const hasCustomCopy = Boolean(customHeadline);
const affiliateSlug = affiliateUrl.match(/^\/go\/([^/?#]+)/)?.[1] ?? '';
const affiliatePartnerConfig = affiliateSlug ? AFFILIATE_PARTNERS[affiliateSlug] : undefined;
const partnerName = customPartnerName ?? affiliatePartnerConfig?.partnerName ?? 'Affiliate partner';
const isTrackedAffiliateConfigured = affiliatePartnerConfig
  ? isAffiliatePartnerConfigured(affiliatePartnerConfig)
  : Boolean(affiliateUrl);
---

{/* Wrapper — hidden by default; calculator scripts call classList.remove('hidden') to reveal */}
<div
  id="affiliate-card"
  class:list={['affiliate-card-wrapper', { hidden: !isVisible }, { 'affiliate-card-wrapper--unconfigured': !isTrackedAffiliateConfigured }]}
  data-affiliate-category={category}
  data-affiliate-partner={partnerName}
  data-affiliate-url={affiliateUrl}
  data-affiliate-cta={ctaText}
  data-affiliate-configured={String(isTrackedAffiliateConfigured)}
  data-affiliate-experiment="affiliate-benefit-cta-v1"
  data-affiliate-custom-copy={String(hasCustomCopy)}
  role="complementary"
  aria-label={`ข้อเสนอจาก ${partnerName}`}
>
  <div class="affiliate-card">
    {/* Category icon */}
    <div class="affiliate-card__icon" aria-hidden="true">
      {category === 'car-loan' && (
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="28" height="28">
          <path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"/>
        </svg>
      )}
      {category === 'home-loan' && (
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="28" height="28">
          <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
        </svg>
      )}
      {category === 'personal-loan' && (
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="28" height="28">
          <path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/>
        </svg>
      )}
      {category === 'insurance' && (
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="28" height="28">
          <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
        </svg>
      )}
      {category === 'credit-card' && (
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="28" height="28">
          <path d="M20 4H4c-1.11 0-2 .89-2 2v12c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/>
        </svg>
      )}
      {category === 'investment' && (
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="28" height="28">
          <path d="M3.5 18.49l6-6.01 4 4L22 6.92l-1.41-1.41-7.09 7.97-4-4L2 16.99z"/>
        </svg>
      )}
      {category === 'savings' && (
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="28" height="28">
          <path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/>
        </svg>
      )}
    </div>

    {/* Content */}
    <div class="affiliate-card__body">
      <p class="affiliate-card__headline" data-affiliate-headline>{headline}</p>
      {subtext && <p class="affiliate-card__subtext" data-affiliate-subtext>{subtext}</p>}
    </div>

    {/* CTA */}
    <a
      href={affiliateUrl}
      rel="sponsored noopener"
      target="_blank"
      class="affiliate-card__cta"
      data-affiliate-category={category}
      data-affiliate-partner={partnerName}
      data-affiliate-cta-label
    >
      {ctaText}
    </a>
  </div>

  {/* Disclosure notice required on every page with an affiliate link. */}
  <p class="affiliate-card__disclosure">
    ลิงก์นี้เป็นลิงก์พาร์ทเนอร์ เราอาจได้รับค่าคอมมิชชันหากคุณสมัครผ่านลิงก์นี้ โดยผลคำนวณยังเป็นอิสระจากข้อเสนอ ·
    <a href="/affiliate-disclosure/" class="affiliate-card__disclosure-link">นโยบาย Affiliate</a>
  </p>
</div>

<style>
  @keyframes affiliateFadeIn {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .affiliate-card-wrapper {
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
    animation: affiliateFadeIn 0.35s ease-out both;
  }

  .affiliate-card-wrapper.hidden,
  .affiliate-card-wrapper--unconfigured {
    display: none !important;
  }

  .affiliate-card {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    overflow: hidden;
    padding: 1.1rem 1.25rem;
    background: color-mix(in srgb, var(--ct-surface, #ffffff) 88%, #00c7be);
    border: 1px solid color-mix(in srgb, var(--ct-accent-mint, #00c7be) 32%, var(--ct-border, #dbe3ed));
    border-radius: 1.25rem;
    box-shadow: var(--ct-soft-shadow, 0 10px 26px rgba(15, 23, 42, 0.08));
    -webkit-backdrop-filter: blur(20px) saturate(1.15);
    backdrop-filter: blur(20px) saturate(1.15);
  }

  .affiliate-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 0.22rem;
    background: linear-gradient(90deg, var(--ct-accent-blue, #007aff), var(--ct-accent-mint, #00c7be), var(--ct-accent-lime, #32d74b));
  }

  .affiliate-card__icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 1rem;
    background: linear-gradient(135deg, var(--ct-accent-blue, #007aff), var(--ct-accent-mint, #00c7be));
    color: #ffffff;
    box-shadow: 0 12px 24px rgba(0, 122, 255, 0.18);
  }

  .affiliate-card__body {
    flex: 1 1 0;
    min-width: 0;
  }

  .affiliate-card__headline {
    margin: 0;
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--ct-text-strong, #07111f);
    line-height: 1.4;
  }

  .affiliate-card__subtext {
    margin: 0.25rem 0 0;
    font-size: 0.84rem;
    color: var(--ct-text-muted, #475569);
    line-height: 1.4;
  }

  .affiliate-card__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.675rem 1.15rem;
    background: linear-gradient(135deg, var(--ct-accent-blue, #007aff), var(--ct-accent-mint, #00c7be));
    color: #fff;
    font-size: 0.875rem;
    font-weight: 800;
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.16s ease, box-shadow 0.16s ease, filter 0.16s ease;
    flex-shrink: 0;
    box-shadow: 0 14px 28px rgba(0, 122, 255, 0.18);
  }

  .affiliate-card__cta:hover,
  .affiliate-card__cta:focus-visible {
    transform: translateY(-1px);
    filter: brightness(1.04);
    box-shadow: 0 18px 34px rgba(0, 122, 255, 0.24);
  }

  .affiliate-card__cta:focus-visible {
    outline: 2px solid var(--ct-focus, #00c7be);
    outline-offset: 2px;
  }

  .affiliate-card__disclosure {
    margin: 0.5rem 0 0;
    font-size: 0.8125rem;
    color: var(--ct-text-muted, #475569);
    opacity: 0.9;
    padding: 0 1.25rem 0.75rem;
  }

  .affiliate-card__disclosure-link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .affiliate-card__disclosure-link:hover {
    opacity: 1;
  }

  @media (max-width: 639px) {
    .affiliate-card {
      flex-direction: column;
      align-items: flex-start;
    }

    .affiliate-card__cta {
      width: 100%;
    }
  }
</style>

<script>
  (() => {
    if (typeof window === 'undefined' || typeof document === 'undefined') return;

    function emit(eventName, payload) {
      if (typeof window.trackLanguageAwareEvent === 'function') {
        window.trackLanguageAwareEvent(eventName, payload);
        return;
      }
      if (typeof window.gtag === 'function') {
        window.gtag('event', eventName, payload);
      }
    }

    const EXPERIMENT_NAME = 'affiliate-benefit-cta-v1';
    const VARIANTS = ['control', 'benefit', 'confidence'];
    const COPY_BY_CATEGORY = {
      'car-loan': {
        benefit: {
          headline: 'เห็นค่างวดรถแล้ว เช็กข้อเสนอที่เหมาะกับงบคุณ',
          subtext: 'ใช้ผลคำนวณนี้เป็นฐานก่อนดูข้อเสนอพาร์ทเนอร์ ลดโอกาสสมัครเกินกำลังผ่อน',
          cta: 'เช็กข้อเสนอรถจาก Roojai',
        },
        confidence: {
          headline: 'ก่อนสมัครสินเชื่อรถ ตรวจข้อเสนอหลังรู้ค่างวดจริง',
          subtext: 'เปรียบเทียบจากยอดผ่อน เงินดาวน์ และดอกเบี้ยที่คุณเพิ่งคำนวณ',
          cta: 'ดูข้อเสนอหลังคำนวณ',
        },
      },
      'home-loan': {
        benefit: {
          headline: 'รู้ค่างวดบ้านแล้ว เช็กทางเลือกสมัครต่อ',
          subtext: 'ใช้ยอดผ่อนและภาระหนี้ต่อรายได้เป็นฐานก่อนดูข้อเสนอพาร์ทเนอร์',
          cta: 'เช็กข้อเสนอสินเชื่อบ้าน',
        },
        confidence: {
          headline: 'ก่อนยื่นกู้บ้าน ตรวจภาระผ่อนกับข้อเสนอที่เป็นไปได้',
          subtext: 'เหมาะหลังคำนวณค่างวด รีไฟแนนซ์ หรือแผนโปะบ้านเรียบร้อยแล้ว',
          cta: 'ดูทางเลือกสมัครต่อ',
        },
      },
      insurance: {
        benefit: {
          headline: 'คำนวณแล้ว เปรียบเทียบแผนประกันก่อนตัดสินใจ',
          subtext: 'ใช้ผลลัพธ์นี้ช่วยเลือกความคุ้มครองและงบเบี้ยที่ไม่เกินแผนของคุณ',
          cta: 'ดูแผนจาก Roojai',
        },
        confidence: {
          headline: 'ลดความเสี่ยงก่อนสมัครด้วยข้อเสนอที่เทียบกับงบจริง',
          subtext: 'เหมาะสำหรับคนที่ต้องการดูแผนหลังรู้ตัวเลขภาษี เงินเดือน หรือค่าใช้จ่ายแล้ว',
          cta: 'เปรียบเทียบข้อเสนอ',
        },
      },
      'personal-loan': {
        benefit: {
          headline: 'เห็นยอดผ่อนแล้ว เช็กวงเงินที่เหมาะกับกระแสเงินสด',
          subtext: 'ตรวจข้อเสนอต่อเมื่อค่างวดไม่กดดันรายรับรายเดือน',
          cta: 'เช็กข้อเสนอสินเชื่อ',
        },
        confidence: {
          headline: 'ก่อนสมัครสินเชื่อส่วนบุคคล ดูข้อเสนอหลังคำนวณภาระจริง',
          subtext: 'ช่วยลดการสมัครเกินวงเงินหรือเกินความสามารถในการผ่อน',
          cta: 'ดูข้อเสนอหลังคำนวณ',
        },
      },
      'credit-card': {
        benefit: {
          headline: 'ตรวจดอกเบี้ยแล้ว เลือกบัตรที่เหมาะกับพฤติกรรมใช้จริง',
          subtext: 'เหมาะหลังคำนวณยอดผ่อน ดอกเบี้ย หรืออัตราใช้วงเงินบัตรเครดิต',
          cta: 'ดูข้อเสนอบัตร',
        },
        confidence: {
          headline: 'ลดต้นทุนบัตรเครดิตด้วยข้อเสนอที่เข้ากับการใช้งาน',
          subtext: 'ใช้ตัวเลขจากเครื่องคำนวณก่อนเลือกสมัครผ่านพาร์ทเนอร์',
          cta: 'เปรียบเทียบบัตร',
        },
      },
      investment: {
        benefit: {
          headline: 'เห็นผลตอบแทนแล้ว เลือกทางเลือกที่เหมาะกับเป้าหมาย',
          subtext: 'ใช้ผลคำนวณเป็นฐานก่อนดูข้อเสนอพาร์ทเนอร์',
          cta: 'ดูข้อเสนอที่เกี่ยวข้อง',
        },
        confidence: {
          headline: 'ตัดสินใจจากตัวเลขจริง ไม่ใช่แค่โฆษณา',
          subtext: 'เปรียบเทียบหลังเห็นผลตอบแทน ความเสี่ยง หรือเงินสะสมที่ต้องใช้',
          cta: 'ดูทางเลือกต่อ',
        },
      },
      savings: {
        benefit: {
          headline: 'เห็นดอกเบี้ยแล้ว มองหาบัญชีที่ให้ผลตอบแทนดีกว่า',
          subtext: 'ใช้ยอดเงินฝากและระยะเวลาจริงก่อนดูข้อเสนอพาร์ทเนอร์',
          cta: 'ดูข้อเสนอเงินฝาก',
        },
        confidence: {
          headline: 'ก่อนเปิดบัญชี เช็กผลตอบแทนเทียบกับตัวเลขจริง',
          subtext: 'ช่วยเลือกบัญชีหรือผลิตภัณฑ์ที่เข้ากับเป้าหมายการออม',
          cta: 'เปรียบเทียบข้อเสนอ',
        },
      },
    };

    function getStoredVariant(card) {
      try {
        const key = `ct.${EXPERIMENT_NAME}.${card.dataset.affiliateCategory}.${card.dataset.affiliatePartner}`;
        const existing = window.localStorage.getItem(key);
        if (VARIANTS.includes(existing)) return existing;
        const assigned = VARIANTS[Math.floor(Math.random() * VARIANTS.length)] || 'control';
        window.localStorage.setItem(key, assigned);
        return assigned;
      } catch {
        return 'control';
      }
    }

    function withExperimentParams(href, variant) {
      try {
        const url = new URL(href, window.location.origin);
        url.searchParams.set('experiment', EXPERIMENT_NAME);
        url.searchParams.set('variant', variant);
        return url.origin === window.location.origin
          ? `${url.pathname}${url.search}${url.hash}`
          : url.toString();
      } catch {
        return href;
      }
    }

    function applyVariant(card) {
      const variant = getStoredVariant(card);
      card.dataset.affiliateVariant = variant;
      card.dataset.affiliateExperiment = EXPERIMENT_NAME;

      const category = card.dataset.affiliateCategory || '';
      const copy = COPY_BY_CATEGORY[category]?.[variant];
      const hasCustomCopy = card.dataset.affiliateCustomCopy === 'true';
      const headline = card.querySelector('[data-affiliate-headline]');
      const subtext = card.querySelector('[data-affiliate-subtext]');
      const link = card.querySelector('.affiliate-card__cta');

      if (copy && !hasCustomCopy) {
        if (headline) headline.textContent = copy.headline;
        if (subtext) subtext.textContent = copy.subtext;
        if (link) link.textContent = copy.cta;
        card.dataset.affiliateCta = copy.cta;
      }

      if (link) {
        link.href = withExperimentParams(link.getAttribute('href') || '', variant);
      }
    }

    function bindCard(card) {
      if (card.dataset.affiliateBound === '1') return;
      card.dataset.affiliateBound = '1';

      const link = card.querySelector('.affiliate-card__cta');
      if (!link) return;

      link.addEventListener('click', (event) => {
        if (card.dataset.affiliateConfigured === 'false') {
          event.preventDefault();
          emit('affiliate_click_unconfigured', {
            affiliate_category: card.dataset.affiliateCategory ?? '',
            affiliate_partner:  card.dataset.affiliatePartner  ?? '',
            affiliate_url:      card.dataset.affiliateUrl      ?? '',
            affiliate_cta:      card.dataset.affiliateCta      ?? '',
            affiliate_experiment: card.dataset.affiliateExperiment ?? EXPERIMENT_NAME,
            affiliate_variant: card.dataset.affiliateVariant ?? 'control',
            page_path:          window.location.pathname,
          });
          return;
        }

        emit('affiliate_click', {
          affiliate_category: card.dataset.affiliateCategory ?? '',
          affiliate_partner:  card.dataset.affiliatePartner  ?? '',
          affiliate_url:      card.dataset.affiliateUrl      ?? '',
          affiliate_cta:      card.dataset.affiliateCta      ?? '',
          affiliate_experiment: card.dataset.affiliateExperiment ?? EXPERIMENT_NAME,
          affiliate_variant: card.dataset.affiliateVariant ?? 'control',
          page_path:          window.location.pathname,
        });
      });
    }

    function emitView(card) {
      if (card.dataset.affiliateViewed === '1' || card.classList.contains('hidden')) return;
      card.dataset.affiliateViewed = '1';
      emit('affiliate_cta_view', {
        affiliate_category: card.dataset.affiliateCategory ?? '',
        affiliate_partner:  card.dataset.affiliatePartner  ?? '',
        affiliate_url:      card.dataset.affiliateUrl      ?? '',
        affiliate_cta:      card.dataset.affiliateCta      ?? '',
        affiliate_experiment: card.dataset.affiliateExperiment ?? EXPERIMENT_NAME,
        affiliate_variant: card.dataset.affiliateVariant ?? 'control',
        page_path:          window.location.pathname,
      });
    }

    function watchCardView(card) {
      if (card.dataset.affiliateWatchBound === '1') return;
      card.dataset.affiliateWatchBound = '1';

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              emitView(card);
              observer.disconnect();
            }
          });
        }, { threshold: 0.35 });
        observer.observe(card);
      } else {
        emitView(card);
      }

      const mutationObserver = new MutationObserver(() => emitView(card));
      mutationObserver.observe(card, { attributes: true, attributeFilter: ['class'] });
    }

    function initAll() {
      document.querySelectorAll('[data-affiliate-category][data-affiliate-partner]').forEach((el) => {
        // Only bind to the wrapper (has data-affiliate-url), not the inner CTA link
        if (el.dataset.affiliateUrl) {
          applyVariant(el);
          bindCard(el);
          watchCardView(el);
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }
  })();
</script>
