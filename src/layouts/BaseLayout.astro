---
import '../styles/theme.css';
import SaveCompareDrawer from '../components/templates/SaveCompareDrawer.astro';
import RecentCalculations from '../components/templates/RecentCalculations.astro';
import CategoryNav from '../components/templates/CategoryNav.astro';
import EmailCapture from '../components/templates/EmailCapture.astro';
import LanguageSwitcherButton from '../components/templates/LanguageSwitcherButton.astro';
import FeedbackWidget from '../components/FeedbackWidget.astro';
import ABTestTracker from '../components/ABTestTracker.astro';
import CalculatorSchema from '../components/schema/CalculatorSchema.astro';
import { calculators } from '../lib/calculators';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  pageName?: string;
  alternateLocales?: Array<{ hreflang: string; href: string }>;
  /** Category ID for visual breadcrumb — e.g. "health", "tax", "loan" */
  categoryId?: string;
  /** Thai display name for the category — e.g. "สุขภาพ/ชีวิต" */
  categoryName?: string;
  /** URL slug for the category page — e.g. "สุขภาพ" */
  categorySlug?: string;
  /** Set true on pages that define their own custom HowTo JSON-LD to suppress the generic BaseLayout HowTo */
  noGenericHowTo?: boolean;
  /** Keep private/admin pages out of search indexes. */
  noindex?: boolean;
}

const { title, description, canonical, ogImage, pageName, alternateLocales = [], categoryId, categoryName, categorySlug, noGenericHowTo = false, noindex = false } = Astro.props;
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://www.kamnuanlek.com').replace(/\/$/, '');
const pageUrl = canonical || siteUrl + Astro.url.pathname;
const imageUrl = ogImage || `${siteUrl}/og-image.svg`;
// Generate hreflang links for language variants (English pages not yet available)
// Use pageUrl (canonical) for hreflang to ensure consistent URL format and prevent encoding mismatches
const localeAlternates = [
  { hreflang: 'th-TH', href: pageUrl },
  { hreflang: 'x-default', href: pageUrl },
  ...alternateLocales.filter((alt) => alt?.hreflang && alt?.href),
];

const organizationSchema = {
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: 'Kamnuanlek',
  alternateName: ['คำนวณเลข', 'คำนวณเลข', 'kamnuanlek.com'],
  url: siteUrl,
  logo: {
    '@type': 'ImageObject',
    url: `${siteUrl}/og-image.svg`,
    width: 1200,
    height: 630,
  },
  description: 'แพลตฟอร์มเครื่องคำนวณออนไลน์ฟรีสำหรับคนไทย — คำนวณภาษี สินเชื่อ เงินเดือน ค่าไฟ และอีก 800+ รายการ อัปเดตอัตราราชการปี 2569',
  foundingDate: '2024',
  inLanguage: 'th-TH',
  areaServed: { '@type': 'Country', name: 'Thailand' },
  email: 'info@kamnuanlek.com',
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'info@kamnuanlek.com',
    contactType: 'customer support',
    availableLanguage: ['Thai', 'English'],
    url: `${siteUrl}/ติดต่อเรา/`,
  },
  knowsAbout: ['Thai tax calculation', 'loan calculators', 'salary calculation', 'Thai financial tools', 'เครื่องคำนวณภาษี', 'คำนวณสินเชื่อ'],
};

const jsonLdWebPage = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  name: title,
  description,
  inLanguage: 'th-TH',
  isPartOf: {
    '@type': 'WebSite',
    '@id': `${siteUrl}/#website`,
    name: 'Kamnuanlek — คำนวณเลข',
    url: siteUrl,
  },
  sourceOrganization: organizationSchema,
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.ai-quick-answer', 'h2', '.faq-answer-content'],
  },
});

const jsonLdOrganization = JSON.stringify({
  '@context': 'https://schema.org',
  ...organizationSchema,
});

const breadcrumbJsonLd = pageName ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "หน้าแรก",
      "item": siteUrl + "/"
    },
    ...(categorySlug && categoryName ? [
      {
        "@type": "ListItem",
        "position": 2,
        "name": categoryName,
        "item": `${siteUrl}/หมวดหมู่/${categorySlug}/`
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": pageName,
        "item": pageUrl
      }
    ] : [
      {
        "@type": "ListItem",
        "position": 2,
        "name": pageName,
        "item": pageUrl
      }
    ])
  ]
}) : null;

const genericHowToJsonLd = !noGenericHowTo ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  'name': title,
  'description': description,
  'author': {
    '@type': 'Organization',
    'name': 'Kamnuanlek.com',
    'url': siteUrl,
  },
  'totalTime': 'PT2M',
  'step': [
    {
      '@type': 'HowToStep',
      'position': 1,
      'name': 'กรอกข้อมูล',
      'text': 'กรอกตัวเลขหรือข้อมูลที่ต้องการลงในช่องรับข้อมูลบนหน้าเครื่องคำนวณ',
    },
    {
      '@type': 'HowToStep',
      'position': 2,
      'name': 'กดคำนวณ',
      'text': 'กดปุ่มคำนวณ เครื่องคำนวณจะประมวลผลทันทีและแสดงผลลัพธ์',
    },
    {
      '@type': 'HowToStep',
      'position': 3,
      'name': 'อ่านผลลัพธ์',
      'text': 'ดูผลลัพธ์ที่แสดงในการ์ดผลลัพธ์ พร้อมคำอธิบายและคำแนะนำที่เกี่ยวข้อง',
    },
  ],
}) : null;

const localBusinessJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  'name': 'Kamnuanlek',
  'alternateName': 'Calculator Thailand',
  'description': 'Free Thai calculators for tax, loans, salaries, utilities and 800+ more financial tools',
  'url': siteUrl,
  'address': {
    '@type': 'PostalAddress',
    'addressCountry': 'TH',
    'addressLocality': 'Bangkok',
  },
  'serviceArea': 'TH',
  'areaServed': { '@type': 'Country', name: 'Thailand' },
});

const decodedPathname = (() => {
  try {
    return decodeURIComponent(Astro.url.pathname);
  } catch {
    return Astro.url.pathname;
  }
})();

const normalizedDecodedPathname = decodedPathname.endsWith('/') ? decodedPathname : `${decodedPathname}/`;
const calculatorRoutes = new Set(calculators.map((calculator) => calculator.href));
const isArticlePage = decodedPathname.startsWith('/บทความ/');
const isHomePage = normalizedDecodedPathname === '/';
const isCalculatorPage = calculatorRoutes.has(normalizedDecodedPathname);

const schemaTypeByCategoryId: Record<string, 'TaxCalculator' | 'LoanCalculator' | 'SalaryCalculator' | 'Calculator'> = {
  tax: 'TaxCalculator',
  loan: 'LoanCalculator',
  salary: 'SalaryCalculator',
};

const categoryBasedSchemaType = categoryId ? schemaTypeByCategoryId[categoryId] : undefined;

const calculatorSchemaType: 'TaxCalculator' | 'LoanCalculator' | 'SalaryCalculator' | 'Calculator' =
  categoryBasedSchemaType
    ? categoryBasedSchemaType
    : decodedPathname.includes('ภาษี') || decodedPathname.includes('tax')
      ? 'TaxCalculator'
      : decodedPathname.includes('ผ่อน') || decodedPathname.includes('สินเชื่อ') || decodedPathname.includes('กู้') || decodedPathname.includes('loan')
        ? 'LoanCalculator'
        : decodedPathname.includes('เงินเดือน') || decodedPathname.includes('ค่าแรง') || decodedPathname.includes('salary')
          ? 'SalaryCalculator'
          : 'Calculator';
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow, noarchive' : 'index, follow'} />
    <link rel="canonical" href={pageUrl} />
    {localeAlternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <link rel="alternate" type="text/plain" title="Kamnuanlek llms.txt" href={`${siteUrl}/llms.txt`} />
    <link rel="alternate" type="text/plain" title="Kamnuanlek full LLM inventory" href={`${siteUrl}/llms-full.txt`} />
    <link rel="alternate" type="application/json" title="Kamnuanlek LLM context" href={`${siteUrl}/api/llm-context.json`} />
    <meta name="google-site-verification" content="ZGJ3F-iJz_S9hqfdsjSoj33ZaYLaOfiQ4xjeL3KSgGM" />
    <meta name="google-site-verification" content="zaca9jM01wCKV24fXyQM0o0hYouvbVh8yFjLtAhjc5g" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="คำนวณเลข" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="th_TH" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- Favicon (SVG inline as data URI - calculator icon) -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%232563eb'/><rect x='20' y='15' width='60' height='25' rx='5' fill='white'/><rect x='20' y='50' width='17' height='17' rx='3' fill='white'/><rect x='41' y='50' width='17' height='17' rx='3' fill='white'/><rect x='62' y='50' width='17' height='17' rx='3' fill='white'/><rect x='20' y='72' width='17' height='17' rx='3' fill='white'/><rect x='41' y='72' width='17' height='17' rx='3' fill='white'/><rect x='62' y='72' width='38' height='17' rx='3' fill='%2360a5fa'/></svg>" />
    <link rel="apple-touch-icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%232563eb'/></svg>" />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="คำนวณเลข" />
    <meta name="theme-color" content="#2563eb" />

    <!-- Fonts (non-blocking load + noscript fallback) -->
    <link rel="dns-prefetch" href="//fonts.googleapis.com" />
    <link rel="dns-prefetch" href="//fonts.gstatic.com" />
    <link rel="dns-prefetch" href="//www.googletagmanager.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@300;400;500;600;700;800&display=swap" />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <title>{title}</title>
    <script type="application/ld+json" set:html={jsonLdOrganization} />
    <script type="application/ld+json" set:html={localBusinessJsonLd} />
    <script type="application/ld+json" set:html={jsonLdWebPage} />
    {breadcrumbJsonLd && <script type="application/ld+json" set:html={breadcrumbJsonLd} />}
    {genericHowToJsonLd && <script type="application/ld+json" set:html={genericHowToJsonLd} />}
    {isCalculatorPage && (
      <CalculatorSchema
        siteUrl={siteUrl}
        name={title}
        description={description}
        url={pageUrl}
        calculatorType={calculatorSchemaType}
      />
    )}

    <!-- Sentry Error Monitoring (deferred for Core Web Vitals) -->
    <script>
      const loadSentry = () => import('../sentry-client');
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(loadSentry, { timeout: 3000 });
      } else {
        window.setTimeout(loadSentry, 1600);
      }
    </script>

    <script>
      import { setupKeyboardNavigation } from '../lib/accessibility';
      import { trackFormStart, trackResultView, trackCalculatorCompletion } from '../lib/calculator-tracking';

      window.__ctSharedTracking = {
        trackFormStart,
        trackResultView,
        trackCalculatorCompletion,
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => setupKeyboardNavigation(), { once: true });
      } else {
        setupKeyboardNavigation();
      }
    </script>

    <!-- Google Analytics 4 queues immediately, network load waits until after first paint. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-EY67HJ8NDD');

      function runAfterLoadIdle(callback) {
        const run = () => {
          if ('requestIdleCallback' in window) {
            window.requestIdleCallback(callback, { timeout: 2500 });
          } else {
            window.setTimeout(callback, 800);
          }
        };

        if (document.readyState === 'complete') {
          run();
        } else {
          window.addEventListener('load', run, { once: true });
        }
      }

      runAfterLoadIdle(function loadGtagScript() {
        if (document.querySelector('script[data-ct-gtag]')) return;
        const script = document.createElement('script');
        script.async = true;
        script.dataset.ctGtag = '1';
        script.src = 'https://www.googletagmanager.com/gtag/js?id=G-EY67HJ8NDD';
        document.head.appendChild(script);
      });

      function decodePathname(pathname) {
        try {
          return decodeURIComponent(pathname);
        } catch {
          return pathname;
        }
      }

      function getPageType() {
        const decodedPath = decodePathname(window.location.pathname);
        if (decodedPath.startsWith('/บทความ/')) return 'article';
        return decodedPath === '/' ? 'home' : 'calculator';
      }

      function getDefaultCalculatorType() {
        const decodedPath = decodePathname(window.location.pathname);
        const calculatorMap = {
          '/คำนวณค่าไฟฟ้า/': 'electricity_bill',
          '/คำนวณภาษีเงินได้บุคคลธรรมดา/': 'personal_income_tax',
          '/คำนวณผ่อนรถ/': 'vehicle',
          '/คำนวณผ่อนบ้าน/': 'mortgage_refinance',
          '/คำนวณเงินเดือนสุทธิ/': 'net_salary',
          '/คำนวณผ่อนกู้/': 'loan',
          '/คำนวณภาษีมูลค่าเพิ่ม/': 'vat',
          '/คำนวณดอกเบี้ยเงินฝาก/': 'deposit',
          '/คำนวณ-bmi/': 'bmi',
          '/คำนวณอายุ/': 'age',
          '/คำนวณภาษีที่ดิน/': 'land_building_tax',
        };
        return calculatorMap[decodedPath] || '';
      }

      function getLanguageContext() {
        return {
          lang_mode: 'th',
          content_locale: 'th',
          ui_language: 'th',
        };
      }

      function getReferrerHost() {
        if (!document.referrer) return '';
        try {
          return (new URL(document.referrer).hostname || '').toLowerCase();
        } catch {
          return '';
        }
      }

      function classifyAiReferrer(referrerHost) {
        if (!referrerHost || referrerHost === '(direct)') return 'none';

        const aiReferrerRules = [
          ['chat.openai.com', 'chatgpt'],
          ['chatgpt.com', 'chatgpt'],
          ['openai.com', 'chatgpt'],
          ['perplexity.ai', 'perplexity'],
          ['claude.ai', 'claude'],
          ['poe.com', 'poe'],
          ['gemini.google.com', 'gemini'],
          ['copilot.microsoft.com', 'copilot'],
        ];

        for (const [hostFragment, label] of aiReferrerRules) {
          if (referrerHost.includes(hostFragment)) {
            return label;
          }
        }

        return 'none';
      }

      function getTrafficAttribution() {
        const params = new URLSearchParams(window.location.search);
        const utmSource = params.get('utm_source') || '';
        const utmMedium = params.get('utm_medium') || '';
        const utmCampaign = params.get('utm_campaign') || '';
        const referrerHost = getReferrerHost();
        const aiReferrerSource = classifyAiReferrer(referrerHost);
        const trafficChannel = aiReferrerSource !== 'none'
          ? 'ai_referral'
          : (utmSource ? 'campaign' : (referrerHost ? 'referral' : 'direct'));

        return {
          traffic_source: utmSource || referrerHost || '(direct)',
          traffic_medium: utmMedium || (referrerHost ? 'referral' : '(none)'),
          traffic_campaign: utmCampaign || '(not set)',
          referrer_host: referrerHost || '(direct)',
          ai_referrer_source: aiReferrerSource,
          traffic_channel: trafficChannel,
        };
      }

      function withLanguageContext(payload) {
        return {
          ...payload,
          ...getLanguageContext(),
        };
      }

      function emitSessionStartOnce() {
        if (typeof window.gtag !== 'function') return;

        const storageKey = 'ct.session_start.v1';
        try {
          if (window.sessionStorage.getItem(storageKey) === '1') {
            return;
          }
          window.gtag('event', 'session_start', {
            ...getTrafficAttribution(),
            landing_path: window.location.pathname,
            ...getLanguageContext(),
          });
          window.sessionStorage.setItem(storageKey, '1');
        } catch {
          // Session storage can be unavailable in strict privacy modes.
          window.gtag('event', 'session_start', {
            ...getTrafficAttribution(),
            landing_path: window.location.pathname,
            ...getLanguageContext(),
          });
        }
      }

      // Shared GA4 custom event helpers
      function trackCalculatorStart(calculatorType) {
        if (typeof window.gtag !== 'function') return;
        const sharedTracking = window.__ctSharedTracking;
        window.__ctCalculatorType = calculatorType;
        if (sharedTracking?.trackFormStart) {
          sharedTracking.trackFormStart(calculatorType);
        }
        window.gtag('event', 'calculator_start', withLanguageContext({
          calculator_type: calculatorType,
          ...getTrafficAttribution(),
        }));
      }
      function trackCalculatorComplete(calculatorType, resultValue) {
        if (typeof window.gtag !== 'function') return;
        const sharedTracking = window.__ctSharedTracking;
        window.__ctCalculatorType = calculatorType;
        if (sharedTracking?.trackResultView) {
          sharedTracking.trackResultView(
            calculatorType,
            typeof resultValue === 'number' && Number.isFinite(resultValue) ? String(resultValue) : undefined,
          );
        }
        if (sharedTracking?.trackCalculatorCompletion) {
          sharedTracking.trackCalculatorCompletion(calculatorType, 0);
        }
        const payload = {
          calculator_type: calculatorType,
          ...getTrafficAttribution(),
        };
        if (typeof resultValue === 'number' && Number.isFinite(resultValue)) {
          payload.result_value = resultValue;
        }
        window.gtag('event', 'calculator_complete', withLanguageContext(payload));
      }
      function trackCalculatorUsed(calculatorType, resultValue) {
        if (typeof window.gtag !== 'function') return;
        window.__ctCalculatorType = calculatorType;
        const payload = { calculator_type: calculatorType };
        if (typeof resultValue === 'number' && Number.isFinite(resultValue)) {
          payload.result_value = resultValue;
        }
        window.gtag('event', 'calculator_used', withLanguageContext(payload));
      }
      function trackResultViewed(calculatorType) {
        if (typeof window.gtag !== 'function') return;
        const sharedTracking = window.__ctSharedTracking;
        window.__ctCalculatorType = calculatorType;
        if (sharedTracking?.trackResultView) {
          sharedTracking.trackResultView(calculatorType);
        }
        window.gtag('event', 'result_viewed', withLanguageContext({ calculator_type: calculatorType }));
      }
      function trackLanguageAwareEvent(eventName, payload = {}) {
        if (typeof window.gtag !== 'function') return;
        window.gtag('event', eventName, withLanguageContext(payload));
      }

      function getOrCreateVisitorId() {
        const key = 'ct.visitor_id.v1';
        try {
          const existing = window.localStorage.getItem(key);
          if (existing) return existing;
          const next = (window.crypto && typeof window.crypto.randomUUID === 'function')
            ? window.crypto.randomUUID()
            : `${Date.now()}-${Math.random().toString(36).slice(2)}`;
          window.localStorage.setItem(key, next);
          return next;
        } catch {
          return `${Date.now()}-${Math.random().toString(36).slice(2)}`;
        }
      }

      async function sendVisitorCounterPing() {
        if (window.location.pathname.startsWith('/admin')) return;
        if (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1') return;

        const visitorId = getOrCreateVisitorId();
        const pageType = getPageType();
        const body = JSON.stringify({
          visitorId,
          pagePath: window.location.pathname,
          pageType,
        });

        try {
          await fetch('/api/visitor-counter', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body,
            keepalive: true,
          });
        } catch {}
      }

      async function renderTodayVisitorCount() {
        const el = document.getElementById('ct-visitor-count-value');
        if (!el) return;
        if (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1') {
          el.textContent = '0';
          return;
        }

        try {
          const response = await fetch('/api/visitor-counter?days=1', { cache: 'no-store' });
          if (!response.ok) {
            el.textContent = '0';
            return;
          }
          const payload = await response.json();
          const value = Number(payload?.lifetime?.totalVisits ?? payload?.lifetime?.uniqueVisitors ?? payload?.today?.totalVisits ?? payload?.today?.uniqueVisitors);
          if (!Number.isFinite(value)) {
            el.textContent = '0';
            return;
          }
          el.textContent = value.toLocaleString('th-TH');
        } catch {
          el.textContent = '0';
        }
      }

      window.trackCalculatorStart = trackCalculatorStart;
      window.trackCalculatorComplete = trackCalculatorComplete;
      window.trackCalculatorUsed = trackCalculatorUsed;
      window.trackResultViewed = trackResultViewed;
      window.trackLanguageAwareEvent = trackLanguageAwareEvent;
      window.getLanguageContext = getLanguageContext;

      function preserveAttributionParamsOnLinks() {
        const source = new URLSearchParams(window.location.search);
        const passthroughKeys = [
          'utm_source',
          'utm_medium',
          'utm_campaign',
          'utm_content',
          'utm_term',
          'utm_id',
          'gclid',
          'fbclid',
          'lang',
        ];

        const passthrough = new URLSearchParams();
        passthroughKeys.forEach((key) => {
          const value = source.get(key);
          if (value) passthrough.set(key, value);
        });

        if ([...passthrough.keys()].length === 0) return;

        document.querySelectorAll('a[data-preserve-utm]').forEach((link) => {
          const href = link.getAttribute('href');
          if (!href) return;

          let targetUrl;
          try {
            targetUrl = new URL(href, window.location.origin);
          } catch {
            return;
          }

          if (targetUrl.origin !== window.location.origin) return;

          passthrough.forEach((value, key) => {
            if (!targetUrl.searchParams.has(key)) {
              targetUrl.searchParams.set(key, value);
            }
          });

          const nextHref = `${targetUrl.pathname}${targetUrl.search}${targetUrl.hash}`;
          link.setAttribute('href', nextHref);
        });
      }

      function bindEntryClickTracking() {
        document.querySelectorAll('[data-entry-event]').forEach((element) => {
          if (element.getAttribute('data-entry-bound') === '1') return;
          element.setAttribute('data-entry-bound', '1');
          element.addEventListener('click', () => {
            const eventName = element.getAttribute('data-entry-event');
            if (!eventName) return;

            const routeTo = element.getAttribute('data-route-to')
              || element.getAttribute('href')
              || '';

            const payload = {
              route_from: window.location.pathname,
              route_to: routeTo,
            };

            const targetCalculator = element.getAttribute('data-target-calculator');
            const entrySurface = element.getAttribute('data-entry-surface');
            const placement = element.getAttribute('data-placement');

            if (targetCalculator) payload.target_calculator = targetCalculator;
            if (entrySurface) payload.entry_surface = entrySurface;
            if (placement) payload.placement = placement;

            trackLanguageAwareEvent(eventName, payload);
          });
        });
      }

      function bindCalculatorBehaviorTracking() {
        if (getPageType() !== 'calculator') return;

        const calculatorType = getDefaultCalculatorType() || decodePathname(window.location.pathname).replace(/^\/|\/$/g, '') || 'calculator';
        let startTracked = false;
        let submitTracked = false;
        let resultTracked = false;

        const trackStartOnce = () => {
          if (startTracked) return;
          startTracked = true;
          trackCalculatorStart(calculatorType);
        };

        const trackSubmitOnce = () => {
          if (submitTracked) return;
          submitTracked = true;
          trackCalculatorUsed(calculatorType);
          trackLanguageAwareEvent('calculator_submit', {
            calculator_type: calculatorType,
            page_path: window.location.pathname,
          });
        };

        document.querySelectorAll('form').forEach((form) => {
          if (form.getAttribute('data-calculator-auto-tracked') === '1') return;
          form.setAttribute('data-calculator-auto-tracked', '1');
          form.addEventListener('input', trackStartOnce, { once: true });
          form.addEventListener('change', trackStartOnce, { once: true });
          form.addEventListener('submit', () => {
            trackStartOnce();
            trackSubmitOnce();
          });
        });

        const candidateResults = Array.from(document.querySelectorAll('[id*="result"], [class*="result"]'))
          .filter((el) => el instanceof HTMLElement);

        const isVisible = (el) => {
          if (!(el instanceof HTMLElement)) return false;
          if (el.classList.contains('hidden')) return false;
          const rect = el.getBoundingClientRect();
          return rect.width > 0 && rect.height > 0;
        };

        const trackResultOnce = () => {
          if (resultTracked) return;
          const visibleResult = candidateResults.find(isVisible);
          if (!visibleResult) return;
          resultTracked = true;
          trackResultViewed(calculatorType);
          trackLanguageAwareEvent('calculator_result_visible', {
            calculator_type: calculatorType,
            result_element: visibleResult.id || visibleResult.className || 'result',
            page_path: window.location.pathname,
          });
        };

        trackResultOnce();

        const observer = new MutationObserver(trackResultOnce);
        candidateResults.forEach((el) => {
          observer.observe(el, { attributes: true, attributeFilter: ['class', 'style', 'hidden'] });
        });
      }

      function getCalculatorResultCandidates() {
        const rawCandidates = Array.from(document.querySelectorAll('#results, #results-section, #single-result, #batch-result, [id$="result"], [id$="results"]'))
          .filter((el) => el instanceof HTMLElement);

        return rawCandidates.filter((el) => !rawCandidates.some((other) => other !== el && other.contains(el)));
      }

      function isCalculatorResultVisible(el) {
        if (!(el instanceof HTMLElement)) return false;
        if (el.classList.contains('hidden')) return false;
        if (el.hidden) return false;
        const style = window.getComputedStyle(el);
        if (style.display === 'none' || style.visibility === 'hidden' || style.opacity === '0') return false;
        const rect = el.getBoundingClientRect();
        return rect.width > 0 && rect.height > 0;
      }

      function cleanCalculatorResultText(text) {
        return String(text || '').replace(/\s+/g, ' ').trim();
      }

      function pickCalculatorResultValue(container) {
        const preferred = container.querySelector('#res-total, #result-total, #res-monthly, #result-monthly, [id*="payment"], [id*="total"], [class*="total"]');
        const preferredText = cleanCalculatorResultText(preferred?.textContent);
        if (preferredText && preferredText !== '-' && /[0-9๐-๙]/.test(preferredText)) return preferredText.slice(0, 80);

        const strongCandidates = Array.from(container.querySelectorAll('strong, b, [class*="font-bold"], [class*="text-xl"], [class*="text-2xl"], [class*="text-3xl"]'))
          .map((el) => cleanCalculatorResultText(el.textContent))
          .filter((text) => text && text !== '-' && /[0-9๐-๙]/.test(text));

        return (strongCandidates[0] || '').slice(0, 80);
      }

      function getCalculatorPageTitle() {
        return cleanCalculatorResultText(document.querySelector('h1')?.textContent) || 'เครื่องคำนวณ';
      }

      function bindCalculatorOsResultPanel() {
        if (getPageType() !== 'calculator') return;
        if (document.querySelector('.ct-calculatoros-result-panel')) return;

        const candidateResults = getCalculatorResultCandidates();
        if (!candidateResults.length) return;

        let panel = null;
        let valueEl = null;
        let summaryEl = null;
        let detailBtn = null;
        let aiLink = null;
        let activeResult = null;
        let scheduledFrame = 0;

        const ensurePanel = (anchor) => {
          if (!panel) {
            panel = document.createElement('section');
            panel.className = 'ct-calculatoros-result-panel';
            panel.hidden = true;
            panel.setAttribute('aria-live', 'polite');
            panel.innerHTML = `
              <div class="ct-calculatoros-result-panel__device">
                <div class="ct-calculatoros-result-panel__bar">
                  <span>Kamnuanlek</span>
                  <strong>CalculatorOS</strong>
                </div>
                <div class="ct-calculatoros-result-panel__screen">
                  <span class="ct-calculatoros-result-panel__kicker">ผลลัพธ์ล่าสุด</span>
                  <strong class="ct-calculatoros-result-panel__value" data-calculatoros-panel-value>ดูผลลัพธ์</strong>
                  <small class="ct-calculatoros-result-panel__summary" data-calculatoros-panel-summary></small>
                  <div class="ct-calculatoros-result-panel__actions">
                    <button type="button" data-calculatoros-panel-detail>ดูรายละเอียด</button>
                    <a href="/ai-advisor/" data-calculatoros-panel-ai>ถาม AI</a>
                  </div>
                </div>
              </div>
            `;

            valueEl = panel.querySelector('[data-calculatoros-panel-value]');
            summaryEl = panel.querySelector('[data-calculatoros-panel-summary]');
            detailBtn = panel.querySelector('[data-calculatoros-panel-detail]');
            aiLink = panel.querySelector('[data-calculatoros-panel-ai]');
            detailBtn?.addEventListener('click', () => {
              if (!activeResult) return;
              activeResult.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
          }

          if (!panel.parentElement) {
            if (anchor.matches('#results, #results-section, #single-result, #batch-result') || anchor.children.length > 0) {
              anchor.insertBefore(panel, anchor.firstChild);
            } else {
              anchor.parentNode?.insertBefore(panel, anchor);
            }
          }

          return panel;
        };

        const hidePanel = () => {
          activeResult = null;
          if (!panel) return;
          if (!panel.hidden) panel.hidden = true;
          if (panel.classList.contains('is-visible')) panel.classList.remove('is-visible');
        };

        const updatePanel = () => {
          const visibleResult = candidateResults.find(isCalculatorResultVisible);
          if (!visibleResult) {
            hidePanel();
            return;
          }

          const nextValue = pickCalculatorResultValue(visibleResult);
          if (!nextValue) {
            hidePanel();
            return;
          }

          const nextPanel = ensurePanel(visibleResult);
          if (!nextPanel) return;

          activeResult = visibleResult;
          if (valueEl && valueEl.textContent !== nextValue) valueEl.textContent = nextValue;

          const nextSummary = getCalculatorPageTitle();
          if (summaryEl && summaryEl.textContent !== nextSummary) summaryEl.textContent = nextSummary;

          const nextAiHref = `/ai-advisor/?from=${encodeURIComponent(window.location.pathname)}`;
          if (aiLink && aiLink.getAttribute('href') !== nextAiHref) aiLink.setAttribute('href', nextAiHref);

          if (nextPanel.hidden) nextPanel.hidden = false;
          if (!nextPanel.classList.contains('is-visible')) {
            requestAnimationFrame(() => {
              if (!nextPanel.hidden) nextPanel.classList.add('is-visible');
            });
          }
        };

        const schedulePanelUpdate = () => {
          if (scheduledFrame) return;
          scheduledFrame = requestAnimationFrame(() => {
            scheduledFrame = 0;
            updatePanel();
          });
        };

        document.addEventListener('submit', () => {
          window.setTimeout(schedulePanelUpdate, 80);
        }, true);

        const observer = new MutationObserver((mutations) => {
          if (panel && mutations.every((mutation) => panel.contains(mutation.target))) return;
          schedulePanelUpdate();
        });
        candidateResults.forEach((el) => {
          observer.observe(el, {
            attributes: true,
            attributeFilter: ['class', 'style', 'hidden'],
            childList: true,
            subtree: true,
            characterData: true,
          });
        });

        schedulePanelUpdate();
      }

      function bindCalculatorWowDock() {
        if (getPageType() !== 'calculator') return;
        if (document.querySelector('.ct-result-dock')) return;

        const candidateResults = getCalculatorResultCandidates();

        if (!candidateResults.length) return;

        const dock = document.createElement('aside');
        dock.className = 'ct-result-dock';
        dock.setAttribute('aria-live', 'polite');
        dock.innerHTML = `
          <div class="ct-result-dock__content">
            <span class="ct-result-dock__label">ผลลัพธ์ล่าสุด</span>
            <strong class="ct-result-dock__value" data-result-dock-value>ดูผลลัพธ์</strong>
          </div>
          <div class="ct-result-dock__actions">
            <button type="button" class="ct-result-dock__button" data-result-dock-detail>ดูรายละเอียด</button>
            <a class="ct-result-dock__ai" data-result-dock-ai href="/ai-advisor/">ถาม AI</a>
          </div>
        `;
        document.body.appendChild(dock);

        const valueEl = dock.querySelector('[data-result-dock-value]');
        const detailBtn = dock.querySelector('[data-result-dock-detail]');
        const aiLink = dock.querySelector('[data-result-dock-ai]');

        const isVisible = (el) => {
          if (!(el instanceof HTMLElement)) return false;
          if (el.classList.contains('hidden')) return false;
          if (el.hidden) return false;
          const style = window.getComputedStyle(el);
          if (style.display === 'none' || style.visibility === 'hidden' || style.opacity === '0') return false;
          const rect = el.getBoundingClientRect();
          return rect.width > 0 && rect.height > 0;
        };

        const cleanText = (text) => String(text || '').replace(/\s+/g, ' ').trim();

        const pickValue = (container) => {
          const preferred = container.querySelector('#res-total, #result-total, #res-monthly, #result-monthly, [id*="payment"], [id*="total"], [class*="total"]');
          const preferredText = cleanText(preferred?.textContent);
          if (preferredText && preferredText !== '-') return preferredText.slice(0, 80);

          const strongCandidates = Array.from(container.querySelectorAll('strong, b, [class*="font-bold"], [class*="text-xl"], [class*="text-2xl"], [class*="text-3xl"]'))
            .map((el) => cleanText(el.textContent))
            .filter((text) => text && text !== '-' && /[0-9๐-๙]/.test(text));

          return (strongCandidates[0] || '').slice(0, 80);
        };

        let activeResult = null;

        const updateDock = () => {
          const visibleResult = candidateResults.find(isCalculatorResultVisible);
          if (!visibleResult) {
            dock.classList.remove('is-visible');
            activeResult = null;
            return;
          }

          const nextValue = pickCalculatorResultValue(visibleResult);
          if (!nextValue) {
            dock.classList.remove('is-visible');
            activeResult = null;
            return;
          }

          activeResult = visibleResult;
          if (valueEl) valueEl.textContent = nextValue;
          if (aiLink) aiLink.setAttribute('href', `/ai-advisor/?from=${encodeURIComponent(window.location.pathname)}`);
          dock.classList.add('is-visible');
        };

        detailBtn?.addEventListener('click', () => {
          if (!activeResult) return;
          activeResult.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });

        document.addEventListener('submit', () => {
          window.setTimeout(updateDock, 80);
        }, true);

        const observer = new MutationObserver(updateDock);
        candidateResults.forEach((el) => {
          observer.observe(el, {
            attributes: true,
            attributeFilter: ['class', 'style', 'hidden'],
            childList: true,
            subtree: true,
            characterData: true,
          });
        });

        updateDock();
      }

      emitSessionStartOnce();

      async function initVisitorCounter() {
        await sendVisitorCounterPing();
        await renderTodayVisitorCount();
      }

      function initInteractiveEnhancements() {
        preserveAttributionParamsOnLinks();
        bindEntryClickTracking();
        bindCalculatorBehaviorTracking();
        bindCalculatorOsResultPanel();
        bindCalculatorWowDock();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initInteractiveEnhancements);
      } else {
        initInteractiveEnhancements();
      }

      runAfterLoadIdle(initVisitorCounter);
    </script>

    <script is:inline>
      (function initializeThemeBeforePaint() {
        const STORAGE_KEY = 'ct.theme-preference.v1';
        const allowed = ['light', 'dark', 'system'];
        const root = document.documentElement;

        function getSavedPreference() {
          try {
            const stored = window.localStorage.getItem(STORAGE_KEY);
            return allowed.includes(stored || '') ? stored : 'system';
          } catch {
            return 'system';
          }
        }

        const preference = getSavedPreference();
        const systemPrefersDark = typeof window.matchMedia === 'function'
          && window.matchMedia('(prefers-color-scheme: dark)').matches;
        const effectiveTheme = preference === 'system'
          ? (systemPrefersDark ? 'dark' : 'light')
          : preference;

        root.dataset.themePreference = preference;
        root.dataset.theme = effectiveTheme;
        root.style.colorScheme = effectiveTheme;
      })();
    </script>

