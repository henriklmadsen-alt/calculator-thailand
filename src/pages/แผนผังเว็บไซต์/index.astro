---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categories, calculators, getCalculatorsByCategory } from '../../lib/calculators';
import { CALCULATOR_AFFILIATE_MAP } from '../../data/affiliate-config';
import { getIndexPolicyForPath } from '../../data/index-quality-policy.mjs';

const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://www.kamnuanlek.com').replace(/\/$/, '');
const canonical = `${siteUrl}/แผนผังเว็บไซต์/`;
const affiliateHrefSet = new Set(Object.keys(CALCULATOR_AFFILIATE_MAP));

const priorityHrefs = new Set([
  '/คำนวณค่าไฟฟ้า/',
  '/คำนวณอายุ/',
  '/คำนวณภาษีมูลค่าเพิ่ม/',
  '/คำนวณค่าโอที/',
  '/คำนวณ-bmi/',
  '/คำนวณผ่อนรถ/',
  '/คำนวณผ่อนบ้าน/',
  '/คำนวณภาษีเงินได้บุคคลธรรมดา/',
  '/คำนวณเงินเดือนสุทธิ/',
  '/คำนวณประกันสังคม/',
  '/คำนวณดอกเบี้ยเงินฝาก/',
  '/คำนวณเปอร์เซ็นต์/',
]);

const sortedCategories = [...categories].sort((a, b) => a.sortOrder - b.sortOrder);
const isIndexTargetCalculator = (href: string) => getIndexPolicyForPath(href).index;
const indexTargetCalculators = calculators.filter((calc) => isIndexTargetCalculator(calc.href));
const priorityCalculators = calculators
  .filter((calc) => isIndexTargetCalculator(calc.href))
  .filter((calc) => priorityHrefs.has(calc.href) || calc.popular || affiliateHrefSet.has(calc.href))
  .slice(0, 40);

const articleModules = import.meta.glob('../บทความ/**/index.astro');
const articleRoutes = Object.keys(articleModules)
  .filter((key) => key !== '../บทความ/index.astro')
  .map((key) => {
    const slug = key.replace('../บทความ/', '').replace('/index.astro', '');
    return {
      href: `/บทความ/${slug}/`,
      title: slug.replace(/-/g, ' '),
    };
  })
  .filter((article) => getIndexPolicyForPath(article.href).index)
  .sort((a, b) => a.title.localeCompare(b.title, 'th'));

const routeCount = indexTargetCalculators.length + articleRoutes.length + sortedCategories.length + 6;
---

<BaseLayout
  title="แผนผังเว็บไซต์ Kamnuanlek | เครื่องคำนวณและบทความทั้งหมด"
  description="แผนผังเว็บไซต์สำหรับค้นหาเครื่องคำนวณไทย บทความ สูตรคำนวณ หมวดหมู่ และไฟล์ sitemap/llms ของ Kamnuanlek"
  canonical={canonical}
  pageName="แผนผังเว็บไซต์"
>
  <article data-html-sitemap class="space-y-8">
    <header class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm sm:p-6">
      <p class="text-sm font-semibold text-primary-700">HTML sitemap</p>
      <h1 class="mt-1 text-2xl font-extrabold text-slate-950 sm:text-3xl">แผนผังเว็บไซต์ Kamnuanlek</h1>
      <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-600">
        รวมเส้นทางสำคัญของเว็บไซต์ให้ผู้ใช้และ crawler เข้าถึงเครื่องคำนวณยอดนิยม หมวดหมู่ และบทความสูตรได้เร็วขึ้น
        ปัจจุบันมีลิงก์ภายในประมาณ {routeCount.toLocaleString('th-TH')} รายการ
      </p>
      <div class="mt-4 flex flex-wrap gap-3 text-sm">
        <a href="/sitemap-index.xml" class="rounded-lg border border-slate-200 px-3 py-2 font-semibold text-slate-700 hover:border-primary-300 hover:text-primary-700">XML sitemap</a>
        <a href="/llms.txt" class="rounded-lg border border-slate-200 px-3 py-2 font-semibold text-slate-700 hover:border-primary-300 hover:text-primary-700">llms.txt</a>
        <a href="/api/llm-context.json" class="rounded-lg border border-slate-200 px-3 py-2 font-semibold text-slate-700 hover:border-primary-300 hover:text-primary-700">LLM context JSON</a>
      </div>
    </header>

    <section class="rounded-2xl border border-primary-100 bg-primary-50 p-5 sm:p-6">
      <h2 class="text-lg font-bold text-primary-950">เครื่องคำนวณที่ควรเข้าก่อน</h2>
      <p class="mt-1 text-sm leading-6 text-primary-800">กลุ่มนี้คือหน้า traffic, affiliate, และ query intent สูงที่สุด จึงถูกวางไว้ตื้นที่สุดในแผนผัง</p>
      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {priorityCalculators.map((calc) => (
          <a href={calc.href} class="rounded-xl border border-primary-100 bg-white p-4 text-sm shadow-sm hover:border-primary-300">
            <span class="block font-bold text-slate-950">{calc.title}</span>
            <span class="mt-1 block leading-6 text-slate-600">{calc.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="space-y-5">
      <h2 class="text-lg font-bold text-slate-950">หมวดหมู่เครื่องคำนวณ</h2>
      <div class="grid gap-4 lg:grid-cols-2">
        {sortedCategories.map((cat) => {
          const categoryCalculators = getCalculatorsByCategory(cat.id).filter((calc) => isIndexTargetCalculator(calc.href));
          return (
            <section class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <h3 class="text-base font-bold text-slate-950">
                    <a href={`/หมวดหมู่/${cat.slug}/`} class="hover:text-primary-700">{cat.icon} {cat.name}</a>
                  </h3>
                  <p class="mt-1 text-xs leading-5 text-slate-500">{categoryCalculators.length} เครื่องมือ</p>
                </div>
                <a href={`/หมวดหมู่/${cat.slug}/`} class="text-xs font-semibold text-primary-700 hover:underline">เปิดหมวด</a>
              </div>
              <ul class="mt-4 grid gap-2 text-sm sm:grid-cols-2">
                {categoryCalculators.map((calc) => (
                  <li>
                    <a href={calc.href} class="text-slate-700 hover:text-primary-700 hover:underline">
                      {calc.title}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          );
        })}
      </div>
    </section>

    <section class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm sm:p-6">
      <h2 class="text-lg font-bold text-slate-950">บทความและคำตอบสูตร</h2>
      <p class="mt-1 text-sm leading-6 text-slate-600">บทความช่วยตอบ long-tail query และเชื่อมกลับไปเครื่องคำนวณที่เกี่ยวข้อง</p>
      <ul class="mt-4 grid gap-2 text-sm sm:grid-cols-2 lg:grid-cols-3">
        {articleRoutes.map((article) => (
          <li>
            <a href={article.href} class="text-slate-700 hover:text-primary-700 hover:underline">{article.title}</a>
          </li>
        ))}
      </ul>
    </section>
  </article>
</BaseLayout>
