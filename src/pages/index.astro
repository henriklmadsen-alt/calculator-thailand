  <!-- Client-side: Search and recently used calculators -->
  <script is:inline>
  (function() {
    var items = document.querySelectorAll('.calc-item');
    var allCalcs = [];
    var searchIndexLoaded = false;
    var searchIndexPromise = null;

    loadVisibleCalculatorCards();

    function loadVisibleCalculatorCards() {
      items.forEach(function(el) {
        allCalcs.push(normalizeCalc({
          title: el.getAttribute('data-title') || '',
          desc: el.getAttribute('data-desc') || '',
          category: el.getAttribute('data-category') || '',
          icon: el.getAttribute('data-icon') || '',
          searchText: el.getAttribute('data-search') || '',
          href: el.getAttribute('href') || '',
          html: el.outerHTML
        }));
      });
    }

    function ensureSearchIndex() {
      if (searchIndexLoaded) return Promise.resolve(allCalcs);
      if (searchIndexPromise) return searchIndexPromise;

      searchIndexPromise = fetch('/api/calculator-search-index.json', {
        credentials: 'same-origin',
        headers: { Accept: 'application/json' }
      })
        .then(function(response) {
          if (!response.ok) throw new Error('search index unavailable');
          return response.json();
        })
        .then(function(parsedIndex) {
          if (Array.isArray(parsedIndex) && parsedIndex.length > 0) {
            allCalcs = parsedIndex.map(normalizeCalc);
            searchIndexLoaded = true;
          }
          return allCalcs;
        })
        .catch(function() {
          return allCalcs;
        });

      return searchIndexPromise;
    }

    // ── Search ──
    var searchInput = document.getElementById('calc-search');
    var searchResults = document.getElementById('search-results');
    var searchGrid = document.getElementById('search-results-grid');
    var searchNoResults = document.getElementById('search-no-results');
    var searchCount = document.getElementById('search-result-count');
    var searchClear = document.getElementById('calc-search-clear');
    var mainContent = document.getElementById('main-content');
    var quickSearchButtons = document.querySelectorAll('.quick-search');
    var debounceTimer = null;
    var lastTrackedSearch = '';
    var lastTrackedZeroSearch = '';

    if (searchInput) {
      searchInput.addEventListener('focus', ensureSearchIndex, { once: true });
      searchInput.addEventListener('input', function() {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(handleSearch, 150);
      });
    }

    quickSearchButtons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        if (!searchInput) return;
        searchInput.value = btn.getAttribute('data-query') || '';
        handleSearch();
        searchInput.focus();
      });
    });

    if (searchClear) {
      searchClear.addEventListener('click', function() {
        if (!searchInput) return;
        searchInput.value = '';
        handleSearch();
        searchInput.focus();
      });
    }

    // ── URL param search (supports ?q= and ?search= for SearchAction / Sitelinks Searchbox) ──
    (function() {
      var params = new URLSearchParams(window.location.search);
      var q = params.get('q') || params.get('search') || '';
      if (q && searchInput) {
        searchInput.value = q;
        handleSearch();
        ensureSearchIndex().then(function() {
          handleSearch();
        });
        searchInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    })();

    bindCalculatorOsDemo();

    function handleSearch() {
      if (!searchInput || !searchResults || !searchGrid || !searchNoResults || !mainContent) return;

      var query = (searchInput.value || '').trim().toLowerCase();
      if (!query) {
        searchResults.classList.add('hidden');
        mainContent.classList.remove('hidden');
        searchGrid.innerHTML = '';
        searchNoResults.classList.add('hidden');
        if (searchCount) searchCount.textContent = '';
        if (searchClear) searchClear.classList.add('hidden');
        return;
      }
      mainContent.classList.add('hidden');
      searchResults.classList.remove('hidden');
      if (searchClear) searchClear.classList.remove('hidden');

      renderSearchResults(query);
      if (!searchIndexLoaded) {
        ensureSearchIndex().then(function() {
          if (!searchInput) return;
          var latestQuery = (searchInput.value || '').trim().toLowerCase();
          if (latestQuery) renderSearchResults(latestQuery);
        });
      }
    }

    function renderSearchResults(query) {
      var matches = allCalcs
        .map(function(c, index) {
          return {
            calc: c,
            score: scoreSearchResult(c, query),
            index: index
          };
        })
        .filter(function(entry) {
          return entry.score > 0;
        })
        .sort(function(a, b) {
          if (b.score !== a.score) return b.score - a.score;
          return a.index - b.index;
        })
        .map(function(entry) {
          return entry.calc;
        });

      if (searchIndexLoaded && query.length >= 2 && query !== lastTrackedSearch && typeof window.trackLanguageAwareEvent === 'function') {
        lastTrackedSearch = query;
        window.trackLanguageAwareEvent('site_search', {
          search_term: query,
          result_count: String(matches.length),
          page_path: window.location.pathname
        });
      }

      if (searchCount) searchCount.textContent = matches.length + ' รายการ';

      if (matches.length === 0) {
        if (searchIndexLoaded && query.length >= 2 && query !== lastTrackedZeroSearch && typeof window.trackLanguageAwareEvent === 'function') {
          lastTrackedZeroSearch = query;
          window.trackLanguageAwareEvent('site_search_zero_results', {
            search_term: query,
            result_count: '0',
            page_path: window.location.pathname
          });
        }
        searchGrid.innerHTML = '';
        searchNoResults.classList.remove('hidden');
      } else {
        searchNoResults.classList.add('hidden');
        searchGrid.innerHTML = matches.map(function(m) { return m.html; }).join('');
      }
    }

    // ── Recently Used ──
    var RECENT_KEY = 'ct.recent-calcs.v1';
    var recentSection = document.getElementById('recent-section');
    var recentRow = document.getElementById('recent-row');

    function escapeHtml(value) {
      return String(value || '').replace(/[&<>"']/g, function(ch) {
        return {
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;'
        }[ch];
      });
    }

    function normalizeCalc(raw) {
      var calc = {
        title: String(raw.title || ''),
        titleRaw: String(raw.title || raw.titleRaw || ''),
        desc: String(raw.desc || ''),
        descRaw: String(raw.descRaw || raw.desc || ''),
        category: String(raw.category || ''),
        icon: String(raw.icon || ''),
        searchText: String(raw.searchText || ''),
        href: String(raw.href || ''),
        tag: String(raw.tag || ''),
        tagColor: String(raw.tagColor || ''),
        affiliate: Boolean(raw.affiliate),
        html: raw.html || ''
      };
      calc.searchText = (calc.searchText || [calc.title, calc.desc, calc.category].join(' ')).toLowerCase();
      calc.title = calc.title.toLowerCase();
      calc.desc = calc.descRaw.toLowerCase();
      calc.html = calc.html || renderCalculatorCard(calc);
      return calc;
    }

    function scoreSearchResult(calc, query) {
      var title = calc.title || '';
      var desc = calc.desc || '';
      var href = '';

      try {
        href = decodeURIComponent(calc.href || '').toLowerCase();
      } catch(e) {
        href = String(calc.href || '').toLowerCase();
      }

      var category = String(calc.category || '').toLowerCase();
      var searchText = calc.searchText || '';
      var score = 0;

      if (title === query) score += 1200;
      if (title.indexOf(query) === 0) score += 950;
      if (title.indexOf(query) > 0) score += 820;
      if (href.indexOf(query) !== -1) score += 620;
      if (desc.indexOf(query) !== -1) score += 420;
      if (category.indexOf(query) !== -1) score += 180;
      if (searchText.indexOf(query) !== -1) score += 80;
      if (calc.affiliate) score += 8;

      query.split(/\s+/).filter(Boolean).forEach(function(token) {
        if (token === query) return;
        if (title.indexOf(token) !== -1) score += 120;
        if (desc.indexOf(token) !== -1) score += 70;
        if (searchText.indexOf(token) !== -1) score += 16;
      });

      return score;
    }

    function bindCalculatorOsDemo() {
      var demo = document.querySelector('[data-calculatoros-demo]');
      if (!demo) return;

      var output = demo.querySelector('[data-demo-output]');
      var expression = demo.querySelector('[data-demo-expression]');
      var title = demo.querySelector('[data-demo-title]');
      var clearButton = demo.querySelector('[data-demo-clear]');
      var keys = demo.querySelectorAll('[data-demo-key]');
      var current = '0';
      var stored = null;
      var operator = null;
      var waitingForOperand = true;
      var expressionText = 'บ้านใช้ไฟ 300 หน่วย · PEA/MEA';
      var justCalculated = false;

      var operatorLabels = {
        '+': '+',
        '-': '−',
        '*': '×',
        '/': '÷'
      };

      function formatNumber(value) {
        var number = Number(value);
        if (!Number.isFinite(number)) return 'Error';
        var rounded = Math.round(number * 100000000) / 100000000;
        return new Intl.NumberFormat('th-TH', {
          maximumFractionDigits: 8
        }).format(rounded);
      }

      function render() {
        if (output) output.textContent = formatNumber(current);
        if (expression) expression.textContent = expressionText || 'แตะตัวเลขเพื่อคำนวณทันที';
        if (title) title.textContent = 'เครื่องคิดเลข';
      }

      function clear() {
        current = '0';
        stored = null;
        operator = null;
        waitingForOperand = true;
        justCalculated = false;
        expressionText = 'แตะตัวเลขเพื่อคำนวณทันที';
        render();
      }

      function inputDigit(digit) {
        if (waitingForOperand || justCalculated) {
          current = digit;
          waitingForOperand = false;
          justCalculated = false;
        } else if (current === '0') {
          current = digit;
        } else if (current.length < 12) {
          current += digit;
        }
        expressionText = operator && stored !== null
          ? formatNumber(stored) + ' ' + operatorLabels[operator] + ' ' + current
          : current;
        render();
      }

      function inputDecimal() {
        if (waitingForOperand || justCalculated) {
          current = '0.';
          waitingForOperand = false;
          justCalculated = false;
        } else if (current.indexOf('.') === -1) {
          current += '.';
        }
        expressionText = operator && stored !== null
          ? formatNumber(stored) + ' ' + operatorLabels[operator] + ' ' + current
          : current;
        render();
      }

      function calculate(first, second, op) {
        if (op === '+') return first + second;
        if (op === '-') return first - second;
        if (op === '*') return first * second;
        if (op === '/') return second === 0 ? NaN : first / second;
        return second;
      }

      function handleOperator(nextOperator) {
        var inputValue = Number(current);
        if (!Number.isFinite(inputValue)) {
          clear();
          return;
        }

        if (operator && !waitingForOperand) {
          var result = calculate(Number(stored), inputValue, operator);
          expressionText = formatNumber(stored) + ' ' + operatorLabels[operator] + ' ' + formatNumber(inputValue);
          current = String(result);
          stored = result;
        } else {
          stored = inputValue;
        }

        operator = nextOperator;
        waitingForOperand = true;
        justCalculated = false;
        expressionText = formatNumber(stored) + ' ' + operatorLabels[operator];
        render();
      }

      function handleEquals() {
        if (!operator || stored === null) {
          expressionText = current;
          justCalculated = true;
          render();
          return;
        }

        var inputValue = Number(current);
        var result = calculate(Number(stored), inputValue, operator);
        expressionText = formatNumber(stored) + ' ' + operatorLabels[operator] + ' ' + formatNumber(inputValue) + ' =';
        current = String(result);
        stored = null;
        operator = null;
        waitingForOperand = true;
        justCalculated = true;
        render();
      }

      function pressKey(value) {
        if (/^\d$/.test(value)) {
          inputDigit(value);
          return;
        }
        if (value === '.') {
          inputDecimal();
          return;
        }
        if (value === '=') {
          handleEquals();
          return;
        }
        if (operatorLabels[value]) {
          handleOperator(value);
        }
      }

      keys.forEach(function(button) {
        button.addEventListener('click', function() {
          pressKey(button.getAttribute('data-demo-key') || '');
        });
      });

      if (clearButton) {
        clearButton.addEventListener('click', clear);
      }
    }

    function renderCalculatorCard(calc) {
      var affiliate = calc.affiliate ? '<span class="ct-ai-affiliate-pill">สมัครได้</span>' : '';
      var tag = calc.tag ? '<span class="ct-ai-result-tag ' + escapeHtml(calc.tagColor) + '">' + escapeHtml(calc.tag) + '</span>' : '';
      return '<a href="' + escapeHtml(calc.href) + '" data-category="' + escapeHtml(calc.category) + '" data-icon="' + escapeHtml(calc.icon) + '" data-search="' + escapeHtml(calc.searchText) + '" data-title="' + escapeHtml(calc.titleRaw) + '" data-desc="' + escapeHtml(calc.descRaw) + '" class="ct-ai-directory-card calc-card calc-item group relative block rounded-2xl border border-gray-100 bg-white p-5 shadow-sm transition hover:border-primary-200 hover:shadow-md sm:p-6">' +
        affiliate +
        tag +
        '<div class="text-3xl mb-3">' + escapeHtml(calc.icon) + '</div>' +
        '<h3 class="text-lg font-bold text-gray-900 group-hover:text-primary-600 transition-colors mb-1.5">' + escapeHtml(calc.titleRaw) + '</h3>' +
        '<p class="text-sm text-gray-500 leading-relaxed">' + escapeHtml(calc.descRaw) + '</p>' +
        '<div class="mt-4 flex items-center text-primary-600 text-sm font-medium opacity-0 group-hover:opacity-100 transition-opacity">เปิดเครื่องคำนวณ' +
          '<svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">' +
            '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />' +
          '</svg>' +
        '</div>' +
      '</a>';
    }

    function getRecent() {
      try {
        var data = JSON.parse(localStorage.getItem(RECENT_KEY) || '[]');
        return Array.isArray(data) ? data.slice(0, 5) : [];
      } catch(e) { return []; }
    }

    function renderRecent() {
      var recent = getRecent();
      if (recent.length === 0 || !recentSection || !recentRow) return;

      var cards = [];
      recent.forEach(function(href) {
        var match = allCalcs.find(function(c) { return c.href === href; });
        if (match) cards.push(match);
      });

      if (cards.length === 0) return;
      recentSection.classList.remove('hidden');
      recentRow.innerHTML = cards.map(function(c) {
        return '<a href="' + escapeHtml(c.href) + '" class="flex min-w-[190px] flex-shrink-0 items-center gap-3 rounded-xl border border-gray-100 bg-gray-50 px-3 py-2.5 transition hover:border-primary-200 hover:bg-primary-50 lg:min-w-0 lg:w-full">' +
          '<span class="text-xl" aria-hidden="true">' + escapeHtml(c.icon) + '</span>' +
          '<span class="min-w-0 truncate text-sm font-medium text-gray-700">' + escapeHtml(c.titleRaw) + '</span>' +
        '</a>';
      }).join('');
    }

    renderRecent();

    // ── Clear Recent ──
    var clearBtn = document.getElementById('recent-clear');
    if (clearBtn) {
      clearBtn.addEventListener('click', function() {
        try { localStorage.removeItem(RECENT_KEY); } catch(e) {}
        if (recentSection) recentSection.classList.add('hidden');
        if (recentRow) recentRow.innerHTML = '';
      });
    }
  })();
  </script>
</BaseLayout>
