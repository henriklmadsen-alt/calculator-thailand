---
import BaseLayout from '../layouts/BaseLayout.astro';
import FavoriteCalculators from '../components/templates/FavoriteCalculators.astro';
import TrafficGrowthCluster from '../components/templates/TrafficGrowthCluster.astro';
import { categories, calculators, getCategoryCounts, getPopularCalculators } from '../lib/calculators';
import { GLOBAL_SEARCH_SYNONYMS, getSearchSynonymsForCalculator } from '../lib/search-synonyms';
import { CALCULATOR_AFFILIATE_MAP } from '../data/affiliate-config';
import { homepageGrowthLinks, recoveryGrowthLinks } from '../data/traffic-growth-opportunities';
import { AFFILIATE_EXTENSION_CLUSTERS, PRIMARY_TRAFFIC_CLUSTERS } from '../data/keyword-conquest-map';

const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://www.kamnuanlek.com').replace(/\/$/, '');
const HOME_MAX_CALCULATORS = 50;
const counts = getCategoryCounts();
const popular = getPopularCalculators();
const sortedCategories = [...categories].sort((a, b) => a.sortOrder - b.sortOrder);
const categoryById = new Map(categories.map((cat) => [cat.id, cat]));
const categoryPriority = [
  'tax',
  'loan',
  'salary',
  'bills',
  'realestate',
  'vehicles',
  'creditcard',
  'insurance',
  'savings',
  'health',
  'budget',
  'business',
];
const prioritizedCategories = [
  ...categoryPriority
    .map((id) => categoryById.get(id))
    .filter((cat): cat is (typeof categories)[number] => Boolean(cat)),
  ...sortedCategories.filter((cat) => !categoryPriority.includes(cat.id)),
];
const primaryCategories = prioritizedCategories.slice(0, 10);
const moreCategories = prioritizedCategories.slice(10);
const affiliateHrefSet = new Set(Object.keys(CALCULATOR_AFFILIATE_MAP));
const calculatorByHref = new Map(calculators.map((calc) => [calc.href, calc]));
const priorityKeywordHrefs = PRIMARY_TRAFFIC_CLUSTERS.map((cluster) => cluster.calculatorHref);
const affiliateKeywordHrefs = AFFILIATE_EXTENSION_CLUSTERS.map((cluster) => cluster.calculatorHref);
const highIntentHrefs = [
  ...priorityKeywordHrefs,
  ...affiliateKeywordHrefs,
  '/คำนวณภาษีเงินได้บุคคลธรรมดา/',
  '/คำนวณเงินเดือนสุทธิ/',
  '/คำนวณค่าไฟฟ้า/',
  '/คำนวณผ่อนบ้าน/',
  '/คำนวณผ่อนรถ/',
  '/คำนวณภาษีมูลค่าเพิ่ม/',
  '/คำนวณอายุ/',
  '/คำนวณค่าโอที/',
  '/คำนวณประกันสังคม/',
  '/คำนวณ-bmi/',
  '/คำนวณดัชนีมวลกาย/',
  '/คำนวณเปอร์เซ็นต์/',
  '/คำนวณดอกเบี้ยเงินฝาก/',
  '/คำนวณดอกเบี้ยเงินฝากประจำ/',
  '/คำนวณผ่อนกู้/',
  '/คำนวณสินเชื่อฉุกเฉิน/',
  '/คำนวณผ่อนสินเชื่อส่วนบุคคล/',
  '/คำนวณ-apr/',
  '/คำนวณค่างวดสินเชื่อรถ/',
  '/คำนวณดอกเบี้ยบัตรเครดิต/',
  '/คำนวณค่างวดบัตรเครดิต/',
  '/คำนวณอัตราการใช้วงเงินบัตรเครดิต/',
  '/คำนวณเบี้ยประกันรถยนต์/',
  '/คำนวณค่าประกันรถยนต์/',
  '/คำนวณประกันชีวิต/',
  '/คำนวณเบี้ยประกันสุขภาพ/',
  '/คำนวณเบี้ยประกันสุขภาพผู้สูงอายุ/',
  '/คำนวณประกันสุขภาพครอบครัว/',
  '/คำนวณค่าโอนบ้าน/',
  '/คำนวณภาษีที่ดินและสิ่งปลูกสร้าง/',
  '/คำนวณค่าน้ำ/',
  '/คำนวณค่าน้ำมัน/',
  '/คำนวณค่าใช้จ่ายรายเดือน/',
  '/คำนวณเงินเกษียณ/',
  '/คำนวณเงินออม/',
  '/คำนวณดอกเบี้ยทบต้น/',
  '/คำนวณเกรดเฉลี่ย/',
  '/คำนวณพื้นที่/',
  '/คำนวณหน่วย/',
];
const highIntentCalculators = highIntentHrefs
  .map((href) => calculatorByHref.get(href))
  .filter((calc): calc is (typeof calculators)[number] => Boolean(calc));
const affiliateCalculators = calculators.filter((calc) => affiliateHrefSet.has(calc.href));
const homepageCalculatorMap = new Map<string, (typeof calculators)[number]>();
for (const calc of [...highIntentCalculators, ...affiliateCalculators, ...popular, ...calculators]) {
  homepageCalculatorMap.set(calc.href, calc);
}
const homepageCalculators = Array.from(homepageCalculatorMap.values()).slice(0, HOME_MAX_CALCULATORS);
const featuredCalculators = homepageCalculators.slice(0, 12);

const getCalculatorSearchText = (calc: (typeof calculators)[number]) => {
  const categoryIds = [calc.categoryId, ...(calc.secondaryCategories || [])];
  const categoryText = categoryIds.flatMap((id) => {
    const cat = categoryById.get(id);
    return cat ? [cat.id, cat.name, cat.nameEn, cat.slug, cat.description] : [id];
  });

  const synonyms = getSearchSynonymsForCalculator(calc);
  return [calc.title, calc.desc, ...categoryText, ...GLOBAL_SEARCH_SYNONYMS, ...synonyms].filter(Boolean).join(' ');
};

const topActions = [
  { title: 'ภาษีเงินได้', desc: 'เช็กภาษีและลดหย่อนปี 2569', href: '/คำนวณภาษีเงินได้บุคคลธรรมดา/', icon: '💰', tone: 'amber' },
  { title: 'เงินเดือนสุทธิ', desc: 'เงินรับจริงหลังหักภาษีและประกันสังคม', href: '/คำนวณเงินเดือนสุทธิ/', icon: '💼', tone: 'green' },
  { title: 'ค่าไฟฟ้า', desc: 'PEA/MEA ค่า Ft และ VAT', href: '/คำนวณค่าไฟฟ้า/', icon: '⚡', tone: 'yellow' },
  { title: 'ผ่อนบ้าน', desc: 'ค่างวด รีไฟแนนซ์ จุดคุ้มทุน', href: '/คำนวณผ่อนบ้าน/', icon: '🏠', tone: 'rose' },
  { title: 'ผ่อนรถ', desc: 'ค่างวด 48/60/72/84 เดือน', href: '/คำนวณผ่อนรถ/', icon: '🚗', tone: 'blue' },
  { title: 'VAT 7%', desc: 'บวก VAT ถอด VAT จากราคารวม', href: '/คำนวณภาษีมูลค่าเพิ่ม/', icon: '🧾', tone: 'slate' },
];

const quickSearches = [
  ...PRIMARY_TRAFFIC_CLUSTERS.map((cluster) => cluster.quickSearchLabel),
  ...AFFILIATE_EXTENSION_CLUSTERS.map((cluster) => cluster.quickSearchLabel),
  'ภาษี',
  'เงินเดือน',
  'ประกันรถ',
].slice(0, 10);

const popularToday = [
  { label: 'ค่าไฟบ้าน', href: '/คำนวณค่าไฟฟ้า/', metric: 'PEA/MEA', icon: '⚡' },
  { label: 'คำนวณอายุ', href: '/คำนวณอายุ/', metric: 'พ.ศ./ค.ศ.', icon: '🎂' },
  { label: 'เงินเดือนรับจริง', href: '/คำนวณเงินเดือนสุทธิ/', metric: 'ภาษี + ประกันสังคม', icon: '💼' },
  { label: 'ค่างวดรถ', href: '/คำนวณผ่อนรถ/', metric: '48-84 งวด', icon: '🚗' },
  { label: 'VAT 7%', href: '/คำนวณภาษีมูลค่าเพิ่ม/', metric: 'บวก/ถอดภาษี', icon: '🧾' },
  { label: 'ค่าโอที', href: '/คำนวณค่าโอที/', metric: '1.5x 2x 3x', icon: '⏱️' },
];

const newestCalculators = [
  { title: 'คำนวณ CAGR', icon: '📈', href: '/คำนวณ-cagr-อัตราเติบโตทบต้นรายปี/' },
  { title: 'คำนวณ IRR', icon: '💹', href: '/คำนวณ-irr-อัตราผลตอบแทนภายใน/' },
  { title: 'คำนวณ NPV', icon: '🏦', href: '/คำนวณ-npv-มูลค่าปัจจุบันสุทธิ/' },
  { title: 'คำนวณจุดคุ้มทุน', icon: '🎯', href: '/คำนวณ-จุดคุ้มทุน-break-even/' },
  { title: 'ดอกเบี้ยทบต้น', icon: '💰', href: '/คำนวณ-ดอกเบี้ยทบต้น/' },
  { title: 'มูลค่าปัจจุบัน', icon: '⏮️', href: '/คำนวณ-มูลค่าปัจจุบัน-present-value/' },
  { title: 'มูลค่าอนาคต', icon: '⏭️', href: '/คำนวณ-มูลค่าอนาคต-future-value/' },
  { title: 'คำนวณ ROE', icon: '📊', href: '/คำนวณ-roe-ผลตอบแทนผู้ถือหุ้น/' },
];

const jsonLdWebsite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Kamnuanlek',
  alternateName: 'คำนวณเลข',
  url: siteUrl,
  inLanguage: 'th',
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteUrl}/?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

const jsonLdItemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'เครื่องคำนวณออนไลน์สำหรับคนไทย',
  itemListElement: homepageCalculators.map((calc, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: calc.title,
    url: `${siteUrl}${calc.href}`,
  })),
};

const homepageFaqItems = [
  {
    question: 'คำถามที่พบบ่อยเรื่องแรก: ควรเริ่มคำนวณอะไรเมื่อวางแผนการเงิน?',
    answer: 'เริ่มจากคำนวณเงินเดือนสุทธิ ต่อด้วยค่าใช้จ่ายคงที่ แล้ววางเป้าหมายออมเงินด้วยเครื่องคำนวณดอกเบี้ยเงินฝากหรือเครื่องคำนวณเงินเกษียณเพื่อดูภาพรวมระยะยาว.',
  },
  {
    question: 'การคำนวณภาษีเงินได้ให้แม่นยำต้องใส่ข้อมูลอะไรบ้าง?',
    answer: 'ควรใส่รายได้ทั้งปี รายการลดหย่อนจริง และเงินสมทบประกันสังคมให้ครบ จากนั้นเทียบผลกับเอกสารภาษีก่อนยื่นจริง.',
  },
  {
    question: 'ถ้าจะกู้ซื้อบ้านหรือรถ ควรดูตัวเลขไหนเป็นหลัก?',
    answer: 'ให้ดูค่างวดต่อเดือน ดอกเบี้ยรวมตลอดสัญญา และสัดส่วนค่างวดต่อรายได้สุทธิ เพื่อควบคุมความเสี่ยงด้านสภาพคล่อง.',
  },
  {
    question: 'ข้อมูลอัตราภาษี ค่าไฟ หรือประกันสังคมอัปเดตถึงปีไหน?',
    answer: 'เว็บไซต์อัปเดตสูตรและอัตราตามประกาศทางการล่าสุดของปี 2569 (2026) พร้อมแหล่งอ้างอิงให้ตรวจสอบได้.',
  },
];

const jsonLdFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homepageFaqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<BaseLayout
  title="Kamnuanlek — เครื่องคำนวณออนไลน์ฟรีสำหรับคนไทย 2569"
  description="คำนวณภาษีเงินได้ ผ่อนบ้าน ผ่อนรถ เงินเดือนสุทธิ ค่าไฟ และอีก 800+ รายการ ฟรี ไม่ต้องสมัคร อัปเดตปี 2569 ถูกต้องตามกฎหมายไทย"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdWebsite)} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdItemList)} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />
  <div class="ct-ai-home">
  <section class="ct-ai-hero ct-wow-hero mb-10">
    <div class="ct-ai-hero-grid ct-wow-hero-grid grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(320px,440px)] lg:items-center">
      <div class="ct-wow-copy min-w-0">
        <div class="ct-ai-kicker mb-4 inline-flex items-center gap-2 rounded-full border border-primary-100 bg-primary-50 px-3 py-1 text-xs font-semibold text-primary-700">
          <span aria-hidden="true">🇹🇭</span>
          อัปเดตปี 2569 · ฟรี · ไม่ต้องสมัคร
        </div>

        <h1 class="ct-ai-title ct-wow-title max-w-4xl text-3xl font-extrabold leading-tight tracking-normal text-gray-950 sm:text-5xl">
          <span class="ct-wow-brand">Kamnuanlek</span>
          <span class="ct-wow-title-line">เครื่องคำนวณสำหรับชีวิตไทย</span>
        </h1>

        <p class="ct-ai-subtitle mt-3 max-w-2xl text-base leading-7 text-gray-600 sm:text-lg">
          ค้นหาเครื่องคำนวณสำหรับภาษี เงินเดือน ค่าไฟ สินเชื่อ บ้าน รถ สุขภาพ และงานประจำวันของคนไทย
        </p>

        <div class="ct-ai-search-wrap mt-6 max-w-3xl">
          <label for="calc-search" class="sr-only">ค้นหาเครื่องคำนวณ</label>
          <div class="relative">
            <svg class="ct-ai-search-icon pointer-events-none absolute left-5 top-1/2 h-5 w-5 -translate-y-1/2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              id="calc-search"
              type="text"
              data-lazy-search-index="focus"
              inputmode="search"
              enterkeyhint="search"
              placeholder="ค้นหา เช่น ผ่อนรถ, เงินเดือนสุทธิ, VAT, ค่าไฟ"
              autocomplete="off"
              class="ct-ai-search-input h-16 w-full rounded-2xl border border-gray-200 bg-white pl-14 pr-14 text-base font-medium text-gray-900 shadow-sm outline-none transition focus:border-primary-400 focus:ring-4 focus:ring-primary-100"
            />
            <button
              id="calc-search-clear"
              type="button"
              class="ct-ai-search-clear hidden absolute right-3 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-xl text-gray-400 transition hover:bg-gray-100 hover:text-gray-700"
              aria-label="ล้างคำค้นหา"
            >
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
          <div class="ct-wow-quick-searches mt-3 flex flex-wrap gap-2" aria-label="คำค้นหายอดนิยม">
            {quickSearches.map((term) => (
              <button
                type="button"
                class="ct-ai-chip quick-search rounded-full border border-gray-200 bg-white px-3 py-1.5 text-sm font-medium text-gray-600 transition hover:border-primary-200 hover:bg-primary-50 hover:text-primary-700"
                data-query={term}
              >
                {term}
              </button>
            ))}
          </div>
          <div class="ct-wow-proof-row mt-5 grid gap-2 sm:grid-cols-3">
            <a href="/about/methodology/" class="ct-wow-proof-link">
              <span>สูตรไทย 2569</span>
              <strong>อ้างอิงชัดเจน</strong>
            </a>
            <a href="/ai-advisor/" class="ct-wow-proof-link">
              <span>AI ช่วยอธิบาย</span>
              <strong>เข้าใจผลลัพธ์เร็ว</strong>
            </a>
            <a href="#calculators" class="ct-wow-proof-link">
              <span>50 เครื่องมือหลัก</span>
              <strong>หาได้ในไม่กี่วินาที</strong>
            </a>
          </div>
        </div>
      </div>

      <aside class="ct-wow-scene" aria-label="ตัวอย่างเครื่องคำนวณ Kamnuanlek">
        <div class="ct-wow-device" data-calculatoros-demo>
          <div class="ct-wow-device-bar">
            <span>Kamnuanlek</span>
            <strong>CalculatorOS</strong>
          </div>
          <div class="ct-wow-screen">
            <div class="ct-wow-result-preview" role="status" aria-live="polite">
              <div class="ct-wow-result-topline">
                <span data-demo-title>คำนวณค่าไฟ</span>
                <button type="button" class="ct-wow-clear" data-demo-clear aria-label="ล้างตัวเลข">AC</button>
              </div>
              <strong data-demo-output>1,277.41 บาท</strong>
              <small data-demo-expression>บ้านใช้ไฟ 300 หน่วย · PEA/MEA</small>
            </div>
            <div class="ct-wow-keypad" aria-label="เครื่องคิดเลขตัวอย่าง">
              {[
                { label: '7', value: '7' },
                { label: '8', value: '8' },
                { label: '9', value: '9' },
                { label: '÷', value: '/' },
                { label: '4', value: '4' },
                { label: '5', value: '5' },
                { label: '6', value: '6' },
                { label: '×', value: '*' },
                { label: '1', value: '1' },
                { label: '2', value: '2' },
                { label: '3', value: '3' },
                { label: '−', value: '-' },
                { label: '0', value: '0' },
                { label: '.', value: '.' },
                { label: '=', value: '=' },
                { label: '+', value: '+' },
              ].map((key) => (
                <button type="button" data-demo-key={key.value} class:list={['ct-wow-key', key.value === '=' && 'ct-wow-key-primary']}>{key.label}</button>
              ))}
            </div>
            <div class="ct-wow-live-list">
              <div class="ct-wow-live-heading">
                <span>ยอดนิยมวันนี้</span>
                <strong>ไทย 2569</strong>
              </div>
              {popularToday.slice(0, 4).map((item) => (
                <a href={item.href} class="ct-wow-live-row">
                  <span aria-hidden="true">{item.icon}</span>
                  <span>
                    <strong>{item.label}</strong>
                    <small>{item.metric}</small>
                  </span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- Search Results (hidden by default) -->
  <div id="search-results" class="ct-ai-search-results hidden mb-10 rounded-2xl border border-primary-100 bg-primary-50/40 p-4 sm:p-5">
    <div class="mb-4 flex items-center justify-between gap-3">
      <h2 class="text-lg font-bold text-gray-900">ผลการค้นหา</h2>
      <span id="search-result-count" class="text-sm font-medium text-gray-500"></span>
    </div>
    <div id="search-results-grid" class="grid gap-4 sm:gap-5 sm:grid-cols-2 lg:grid-cols-3"></div>
    <p id="search-no-results" class="hidden rounded-xl bg-white px-4 py-8 text-center text-gray-500">ไม่พบเครื่องคำนวณที่ตรงกัน ลองค้นด้วยคำว่า ภาษี เงินเดือน สินเชื่อ หรือค่าไฟ</p>
  </div>

  <!-- Main content wrapper (hidden during search) -->
  <div id="main-content" class="ct-ai-main" data-home-calculator-limit={HOME_MAX_CALCULATORS}>
    <TrafficGrowthCluster
      eyebrow="เส้นทางสำคัญ"
      title="เครื่องมือที่ควรเปิดจากหน้าแรกทันที"
