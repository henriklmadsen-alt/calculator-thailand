---
const targetPath = '/คำนวณดอกเบี้ยบัตรเครดิต/';
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://www.kamnuanlek.com').replace(/\/$/, '');
const targetUrl = `${siteUrl}${targetPath}`;
---
<!doctype html>
<html lang="th">
<head>
  <meta charset="utf-8" />
  <meta name="robots" content="noindex, follow, noarchive" />
  <meta http-equiv="refresh" content={`0;url=${targetPath}`} />
  <link rel="canonical" href={targetUrl} />
  <title>คำนวณค่างวดบัตรเครดิต 2569 | ดอกเบี้ยและแผนปิดหนี้ | Kamnuanlek</title>
  <meta name="description" content="คำนวณค่างวดบัตรเครดิต 2569 จากยอดคงค้าง ยอดชำระ และจำนวนวันในรอบบิล เพื่อวางแผนจ่ายเกินขั้นต่ำและปิดหนี้เร็วขึ้น" />
</head>
<body>
  <p>กำลังเปลี่ยนเส้นทางไปยัง <a href={targetPath}>เครื่องคำนวณค่างวดบัตรเครดิต</a></p>
</body>
</html>
