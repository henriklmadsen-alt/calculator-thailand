---
import RelatedCalculators from '../../components/templates/RelatedCalculators.astro';
import RelatedArticles from '../../components/templates/RelatedArticles.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuardedAdSlot from '../../components/templates/GuardedAdSlot.astro';
import FAQAccordion from '../../components/templates/FAQAccordion.astro';
import TrafficGrowthCluster from '../../components/templates/TrafficGrowthCluster.astro';
import AffiliateCard from '../../components/templates/AffiliateCard.astro';
import ResultSharePrompt from '../../components/templates/ResultSharePrompt.astro';
import { electricityGrowthLinks, recoveryGrowthLinks } from '../../data/traffic-growth-opportunities';
import { calculateElectricityBill as calculateExampleElectricityBill } from '../../lib/electricity-bill';

const pageTitle = '1 kWh เท่ากับกี่บาท 2569 | คำนวณค่าไฟ PEA/MEA + Ft';
const pageDescription = '1 kWh เท่ากับกี่บาท 2569 คำนวณค่าไฟ PEA/MEA ค่าไฟห้องเช่า ค่า Ft พฤษภาคม-สิงหาคม 2569 แยกค่าไฟฐาน Ft VAT เครื่องใช้ไฟฟ้า และยอดรวมทันที';
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://www.kamnuanlek.com').replace(/\/$/, '');
const canonical = `${siteUrl}/คำนวณค่าไฟฟ้า/`;
const electricityAffiliateUrl = '/go/roojai-partners/?sub_id=electricity-calculator';
const electricityRecoveryLinks = recoveryGrowthLinks.filter((link) => link.href !== '/คำนวณค่าไฟฟ้า/').slice(0, 5);
const electricityRateAnswerLinks = [
  { href: '/บทความ/อัตราค่าไฟฟ้า-pea-2569/', title: 'อัตราค่าไฟฟ้า PEA 2569', desc: 'ค่าไฟบ้านส่วนภูมิภาค + Ft' },
  { href: '/บทความ/อัตราค่าไฟฟ้า-mea-2569/', title: 'อัตราค่าไฟฟ้า MEA 2569', desc: 'กรุงเทพฯ นนทบุรี สมุทรปราการ' },
  { href: '/บทความ/อัตราค่าไฟฟ้า-mea-pea-2569/', title: 'อัตราค่าไฟฟ้า MEA PEA', desc: 'เลือกผู้ให้บริการให้ตรงบิล' },
  { href: '/บทความ/อัตราค่าไฟฟ้า-pea-บ้านอยู่อาศัย-2569/', title: 'PEA บ้านอยู่อาศัย', desc: 'บิลบ้านแบบขั้นบันได' },
  { href: '/บทความ/อัตราค่าไฟฟ้า-mea-บ้านอยู่อาศัย-2569/', title: 'MEA บ้านอยู่อาศัย', desc: 'บ้านและคอนโดในพื้นที่ MEA' },
];

const currentFtRate = '0.1623';
const previousFtRate = '0.0972';
const currentFtPeriod = 'พฤษภาคม-สิงหาคม 2569';
const ftLastVerified = '31 พฤษภาคม 2569';

const electricityModeCards = [
  {
    label: 'PEA บ้านทั่วไป',
    title: 'ต่างจังหวัดและพื้นที่ภูมิภาค',
    desc: 'เลือก PEA ถ้าชื่อการไฟฟ้าบนบิลคือการไฟฟ้าส่วนภูมิภาค เหมาะกับบ้านและคอนโดนอกพื้นที่ MEA',
  },
  {
    label: 'MEA บ้าน/คอนโด',
    title: 'กรุงเทพฯ นนทบุรี สมุทรปราการ',
    desc: 'เลือก MEA สำหรับบิลการไฟฟ้านครหลวง เพื่อให้บริบทพื้นที่ตรงกับคำค้น MEA 2569',
  },
  {
    label: 'ห้องเช่า',
    title: 'เช็กหน่วยมิเตอร์ก่อนจ่าย',
    desc: 'ใช้จำนวนหน่วยจริงจากมิเตอร์ห้อง แล้วเทียบกับบิลรวม/สัญญาเช่าเพื่อดูว่าราคาต่อหน่วยสมเหตุสมผลหรือไม่',
  },
  {
    label: 'ร้านเล็ก',
    title: 'กิจการขนาดเล็ก',
    desc: 'เหมาะกับร้านค้า สำนักงานย่อย และธุรกิจที่ต้องแยกค่าไฟฐาน ค่า Ft ค่าบริการ และ VAT ให้ชัด',
  },
];

const flagshipPresets = [
  {
    label: 'บ้านทั่วไป',
    units: '300',
    provider: 'pea',
    customerType: 'residential',
    note: 'ตัวอย่างที่คนค้นหาเยอะ',
  },
  {
    label: 'คอนโดในเมือง',
    units: '220',
    provider: 'mea',
    customerType: 'residential',
    note: 'เหมาะกับกรุงเทพฯ/นนท์/สมุทรปราการ',
  },
  {
    label: 'ห้องเช่า',
    units: '120',
    provider: 'pea',
    customerType: 'residential',
    note: 'เช็กหน่วยจากมิเตอร์ก่อนจ่าย',
  },
  {
    label: 'ร้านเล็ก',
    units: '650',
    provider: 'pea',
    customerType: 'small_business',
    note: 'สำหรับกิจการขนาดเล็ก',
  },
];

const exampleBills = [
  { label: 'ห้องพักเล็ก', units: 120, provider: 'pea', customerType: 'residential' },
  { label: 'บ้านทั่วไป', units: 300, provider: 'pea', customerType: 'residential' },
  { label: 'ใช้แอร์หลายห้อง', units: 500, provider: 'mea', customerType: 'residential' },
].map((example) => ({
  ...example,
  result: calculateExampleElectricityBill({
    units: example.units,
    provider: example.provider as 'pea' | 'mea',
    customerType: example.customerType as 'residential',
    ftRate: Number(currentFtRate),
  }),
}));

const applianceProfiles = [
  {
    label: 'แอร์ 12,000 BTU',
    detail: '1,050W x 8 ชม. x 30 วัน',
    watts: 1050,
    hoursPerDay: 8,
    daysPerMonth: 30,
    href: '/คำนวณความสิ้นเปลืองไฟฟ้า/',
  },
  {
    label: 'ตู้เย็น',
    detail: '150W x 12 ชม. x 30 วัน',
    watts: 150,
    hoursPerDay: 12,
    daysPerMonth: 30,
    href: '/คำนวณความสิ้นเปลืองไฟฟ้า/',
  },
  {
    label: 'เครื่องทำน้ำอุ่น',
    detail: '3,500W x 0.5 ชม. x 30 วัน',
    watts: 3500,
    hoursPerDay: 0.5,
    daysPerMonth: 30,
    href: '/คำนวณความจุเครื่องทำน้ำอุ่น/',
  },
  {
    label: 'ชาร์จรถไฟฟ้า',
    detail: '45 kWh/สัปดาห์ x 4 สัปดาห์',
    watts: 45000,
    hoursPerDay: 1,
    daysPerMonth: 4,
    href: '/คำนวณต้นทุนชาร์จรถไฟฟ้า/',
  },
].map((profile) => {
  const monthlyUnits = (profile.watts * profile.hoursPerDay * profile.daysPerMonth) / 1000;
  return {
    ...profile,
    monthlyUnits,
    result: calculateExampleElectricityBill({
      units: monthlyUnits,
      provider: 'pea',
      customerType: 'residential',
      ftRate: Number(currentFtRate),
    }),
  };
});

const faqData = [
  {
    question: '1 kWh เท่ากับกี่บาท 2569?',
    answer:
      'งวดพฤษภาคม-สิงหาคม 2569 ค่าไฟเฉลี่ยที่ประกาศอยู่ราว 3.95 บาทต่อหน่วยก่อน VAT แต่บิลจริงไม่ได้คิดแบบราคาเดียวทุกหน่วย เพราะบ้านอยู่อาศัยใช้โครงสร้างขั้นบันได บวกค่า Ft ค่าบริการ และ VAT ตามประเภทผู้ใช้ไฟ',
  },
  {
    question: 'ค่า Ft เดือนพฤษภาคม-สิงหาคม 2569 เท่าไร?',
    answer:
      'ค่า Ft สำหรับรอบพฤษภาคม-สิงหาคม 2569 คือ 16.23 สตางค์ต่อหน่วย หรือ 0.1623 บาทต่อ kWh เครื่องคำนวณนี้ตั้งค่าเริ่มต้นตามตัวเลขดังกล่าว และยังแก้เองได้หากบิลของคุณใช้รอบอื่น',
  },
  {
    question: 'ค่าไฟห้องเช่า หน่วยละกี่บาท 2569?',
    answer:
      'ให้เริ่มจากจำนวนหน่วย kWh ที่ใช้จริง แล้วคำนวณด้วยอัตรา PEA/MEA, ค่า Ft และค่าบริการตามประเภทมิเตอร์ ค่าเฉลี่ย 3.95 บาทต่อหน่วยใช้เป็นภาพรวมได้ แต่ค่าไฟห้องเช่าจริงควรอ้างอิงมิเตอร์และเงื่อนไขในสัญญาเช่า',
  },
  {
    question: 'PEA และ MEA ต่างกันอย่างไร?',
    answer:
      'MEA คือการไฟฟ้านครหลวงสำหรับกรุงเทพฯ นนทบุรี และสมุทรปราการ ส่วน PEA คือการไฟฟ้าส่วนภูมิภาคสำหรับจังหวัดอื่น เครื่องมือนี้ให้เลือกผู้ให้บริการเพื่อบันทึกผลและแสดงผลให้ตรงกับพื้นที่ใช้งาน',
  },
  {
    question: 'สูตรคำนวณค่าไฟฟ้าคิดอย่างไร?',
    answer:
      'สูตรย่อคือ ค่าไฟรวม = ค่าไฟฐานตามขั้นบันได + ค่า Ft + ค่าบริการ + VAT 7% โดยค่า Ft = จำนวนหน่วย kWh x อัตรา Ft และ VAT คิดจากยอดรวมก่อน VAT',
  },
  {
    question: 'ทำไมใช้ 300 หน่วยแล้วไม่ใช่ 300 x ราคาเดียว?',
    answer:
      'เพราะค่าไฟบ้านใช้ขั้นบันได หน่วยแรกคิดอีกอัตรา หน่วยถัดไปคิดอีกอัตรา เช่น 150 หน่วยแรกคิดตามเรตหนึ่ง และหน่วยที่เกิน 150 คิดตามเรตถัดไป จึงควรใช้เครื่องคำนวณแทนการคูณราคาเฉลี่ยอย่างเดียว',
  },
  {
    question: 'ต้องใส่ VAT 7% ทุกครั้งหรือไม่?',
    answer:
      'เครื่องมือนี้แสดง VAT 7% เพื่อให้เห็นโครงสร้างบิลครบถ้วนตามข้อมูลที่กรอก แต่บิลจริงอาจมีรายละเอียดเฉพาะตามประเภทผู้ใช้ไฟและประกาศของการไฟฟ้า ให้ตรวจเทียบกับใบแจ้งหนี้จริงเสมอ',
  },
  {
    question: 'เครื่องใช้ไฟฟ้าอะไรควรเช็กก่อนถ้าค่าไฟสูง?',
    answer:
      'ให้เริ่มจากแอร์ เครื่องทำน้ำอุ่น ตู้เย็น และการชาร์จรถไฟฟ้า เพราะเป็นกลุ่มที่ใช้ kWh สูง เครื่องมือนี้แสดงต้นทุนรายเครื่องคร่าว ๆ เพื่อให้รู้ว่าควรลดหรือแยกคำนวณตรงไหนก่อน',
  },
];

const jsonLdWebApp = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'เครื่องคำนวณค่าไฟฟ้า PEA/MEA 2569',
  description: pageDescription,
  url: canonical,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'All',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'THB' },
  inLanguage: 'th',
};

const jsonLdFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqData.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};

const jsonLdHowTo = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'วิธีคำนวณค่าไฟฟ้า PEA/MEA ปี 2569',
  description: 'ขั้นตอนคำนวณค่าไฟฟ้าจากจำนวนหน่วย kWh ค่า Ft ค่าบริการ และ VAT',
  inLanguage: 'th',
  totalTime: 'PT1M',
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'กรอกจำนวนหน่วยไฟฟ้า',
      text: 'ดูจำนวนหน่วยจากบิลหรือมิเตอร์ แล้วกรอกจำนวน kWh ที่ใช้ในรอบเดือน',
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'เลือก PEA หรือ MEA',
      text: 'เลือกการไฟฟ้าที่ออกบิลให้คุณเพื่อแยกผลลัพธ์ตามพื้นที่ใช้งาน',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'เลือกประเภทผู้ใช้ไฟ',
      text: 'เลือกบ้านอยู่อาศัยหรือกิจการขนาดเล็ก เพราะค่าบริการและรหัสอัตราต่างกัน',
    },
    {
      '@type': 'HowToStep',
      position: 4,
      name: 'ตรวจค่า Ft',
      text: `ค่า Ft เริ่มต้นของเครื่องมือคือ ${currentFtRate} บาทต่อหน่วยสำหรับรอบ ${currentFtPeriod} แต่สามารถแก้ตามบิลจริงได้`,
    },
    {
      '@type': 'HowToStep',
      position: 5,
      name: 'กดคำนวณ',
      text: 'ระบบจะแสดงค่าไฟฐาน ค่า Ft ค่าบริการ VAT และยอดรวม พร้อมตารางแยกตามขั้นบันได',
    },
  ],
};
---

<BaseLayout noGenericHowTo={true} title={pageTitle} description={pageDescription} canonical={canonical} pageName="คำนวณค่าไฟฟ้า">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdWebApp)} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdHowTo)} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />

  <article class="electricity-flagship-page">
    <div class="electricity-update-strip">
      <p>ค่า Ft รอบ {currentFtPeriod}</p>
      <strong>{currentFtRate} บาท/หน่วย</strong>
      <span>ตรวจบิล PEA/MEA พร้อม VAT 7% และขั้นบันได</span>
    </div>

    <h1 class="electricity-hero-title">
      1 kWh เท่ากับกี่บาท 2569? คำนวณค่าไฟฟ้า PEA/MEA + Ft
    </h1>

    <p class="electricity-hero-copy">
      ใส่จำนวนหน่วยไฟฟ้า เลือก PEA หรือ MEA แล้วดูค่าไฟฐาน ค่า Ft ค่าบริการ VAT 7%
      และยอดรวมแบบแยกขั้นบันได เหมาะสำหรับเช็กบิลบ้าน ห้องเช่า คอนโด และกิจการขนาดเล็ก
    </p>

    <section class="electricity-direct-answer" aria-label="คำตอบเร็ว 1 kWh เท่ากับกี่บาท">
      <div>
        <span>คำตอบตรง</span>
        <h2>1 kWh หรือ 1 หน่วยไฟ ประเมินเร็วประมาณ 3.95 บาทก่อน VAT</h2>
        <p>
          รอบ {currentFtPeriod} ค่า Ft เริ่มต้น {currentFtRate} บาท/หน่วย แต่บิลจริงต้องคิดค่าไฟฐานแบบขั้นบันได
          ค่าบริการ และ VAT 7% จึงควรกรอกจำนวนหน่วยจริงเพื่อดูยอดที่ใกล้บิลมากกว่า
        </p>
      </div>
      <a href="/บทความ/1-kwh-เท่ากับกี่บาท-2569/">อ่านรายละเอียด 1 kWh</a>
    </section>

    <section class="electricity-rate-links" aria-label="อัตราค่าไฟฟ้า PEA MEA 2569">
      <div class="electricity-rate-links-heading">
        <span>คำค้นใกล้หน้าแรก</span>
        <h2>อัตราค่าไฟฟ้า PEA/MEA ที่คนค้นหาอยู่ตอนนี้</h2>
      </div>
      <div>
        {
          electricityRateAnswerLinks.map((link) => (
            <a href={link.href}>
              <strong>{link.title}</strong>
              <small>{link.desc}</small>
            </a>
          ))
        }
      </div>
    </section>

    <section class="electricity-mode-grid" aria-label="โหมดคำนวณค่าไฟฟ้า PEA MEA ห้องเช่า และร้านค้า">
      {
        electricityModeCards.map((mode) => (
          <div class="electricity-mode-card">
            <span>{mode.label}</span>
            <strong>{mode.title}</strong>
            <p>{mode.desc}</p>
          </div>
        ))
      }
    </section>

    <div class="electricity-quick-grid" aria-label="ข้อมูลสำคัญก่อนคำนวณ">
      <div>
        <span>คำตอบเร็ว</span>
        <strong>1 kWh = 1 หน่วยไฟ</strong>
        <p>แต่ยอดจริงต้องคิดขั้นบันได ค่า Ft และค่าบริการ</p>
      </div>
      <div>
        <span>เหมาะกับ</span>
        <strong>บ้าน คอนโด ห้องเช่า ร้านเล็ก</strong>
        <p>เลือกประเภทผู้ใช้ไฟเพื่อให้ค่าบริการตรงขึ้น</p>
      </div>
      <div>
        <span>อัปเดต</span>
        <strong>Ft {currentFtPeriod}</strong>
        <p>แก้ค่า Ft เองได้ถ้าบิลอยู่คนละรอบ</p>
      </div>
    </div>

    <div class="electricity-calculator-panel">
      <div class="electricity-panel-heading">
        <div>
          <p>เริ่มจากตัวอย่างยอดนิยม</p>
          <h2>แตะครั้งเดียวแล้วคำนวณทันที</h2>
        </div>
        <span>ฟรี 100%</span>
      </div>

      <div class="electricity-presets" aria-label="ตัวอย่างค่าไฟที่ใช้บ่อย">
        {
          flagshipPresets.map((preset) => (
            <button
              type="button"
              data-electricity-preset
              data-units={preset.units}
              data-provider={preset.provider}
              data-customer-type={preset.customerType}
              data-ft-rate={currentFtRate}
            >
              <strong>{preset.label}</strong>
              <span>{preset.units} หน่วย</span>
              <small>{preset.note}</small>
            </button>
          ))
        }
      </div>

      <form id="electricity-form" class="space-y-5">
        <p id="electricity-form-error" class="hidden rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm font-medium text-red-700">
