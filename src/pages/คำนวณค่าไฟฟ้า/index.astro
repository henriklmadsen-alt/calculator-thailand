              <option value="pea" selected>PEA - การไฟฟ้าส่วนภูมิภาค</option>
            </select>
            <p id="provider-error" class="mt-1 hidden text-sm text-red-600"></p>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
