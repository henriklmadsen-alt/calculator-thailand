---
import RelatedCalculators from '../../components/templates/RelatedCalculators.astro';
import RelatedArticles from '../../components/templates/RelatedArticles.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuardedAdSlot from '../../components/templates/GuardedAdSlot.astro';
import FAQAccordion from '../../components/templates/FAQAccordion.astro';

const pageTitle = 'คำนวณค่าไฟฟ้า 2569 | 1 kWh เท่ากับกี่บาท PEA/MEA + Ft';
const pageDescription = 'คำนวณค่าไฟฟ้า 2569 สำหรับ PEA/MEA ใส่จำนวนหน่วย kWh ค่า Ft และประเภทผู้ใช้ไฟ เพื่อดูค่าไฟฐาน ค่า Ft ค่าบริการ VAT 7% และยอดรวมทันที';
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://www.kamnuanlek.com').replace(/\/$/, '');
const canonical = `${siteUrl}/คำนวณค่าไฟฟ้า/`;

const currentFtRate = '0.1623';
const previousFtRate = '0.0972';
const currentFtPeriod = 'พฤษภาคม-สิงหาคม 2569';

const faqData = [
  {
    question: '1 kWh เท่ากับกี่บาท 2569?',
    answer:
      'งวดพฤษภาคม-สิงหาคม 2569 ค่าไฟเฉลี่ยที่ประกาศอยู่ราว 3.95 บาทต่อหน่วยก่อน VAT แต่บิลจริงไม่ได้คิดแบบราคาเดียวทุกหน่วย เพราะบ้านอยู่อาศัยใช้โครงสร้างขั้นบันได บวกค่า Ft ค่าบริการ และ VAT ตามประเภทผู้ใช้ไฟ',
  },
  {
    question: 'ค่า Ft เดือนพฤษภาคม-สิงหาคม 2569 เท่าไร?',
    answer:
      'ค่า Ft สำหรับรอบพฤษภาคม-สิงหาคม 2569 คือ 16.23 สตางค์ต่อหน่วย หรือ 0.1623 บาทต่อ kWh เครื่องคำนวณนี้ตั้งค่าเริ่มต้นตามตัวเลขดังกล่าว และยังแก้เองได้หากบิลของคุณใช้รอบอื่น',
  },
  {
    question: 'ค่าไฟห้องเช่า หน่วยละกี่บาท 2569?',
    answer:
      'ให้เริ่มจากจำนวนหน่วย kWh ที่ใช้จริง แล้วคำนวณด้วยอัตรา PEA/MEA, ค่า Ft และค่าบริการตามประเภทมิเตอร์ ค่าเฉลี่ย 3.95 บาทต่อหน่วยใช้เป็นภาพรวมได้ แต่ค่าไฟห้องเช่าจริงควรอ้างอิงมิเตอร์และเงื่อนไขในสัญญาเช่า',
  },
  {
    question: 'PEA และ MEA ต่างกันอย่างไร?',
    answer:
      'MEA คือการไฟฟ้านครหลวงสำหรับกรุงเทพฯ นนทบุรี และสมุทรปราการ ส่วน PEA คือการไฟฟ้าส่วนภูมิภาคสำหรับจังหวัดอื่น เครื่องมือนี้ให้เลือกผู้ให้บริการเพื่อบันทึกผลและแสดงผลให้ตรงกับพื้นที่ใช้งาน',
  },
  {
    question: 'สูตรคำนวณค่าไฟฟ้าคิดอย่างไร?',
    answer:
      'สูตรย่อคือ ค่าไฟรวม = ค่าไฟฐานตามขั้นบันได + ค่า Ft + ค่าบริการ + VAT 7% โดยค่า Ft = จำนวนหน่วย kWh x อัตรา Ft และ VAT คิดจากยอดรวมก่อน VAT',
  },
  {
    question: 'ทำไมใช้ 300 หน่วยแล้วไม่ใช่ 300 x ราคาเดียว?',
    answer:
      'เพราะค่าไฟบ้านใช้ขั้นบันได หน่วยแรกคิดอีกอัตรา หน่วยถัดไปคิดอีกอัตรา เช่น 150 หน่วยแรกคิดตามเรตหนึ่ง และหน่วยที่เกิน 150 คิดตามเรตถัดไป จึงควรใช้เครื่องคำนวณแทนการคูณราคาเฉลี่ยอย่างเดียว',
  },
  {
    question: 'ต้องใส่ VAT 7% ทุกครั้งหรือไม่?',
    answer:
      'เครื่องมือนี้แสดง VAT 7% เพื่อให้เห็นโครงสร้างบิลครบถ้วนตามข้อมูลที่กรอก แต่บิลจริงอาจมีรายละเอียดเฉพาะตามประเภทผู้ใช้ไฟและประกาศของการไฟฟ้า ให้ตรวจเทียบกับใบแจ้งหนี้จริงเสมอ',
  },
];

const jsonLdWebApp = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'เครื่องคำนวณค่าไฟฟ้า PEA/MEA 2569',
  description: pageDescription,
  url: canonical,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'All',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'THB' },
  inLanguage: 'th',
};

const jsonLdFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqData.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};

const jsonLdHowTo = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'วิธีคำนวณค่าไฟฟ้า PEA/MEA ปี 2569',
  description: 'ขั้นตอนคำนวณค่าไฟฟ้าจากจำนวนหน่วย kWh ค่า Ft ค่าบริการ และ VAT',
  inLanguage: 'th',
  totalTime: 'PT1M',
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'กรอกจำนวนหน่วยไฟฟ้า',
      text: 'ดูจำนวนหน่วยจากบิลหรือมิเตอร์ แล้วกรอกจำนวน kWh ที่ใช้ในรอบเดือน',
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'เลือก PEA หรือ MEA',
      text: 'เลือกการไฟฟ้าที่ออกบิลให้คุณเพื่อแยกผลลัพธ์ตามพื้นที่ใช้งาน',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'เลือกประเภทผู้ใช้ไฟ',
      text: 'เลือกบ้านอยู่อาศัยหรือกิจการขนาดเล็ก เพราะค่าบริการและรหัสอัตราต่างกัน',
    },
    {
      '@type': 'HowToStep',
      position: 4,
      name: 'ตรวจค่า Ft',
      text: `ค่า Ft เริ่มต้นของเครื่องมือคือ ${currentFtRate} บาทต่อหน่วยสำหรับรอบ ${currentFtPeriod} แต่สามารถแก้ตามบิลจริงได้`,
    },
    {
      '@type': 'HowToStep',
      position: 5,
      name: 'กดคำนวณ',
      text: 'ระบบจะแสดงค่าไฟฐาน ค่า Ft ค่าบริการ VAT และยอดรวม พร้อมตารางแยกตามขั้นบันได',
    },
  ],
};
---

<BaseLayout noGenericHowTo={true} title={pageTitle} description={pageDescription} canonical={canonical} pageName="คำนวณค่าไฟฟ้า">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdWebApp)} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdHowTo)} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />

  <article>
    <div class="mb-4 rounded-xl border border-sky-100 bg-sky-50 p-4">
      <p class="text-sm font-semibold text-sky-700">อัปเดตค่า Ft รอบ {currentFtPeriod}</p>
      <p class="mt-1 text-sm text-slate-700">ค่า Ft เริ่มต้น {currentFtRate} บาท/หน่วย จากรอบประกาศล่าสุดที่ใช้กับเดือนพฤษภาคม-สิงหาคม 2569</p>
      <p class="mt-1 text-xs font-medium text-sky-800">ใช้เพื่อประมาณค่าไฟและตรวจบิลเบื้องต้น โปรดเทียบกับใบแจ้งหนี้จริงจาก PEA/MEA</p>
    </div>

    <h1 class="mb-4 text-2xl font-bold text-gray-900 sm:text-3xl">
      คำนวณค่าไฟฟ้า 2569: 1 kWh เท่ากับกี่บาท PEA/MEA + Ft
    </h1>

    <p class="mb-6 text-gray-600">
      ใส่จำนวนหน่วยไฟฟ้า เลือก PEA หรือ MEA แล้วดูค่าไฟฐาน ค่า Ft ค่าบริการ VAT 7%
      และยอดรวมแบบแยกขั้นบันได เหมาะสำหรับเช็กบิลบ้าน ห้องเช่า คอนโด และกิจการขนาดเล็ก
    </p>

    <section class="mb-6 grid gap-3 sm:grid-cols-3" aria-label="คำตอบเร็วเกี่ยวกับค่าไฟฟ้า">
      <div class="rounded-xl border border-emerald-100 bg-emerald-50 p-4">
        <p class="text-xs font-bold uppercase tracking-wide text-emerald-700">คำตอบเร็ว</p>
        <h2 class="mt-1 text-base font-bold text-emerald-950">1 kWh เท่ากับกี่บาท 2569?</h2>
        <p class="mt-2 text-sm text-emerald-900">
          ค่าไฟเฉลี่ยรอบ {currentFtPeriod} อยู่ราว 3.95 บาท/หน่วยก่อน VAT แต่บิลจริงขึ้นกับขั้นบันไดและประเภทมิเตอร์
        </p>
      </div>
      <div class="rounded-xl border border-blue-100 bg-blue-50 p-4">
        <p class="text-xs font-bold uppercase tracking-wide text-blue-700">Ft ล่าสุด</p>
        <h2 class="mt-1 text-base font-bold text-blue-950">ค่า Ft {currentFtPeriod}</h2>
        <p class="mt-2 text-sm text-blue-900">
          ค่าเริ่มต้น {currentFtRate} บาท/หน่วย ก่อนหน้านี้รอบมกราคม-เมษายน 2569 ใช้ {previousFtRate} บาท/หน่วย
        </p>
      </div>
      <div class="rounded-xl border border-amber-100 bg-amber-50 p-4">
        <p class="text-xs font-bold uppercase tracking-wide text-amber-700">ห้องเช่า</p>
        <h2 class="mt-1 text-base font-bold text-amber-950">ค่าไฟห้องเช่าคิดอย่างไร?</h2>
        <p class="mt-2 text-sm text-amber-900">
          ใช้หน่วยจากมิเตอร์จริง x โครงสร้างค่าไฟ แล้วตรวจค่า Ft/ค่าบริการ ไม่ควรดูแค่ราคาเฉลี่ยต่อหน่วย
        </p>
      </div>
    </section>

    <section id="electricity-intent-cluster" class="mb-6 rounded-xl border border-gray-200 bg-white p-4 shadow-sm sm:p-5">
      <h2 class="text-base font-bold text-gray-900 sm:text-lg">เครื่องมือนี้ตอบคำค้นที่คนไทยใช้บ่อย</h2>
      <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-gray-700">
        <li>1 kWh เท่ากับกี่บาท 2569</li>
        <li>ค่าไฟห้องเช่า หน่วยละกี่บาท 2569</li>
        <li>คำนวณค่าไฟ PEA และ MEA จากจำนวนหน่วย</li>
        <li>ค่า Ft ล่าสุดต้องบวกในบิลเท่าไร</li>
      </ul>
      <div class="mt-4 flex flex-col gap-2 text-sm">
        <a
          href="/บทความ/คำนวณค่าไฟฟ้า-2569-สูตร-pea-mea/"
          class="font-medium text-primary-700 underline decoration-primary-300 underline-offset-2 hover:text-primary-800"
          >อ่านวิธีคำนวณค่าไฟฟ้า 2569 แบบละเอียด</a
        >
        <a
          href="/คำนวณภาษีมูลค่าเพิ่ม/"
          class="font-medium text-primary-700 underline decoration-primary-300 underline-offset-2 hover:text-primary-800"
          >ใช้เครื่องคำนวณ VAT 7% เพิ่มเติม</a
        >
      </div>
    </section>

    <div class="mb-8 rounded-lg border border-gray-200 bg-white p-4 shadow-sm sm:p-6">
      <form id="electricity-form" class="space-y-5">
        <p id="electricity-form-error" class="hidden rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm font-medium text-red-700">
          กรุณากรอกข้อมูลให้ครบและถูกต้องก่อนคำนวณ
        </p>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="units" class="mb-1 block text-sm font-medium text-gray-700">จำนวนหน่วยไฟฟ้า (kWh/เดือน)</label>
            <input
              type="text"
              id="units"
              inputmode="numeric"
              placeholder="เช่น 250"
              class="w-full rounded-md border border-gray-300 px-3 py-2 text-base focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500"
            />
            <p id="units-error" class="mt-1 hidden text-sm text-red-600"></p>
          </div>

          <div>
            <label for="provider" class="mb-1 block text-sm font-medium text-gray-700">การไฟฟ้าที่ออกบิล</label>
            <select
              id="provider"
              class="w-full rounded-md border border-gray-300 px-3 py-2 text-base focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500"
            >
              <option value="">เลือกการไฟฟ้า</option>
              <option value="mea">MEA - การไฟฟ้านครหลวง</option>
              <option value="pea">PEA - การไฟฟ้าส่วนภูมิภาค</option>
            </select>
            <p id="provider-error" class="mt-1 hidden text-sm text-red-600"></p>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="customer-type" class="mb-1 block text-sm font-medium text-gray-700">ประเภทผู้ใช้ไฟ</label>
            <select
              id="customer-type"
              class="w-full rounded-md border border-gray-300 px-3 py-2 text-base focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500"
            >
              <option value="">เลือกประเภทผู้ใช้ไฟ</option>
              <option value="residential">บ้านอยู่อาศัย</option>
              <option value="small_business">กิจการขนาดเล็ก</option>
            </select>
            <p id="customer-type-error" class="mt-1 hidden text-sm text-red-600"></p>
          </div>

          <div>
            <label for="ft-rate" class="mb-1 block text-sm font-medium text-gray-700">ค่า Ft (บาท/หน่วย)</label>
            <input
              type="text"
              id="ft-rate"
              inputmode="decimal"
              placeholder={`ค่าเริ่มต้น ${currentFtRate}`}
              class="w-full rounded-md border border-gray-300 px-3 py-2 text-base focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500"
            />
            <p class="mt-1 text-xs text-gray-500">ปล่อยว่างเพื่อใช้ค่า Ft {currentFtRate} บาท/หน่วย สำหรับรอบ {currentFtPeriod}</p>
            <p id="ft-rate-error" class="mt-1 hidden text-sm text-red-600"></p>
          </div>
        </div>

        <button
          type="submit"
          id="electricity-submit-btn"
          class="w-full rounded-md bg-primary-600 px-8 py-3 text-base font-semibold text-white transition-colors hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 sm:w-auto"
        >
          คำนวณค่าไฟฟ้า
        </button>
      </form>
    </div>

    <div id="results" class="mb-8 hidden">
      <div class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm sm:p-6">
        <h2 class="mb-4 text-lg font-semibold text-gray-900">ผลคำนวณค่าไฟฟ้าโดยประมาณ</h2>

        <div class="mb-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
          <div class="rounded-lg bg-primary-50 p-4 text-center">
            <div class="mb-1 text-sm text-gray-600">ค่าไฟฐาน</div>
            <div id="res-energy-charge" class="text-lg font-bold text-primary-700">-</div>
          </div>
          <div class="rounded-lg bg-sky-50 p-4 text-center">
            <div class="mb-1 text-sm text-gray-600">ค่า Ft</div>
            <div id="res-ft-charge" class="text-lg font-bold text-sky-700">-</div>
          </div>
          <div class="rounded-lg bg-amber-50 p-4 text-center">
            <div class="mb-1 text-sm text-gray-600">ค่าบริการ</div>
            <div id="res-service-charge" class="text-lg font-bold text-amber-700">-</div>
          </div>
          <div class="rounded-lg bg-purple-50 p-4 text-center">
            <div class="mb-1 text-sm text-gray-600">VAT 7%</div>
            <div id="res-vat" class="text-lg font-bold text-purple-700">-</div>
          </div>
          <div class="rounded-lg bg-red-50 p-4 text-center">
            <div class="mb-1 text-sm text-gray-600">ยอดรวม</div>
            <div id="res-total" class="text-lg font-bold text-red-600">-</div>
          </div>
        </div>

        <div class="mb-6 space-y-2 text-sm">
          <div class="flex justify-between border-b border-gray-100 py-1">
            <span class="text-gray-600">การไฟฟ้า</span>
            <span id="res-provider" class="font-medium text-gray-900">-</span>
          </div>
          <div class="flex justify-between border-b border-gray-100 py-1">
            <span class="text-gray-600">ประเภทผู้ใช้ไฟ</span>
            <span id="res-customer-type" class="font-medium text-gray-900">-</span>
          </div>
          <div class="flex justify-between border-b border-gray-100 py-1">
            <span class="text-gray-600">รหัสอัตรา</span>
            <span id="res-tariff-code" class="font-medium text-gray-900">-</span>
          </div>
          <div class="flex justify-between border-b border-gray-100 py-1">
            <span class="text-gray-600">จำนวนหน่วย</span>
            <span id="res-units" class="font-medium text-gray-900">-</span>
          </div>
          <div class="flex justify-between border-b border-gray-100 py-1">
            <span class="text-gray-600">ค่า Ft ที่ใช้</span>
            <span id="res-ft-rate" class="font-medium text-gray-900">-</span>
          </div>
          <div class="flex justify-between border-b border-gray-100 py-1">
            <span class="text-gray-600">ยอดก่อน VAT</span>
            <span id="res-subtotal" class="font-medium text-gray-900">-</span>
          </div>
        </div>

        <h3 class="mb-2 text-base font-semibold text-gray-900">ตารางค่าไฟฐานตามขั้นบันได</h3>
        <div class="overflow-x-auto rounded-md border border-gray-200">
          <table class="min-w-full text-sm">
            <thead class="bg-gray-50 text-gray-700">
              <tr>
                <th class="px-3 py-2 text-left font-medium">ช่วงหน่วย</th>
                <th class="px-3 py-2 text-right font-medium">หน่วยที่คิด</th>
                <th class="px-3 py-2 text-right font-medium">อัตรา (บาท/หน่วย)</th>
                <th class="px-3 py-2 text-right font-medium">จำนวนเงิน</th>
              </tr>
            </thead>
            <tbody id="tier-breakdown-body" class="divide-y divide-gray-100 bg-white"></tbody>
          </table>
        </div>

        <p id="result-note" class="mt-4 rounded-md bg-sky-50 px-3 py-2 text-xs text-sky-800"></p>
      </div>
    </div>

    <GuardedAdSlot templateType="calculator" slotId="C1" revealAfterSelector="#results" />

    <section class="prose prose-slate mb-8 max-w-none rounded-lg border border-gray-200 bg-white p-4 shadow-sm sm:p-6">
      <h2>สูตรคำนวณค่าไฟฟ้า PEA/MEA</h2>
      <p><strong>ค่าไฟรวม = ค่าไฟฐาน + ค่า Ft + ค่าบริการ + VAT 7%</strong></p>
      <ul>
        <li>ค่าไฟฐาน = คำนวณตามขั้นบันไดของประเภทผู้ใช้ไฟ</li>
        <li>ค่า Ft = จำนวนหน่วย kWh x ค่า Ft ต่อหน่วย</li>
        <li>ยอดก่อน VAT = ค่าไฟฐาน + ค่า Ft + ค่าบริการ</li>
        <li>VAT = ยอดก่อน VAT x 7%</li>
        <li>ยอดรวม = ยอดก่อน VAT + VAT</li>
      </ul>
      <p>
        จุดที่ทำให้คนคำนวณผิดบ่อยคือการเอาจำนวนหน่วยไปคูณด้วยราคาเฉลี่ยราคาเดียว
        ทั้งที่ค่าไฟบ้านใช้ขั้นบันได และยังมีค่า Ft กับค่าบริการเพิ่มเข้ามาอีก
      </p>
    </section>

    <GuardedAdSlot templateType="calculator" slotId="C2" revealAfterSelector="#results" />

    <section class="mb-8 rounded-xl border border-primary-200 bg-primary-50 p-4 sm:p-5">
      <h2 class="text-base font-semibold text-primary-900">ตัวอย่างคำตอบสำหรับ SEO ที่คนค้นหาบ่อย</h2>
      <div class="mt-3 grid gap-3 md:grid-cols-2">
        <div class="rounded-lg bg-white p-4 text-sm text-gray-700">
          <h3 class="font-semibold text-gray-900">1 kWh เท่ากับกี่บาท?</h3>
          <p class="mt-1">
            ถ้าดูค่าเฉลี่ยรอบ {currentFtPeriod} จะอยู่ประมาณ 3.95 บาทต่อหน่วยก่อน VAT
            แต่ถ้าต้องการเลขบิลจริงให้ใส่จำนวนหน่วยในเครื่องมือนี้ เพราะแต่ละช่วงหน่วยคิดราคาไม่เท่ากัน
          </p>
        </div>
        <div class="rounded-lg bg-white p-4 text-sm text-gray-700">
          <h3 class="font-semibold text-gray-900">ค่าไฟห้องเช่าหน่วยละกี่บาท?</h3>
          <p class="mt-1">
            ให้ดูเลขมิเตอร์ต้นงวดและปลายงวดก่อน แล้วคำนวณจากจำนวนหน่วยจริง
            ค่าเฉลี่ยช่วยประเมินได้ แต่เงื่อนไขสัญญาเช่าและมิเตอร์รวมอาจทำให้บิลต่างจากบ้านทั่วไป
          </p>
        </div>
      </div>
    </section>

    <section class="prose prose-gray mb-8 max-w-none">
      <h2>ข้อผิดพลาดที่พบบ่อยเวลาคำนวณค่าไฟ</h2>
      <ul>
        <li><strong>ลืมค่า Ft:</strong> ค่า Ft เปลี่ยนเป็นรอบ ๆ และกระทบยอดรวมทันที</li>
        <li><strong>ใช้ราคาเฉลี่ยคูณทุกหน่วย:</strong> ค่าไฟบ้านเป็นขั้นบันได ไม่ใช่ราคาเดียวทั้งบิล</li>
        <li><strong>อ่านมิเตอร์ผิด:</strong> ต้องใช้เลขปลายงวดลบเลขต้นงวดเพื่อหา kWh จริง</li>
        <li><strong>ไม่แยกบ้านกับกิจการ:</strong> ประเภทผู้ใช้ไฟทำให้ค่าบริการและรหัสอัตราต่างกัน</li>
        <li><strong>ไม่เทียบกับบิลจริง:</strong> เครื่องมือนี้ช่วยประมาณและตรวจบิล แต่ประกาศจริงของการไฟฟ้าเป็นแหล่งอ้างอิงสุดท้าย</li>
      </ul>
    </section>

    <FAQAccordion faqData={faqData} title="คำถามที่พบบ่อยเกี่ยวกับค่าไฟฟ้า" />

    <section class="mb-8 rounded-lg border border-gray-200 bg-white p-4 text-sm text-gray-700 shadow-sm sm:p-6">
      <h2 class="mb-2 text-base font-semibold text-gray-900">แหล่งข้อมูลทางการ</h2>
      <ul class="list-disc space-y-1 pl-5">
        <li><a href="https://www.erc.or.th/th/automatic" target="_blank" rel="noopener noreferrer">กกพ.: อัตราค่าไฟฟ้าโดยอัตโนมัติ (Ft)</a></li>
        <li><a href="https://www.pea.co.th/our-services/tariff/ft" target="_blank" rel="noopener noreferrer">PEA: ค่า Ft และประกาศที่เกี่ยวข้อง</a></li>
        <li><a href="https://www.pea.co.th/our-services/tariff/ft-statistics" target="_blank" rel="noopener noreferrer">PEA: สถิติค่า Ft รายเดือน</a></li>
      </ul>
    </section>

    <RelatedArticles currentHref="/คำนวณค่าไฟฟ้า/" />
    <RelatedCalculators currentHref="/คำนวณค่าไฟฟ้า/" />

    <div class="rounded-lg border border-yellow-200 bg-yellow-50 p-4 text-sm text-yellow-800">
      <strong>หมายเหตุ:</strong> ผลลัพธ์เป็นการประมาณจากข้อมูลที่กรอกและตารางอัตราในระบบ
      โปรดตรวจเทียบกับบิลจริงและประกาศล่าสุดของ PEA, MEA หรือ กกพ. ก่อนใช้ตัดสินใจทางการเงิน
    </div>
  </article>

  <script>
    import { calculateElectricityBill, DEFAULT_ELECTRICITY_FT_RATE } from '../../lib/electricity-bill';

    function parseNum(value) {
      const normalized = String(value).replace(/,/g, '').trim();
      if (normalized === '') return NaN;
      const n = Number(normalized);
      return Number.isFinite(n) ? n : NaN;
    }

    function fmtMoney(amount) {
      return `${new Intl.NumberFormat('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(amount)} บาท`;
    }

    function fmtUnits(units) {
      return `${new Intl.NumberFormat('th-TH', { maximumFractionDigits: 2 }).format(units)} หน่วย`;
    }

    function fmtRate(rate) {
      return `${new Intl.NumberFormat('th-TH', { minimumFractionDigits: 4, maximumFractionDigits: 4 }).format(rate)} บาท/หน่วย`;
    }

    const form = document.getElementById('electricity-form');
    const submitBtn = document.getElementById('electricity-submit-btn');
    const formError = document.getElementById('electricity-form-error');
    const resultsDiv = document.getElementById('results');
    const breakdownBody = document.getElementById('tier-breakdown-body');

    const fields = {
      units: document.getElementById('units'),
      provider: document.getElementById('provider'),
      customerType: document.getElementById('customer-type'),
      ftRate: document.getElementById('ft-rate'),
    };

    function setFieldError(id, message) {
      const element = document.getElementById(id);
      if (!element) return;
      element.textContent = message;
      element.classList.remove('hidden');
    }

    function clearFieldError(id) {
      const element = document.getElementById(id);
      if (!element) return;
      element.textContent = '';
      element.classList.add('hidden');
    }

    function clearValidation() {
      formError.classList.add('hidden');
      clearFieldError('units-error');
      clearFieldError('provider-error');
      clearFieldError('customer-type-error');
      clearFieldError('ft-rate-error');
    }

    function updateSubmitState() {
      const requiredFilled = [
        fields.units.value,
        fields.provider.value,
        fields.customerType.value,
      ].every((value) => String(value).trim() !== '');

      const unitsValue = parseNum(fields.units.value);
      const ftInput = String(fields.ftRate.value).trim();
      const ftValue = ftInput === '' ? DEFAULT_ELECTRICITY_FT_RATE : parseNum(ftInput);

      const hasInvalidRequired = !Number.isFinite(unitsValue) || unitsValue <= 0;
      const hasInvalidFt = !Number.isFinite(ftValue) || ftValue < 0;

      const ready = requiredFilled && !hasInvalidRequired && !hasInvalidFt;
      submitBtn.disabled = !ready;
      submitBtn.textContent = ready ? 'คำนวณเลย' : 'กรอกข้อมูลให้ครบ';
      submitBtn.classList.toggle('cursor-not-allowed', !ready);
      submitBtn.classList.toggle('opacity-70', !ready);
    }

    Object.values(fields).forEach((field) => {
      field.addEventListener('input', () => {
        clearValidation();
        updateSubmitState();
      });
      field.addEventListener('change', () => {
        clearValidation();
        updateSubmitState();
      });
    });

    function setText(id, value) {
      const element = document.getElementById(id);
      if (element) element.textContent = value;
    }

    updateSubmitState();

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      clearValidation();

      const units = parseNum(fields.units.value);
      const provider = String(fields.provider.value || '');
      const customerType = String(fields.customerType.value || '');
      const ftInput = String(fields.ftRate.value).trim();
      const ftRate = ftInput === '' ? DEFAULT_ELECTRICITY_FT_RATE : parseNum(ftInput);

      const validity = {
        units: Number.isFinite(units) && units > 0,
        provider: provider === 'mea' || provider === 'pea',
        customerType: customerType === 'residential' || customerType === 'small_business',
        ftRate: Number.isFinite(ftRate) && ftRate >= 0,
      };

      if (!validity.units) setFieldError('units-error', 'กรุณากรอกจำนวนหน่วยมากกว่า 0');
      if (!validity.provider) setFieldError('provider-error', 'กรุณาเลือกการไฟฟ้า');
      if (!validity.customerType) setFieldError('customer-type-error', 'กรุณาเลือกประเภทผู้ใช้ไฟ');
      if (!validity.ftRate) setFieldError('ft-rate-error', 'ค่า Ft ต้องเป็นตัวเลขตั้งแต่ 0 ขึ้นไป');

      if (!Object.values(validity).every(Boolean)) {
        formError.classList.remove('hidden');
        updateSubmitState();
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'กำลังคำนวณ...';
      trackCalculatorStart('electricity_bill');

      const result = calculateElectricityBill({
        units,
        provider,
        customerType,
        ftRate,
      });

      setText('res-energy-charge', fmtMoney(result.energyCharge));
      setText('res-ft-charge', fmtMoney(result.ftCharge));
      setText('res-service-charge', fmtMoney(result.serviceCharge));
      setText('res-vat', fmtMoney(result.vatAmount));
      setText('res-total', fmtMoney(result.totalBill));

      setText('res-provider', result.provider === 'mea' ? 'MEA - การไฟฟ้านครหลวง' : 'PEA - การไฟฟ้าส่วนภูมิภาค');
      setText('res-customer-type', result.customerType === 'residential' ? 'บ้านอยู่อาศัย' : 'กิจการขนาดเล็ก');
      setText('res-tariff-code', result.tariffCode);
      setText('res-units', fmtUnits(result.units));
      setText('res-ft-rate', fmtRate(result.appliedFtRate));
      setText('res-subtotal', fmtMoney(result.subtotalBeforeVat));

      breakdownBody.innerHTML = '';
      result.tierBreakdown.forEach((tier) => {
        const row = document.createElement('tr');
        row.innerHTML = `
          <td class="px-3 py-2 text-gray-700">${tier.label}</td>
          <td class="px-3 py-2 text-right text-gray-700">${new Intl.NumberFormat('th-TH', { maximumFractionDigits: 2 }).format(tier.units)}</td>
          <td class="px-3 py-2 text-right text-gray-700">${new Intl.NumberFormat('th-TH', { minimumFractionDigits: 4, maximumFractionDigits: 4 }).format(tier.rate)}</td>
          <td class="px-3 py-2 text-right font-medium text-gray-900">${new Intl.NumberFormat('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(tier.amount)}</td>
        `;
        breakdownBody.appendChild(row);
      });

      const noteParts = [
        `รหัสอัตรา ${result.tariffCode}`,
        `ค่า Ft ที่ใช้ ${new Intl.NumberFormat('th-TH', { minimumFractionDigits: 4, maximumFractionDigits: 4 }).format(result.appliedFtRate)} บาท/หน่วย`,
        'ผลลัพธ์เป็นค่าประมาณ โปรดตรวจเทียบกับบิลจริงจาก PEA/MEA',
      ];
      setText('result-note', noteParts.join(' | '));

      resultsDiv.classList.remove('hidden');
      resultsDiv.scrollIntoView({ behavior: 'smooth', block: 'start' });

      submitBtn.disabled = false;
      submitBtn.textContent = 'คำนวณเลย';
      trackCalculatorComplete('electricity_bill', result.totalBill);
      trackCalculatorUsed('electricity_bill');
    });

    const resultObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          trackResultViewed('electricity_bill');
          resultObserver.disconnect();
        }
      });
    }, { threshold: 0.5 });
    resultObserver.observe(resultsDiv);
  </script>
</BaseLayout>
