    .electricity-appliance-heading p {
      color: var(--electricity-muted);
      font-size: 0.94rem;
      line-height: 1.7;
      margin: 0.45rem 0 0;
    }

    .electricity-appliance-grid {
      display: grid;
      gap: 0.75rem;
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .electricity-appliance-grid a {
      background:
        linear-gradient(135deg, rgba(239, 246, 255, 0.92), rgba(236, 253, 245, 0.88));
      border: 1px solid rgba(20, 184, 166, 0.18);
      border-radius: 18px;
      color: var(--electricity-ink);
      min-height: 156px;
      padding: 1rem;
      text-decoration: none;
      transition: border-color 160ms ease, transform 160ms ease;
    }

    .electricity-appliance-grid a:hover,
    .electricity-appliance-grid a:focus-visible {
      border-color: rgba(8, 168, 245, 0.5);
      outline: none;
      transform: translateY(-2px);
    }

    .electricity-appliance-grid span,
    .electricity-appliance-grid strong,
    .electricity-appliance-grid em,
    .electricity-appliance-grid small {
      display: block;
    }

    .electricity-appliance-grid span {
      color: var(--electricity-muted);
      font-size: 0.8rem;
      font-weight: 800;
      margin-bottom: 0.3rem;
    }

    .electricity-appliance-grid strong {
      font-size: 1rem;
      font-weight: 900;
      line-height: 1.3;
    }

    .electricity-appliance-grid em {
      color: #0c8f68;
      font-size: 1.28rem;
      font-style: normal;
      font-weight: 950;
      margin-top: 0.45rem;
    }

    .electricity-appliance-grid small {
      color: var(--electricity-muted);
      font-size: 0.76rem;
      line-height: 1.45;
      margin-top: 0.45rem;
    }

    :global(html[data-theme='dark']) .electricity-flagship-page {
      --electricity-ink: #f7fbff;
      --electricity-muted: #b8c7d8;
      --electricity-line: rgba(197, 221, 244, 0.2);
      --electricity-surface: rgba(11, 21, 35, 0.86);
    }

    :global(html[data-theme='dark']) .electricity-update-strip,
    :global(html[data-theme='dark']) .electricity-direct-answer,
    :global(html[data-theme='dark']) .electricity-rate-links,
    :global(html[data-theme='dark']) .electricity-mode-card,
    :global(html[data-theme='dark']) .electricity-calculator-panel,
    :global(html[data-theme='dark']) .electricity-results-panel,
    :global(html[data-theme='dark']) .electricity-bill-visualizer,
    :global(html[data-theme='dark']) .electricity-example-strip,
    :global(html[data-theme='dark']) .electricity-appliance-lab {
      background: rgba(8, 16, 29, 0.92);
      box-shadow: 0 28px 80px rgba(0, 0, 0, 0.34);
    }

    :global(html[data-theme='dark']) .electricity-presets button,
    :global(html[data-theme='dark']) .electricity-calculator-panel input,
    :global(html[data-theme='dark']) .electricity-calculator-panel select,
    :global(html[data-theme='dark']) .electricity-rate-links a,
    :global(html[data-theme='dark']) .electricity-quick-grid > div,
    :global(html[data-theme='dark']) .electricity-visualizer-summary > div,
    :global(html[data-theme='dark']) .electricity-example-list > div,
    :global(html[data-theme='dark']) .electricity-appliance-grid a {
      background: rgba(14, 26, 42, 0.92);
      color: #f7fbff;
    }

    :global(html[data-theme='dark']) .electricity-calculator-panel label,
    :global(html[data-theme='dark']) .electricity-quick-grid strong,
    :global(html[data-theme='dark']) .electricity-mode-card strong {
      color: #f7fbff;
    }

    @keyframes electricity-rise {
      from {
        opacity: 0;
        transform: translateY(16px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (max-width: 900px) {
      .electricity-quick-grid,
      .electricity-presets,
      .electricity-rate-links > div:last-child,
      .electricity-mode-grid,
      .electricity-example-list,
      .electricity-appliance-grid,
      .electricity-visualizer-summary {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .electricity-example-strip {
        align-items: stretch;
        flex-direction: column;
      }
    }

    @media (max-width: 640px) {
      .electricity-flagship-page {
        padding-inline: 0.75rem;
      }

      .electricity-update-strip {
        border-radius: 18px;
        width: 100%;
      }

      .electricity-quick-grid,
      .electricity-presets,
      .electricity-rate-links > div:last-child,
      .electricity-mode-grid,
      .electricity-example-list,
      .electricity-appliance-grid,
      .electricity-visualizer-summary {
        grid-template-columns: 1fr;
      }

      .electricity-panel-heading,
      .electricity-direct-answer,
      .electricity-results-heading {
        align-items: flex-start;
        flex-direction: column;
      }

      .electricity-direct-answer a {
        text-align: center;
        width: 100%;
      }

      .electricity-total-pill {
        width: 100%;
      }

      .electricity-bar-row {
        gap: 0.45rem;
        grid-template-columns: 1fr;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .electricity-update-strip,
      .electricity-direct-answer,
      .electricity-rate-links,
      .electricity-mode-card,
      .electricity-calculator-panel,
      .electricity-results-panel,
      .electricity-bill-visualizer,
      .electricity-example-strip,
      .electricity-appliance-lab,
      .electricity-presets button,
      .electricity-submit-btn {
        animation: none;
        transition: none;
      }
    }
  </style>

  <script>
    import { calculateElectricityBill, DEFAULT_ELECTRICITY_FT_RATE } from '../../lib/electricity-bill';

    function parseNum(value) {
      const normalized = String(value).replace(/,/g, '').trim();
      if (normalized === '') return NaN;
      const n = Number(normalized);
      return Number.isFinite(n) ? n : NaN;
    }

    function fmtMoney(amount) {
      return `${new Intl.NumberFormat('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(amount)} บาท`;
    }

    function fmtUnits(units) {
      return `${new Intl.NumberFormat('th-TH', { maximumFractionDigits: 2 }).format(units)} หน่วย`;
    }

    function fmtRate(rate) {
      return `${new Intl.NumberFormat('th-TH', { minimumFractionDigits: 4, maximumFractionDigits: 4 }).format(rate)} บาท/หน่วย`;
    }

    function fmtBahtPerUnit(rate) {
      return `${new Intl.NumberFormat('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(rate)} บาท/หน่วย`;
    }

    const form = document.getElementById('electricity-form');
    const submitBtn = document.getElementById('electricity-submit-btn');
    const formError = document.getElementById('electricity-form-error');
    const resultsDiv = document.getElementById('results');
    const sharePrompt = document.getElementById('electricity-share-prompt');
    const nextActionCard = document.getElementById('electricity-next-action');
    const breakdownBody = document.getElementById('tier-breakdown-body');
    const savingsList = document.getElementById('electricity-savings-list');
    const presetButtons = document.querySelectorAll('[data-electricity-preset]');

    const fields = {
      units: document.getElementById('units'),
      provider: document.getElementById('provider'),
      customerType: document.getElementById('customer-type'),
      ftRate: document.getElementById('ft-rate'),
    };

    function setFieldError(id, message) {
      const element = document.getElementById(id);
      if (!element) return;
      element.textContent = message;
      element.classList.remove('hidden');
    }

    function clearFieldError(id) {
      const element = document.getElementById(id);
      if (!element) return;
      element.textContent = '';
      element.classList.add('hidden');
    }

    function clearValidation() {
      formError.classList.add('hidden');
      clearFieldError('units-error');
      clearFieldError('provider-error');
      clearFieldError('customer-type-error');
      clearFieldError('ft-rate-error');
    }

    function updateSubmitState() {
      const requiredFilled = [
        fields.units.value,
        fields.provider.value,
        fields.customerType.value,
      ].every((value) => String(value).trim() !== '');

      const unitsValue = parseNum(fields.units.value);
      const ftInput = String(fields.ftRate.value).trim();
      const ftValue = ftInput === '' ? DEFAULT_ELECTRICITY_FT_RATE : parseNum(ftInput);

      const hasInvalidRequired = !Number.isFinite(unitsValue) || unitsValue <= 0;
      const hasInvalidFt = !Number.isFinite(ftValue) || ftValue < 0;

      const ready = requiredFilled && !hasInvalidRequired && !hasInvalidFt;
      submitBtn.disabled = !ready;
      submitBtn.textContent = ready ? 'คำนวณเลย' : 'กรอกข้อมูลให้ครบ';
      submitBtn.classList.toggle('cursor-not-allowed', !ready);
      submitBtn.classList.toggle('opacity-70', !ready);
    }

    Object.values(fields).forEach((field) => {
      field.addEventListener('input', () => {
        clearValidation();
        updateSubmitState();
      });
      field.addEventListener('change', () => {
        clearValidation();
        updateSubmitState();
      });
    });

    presetButtons.forEach((button) => {
      button.addEventListener('click', () => {
        if (!(button instanceof HTMLElement)) return;
        const { units, provider, customerType, ftRate } = button.dataset;
        if (units) fields.units.value = units;
        if (provider) fields.provider.value = provider;
        if (customerType) fields.customerType.value = customerType;
        if (ftRate) fields.ftRate.value = ftRate;
        clearValidation();
        updateSubmitState();
        if (form instanceof HTMLFormElement) {
          form.requestSubmit();
        }
      });
    });

    function setText(id, value) {
      const element = document.getElementById(id);
      if (element) element.textContent = value;
    }

    function setBillBar(barId, textId, amount, total) {
      const bar = document.getElementById(barId);
      const text = document.getElementById(textId);
      const percentage = total > 0 ? Math.max(4, Math.min(100, (amount / total) * 100)) : 4;
      if (bar) bar.style.width = `${percentage.toFixed(1)}%`;
      if (text) text.textContent = fmtMoney(amount);
    }

    function getUsageAdvice(result) {
      const units = result.units;
      if (units <= 150) {
        return {
          label: 'ประหยัดอยู่',
          note: 'ยังอยู่ในระดับต่ำ เหมาะกับการรักษาพฤติกรรมเดิม',
          items: [
            'ตรวจเลขมิเตอร์เดือนละครั้งเพื่อจับความผิดปกติเร็ว',
            'ปิด standby ของทีวี คอมพิวเตอร์ และเครื่องชาร์จที่ไม่ใช้',
            'ใช้ตัวเลขนี้เป็นฐานเทียบเดือนถัดไป ถ้าเกิน 20% ให้ตรวจเครื่องใช้ไฟฟ้า',
          ],
        };
      }
      if (units <= 300) {
        return {
          label: 'ระดับบ้านทั่วไป',
          note: 'เริ่มมีผลจากแอร์ ตู้เย็น และเครื่องทำน้ำอุ่น',
          items: [
            'เช็กแอร์เป็นอันดับแรก ตั้ง 26-27°C และล้างแผ่นกรองสม่ำเสมอ',
            'แยกคำนวณเครื่องใช้ที่เปิดทุกวัน เช่น ตู้เย็น พัดลม คอมพิวเตอร์',
            'ถ้าเป็นห้องเช่า ให้เทียบราคาต่อหน่วยกับมิเตอร์จริงก่อนจ่าย',
          ],
        };
      }
      if (units <= 500) {
        return {
          label: 'ใช้ไฟสูง',
          note: 'ควรแยกต้นทุนรายเครื่องและหาช่วงเวลาที่ใช้ไฟหนัก',
          items: [
            'คำนวณแอร์รายเครื่อง เพราะแอร์หลายชั่วโมงต่อวันอาจเป็นต้นทุนหลัก',
            'ตรวจเครื่องทำน้ำอุ่น เตาไฟฟ้า และอุปกรณ์กำลังวัตต์สูง',
            'ดูเครื่องคำนวณโซลาร์เซลล์หรือ LED ถ้าค่าไฟเกินระดับนี้ต่อเนื่อง',
          ],
        };
      }
      return {
        label: 'ควรตรวจละเอียด',
        note: 'ยอดนี้เหมาะกับบ้านใหญ่ ร้านค้า หรือมีอุปกรณ์กำลังสูง',
        items: [
          'แยกมิเตอร์หรือแยกพื้นที่ใช้งาน ถ้ามีร้าน/โฮมออฟฟิศรวมกับบ้าน',
          'ตรวจแอร์เก่า ตู้เย็นเก่า ปั๊มน้ำ และอุปกรณ์ที่ทำงานตลอดคืน',
          'เก็บบิลย้อนหลัง 3 เดือนแล้วเทียบหน่วย ไม่ใช่เทียบแค่ยอดเงินบาท',
        ],
      };
    }

    function updateBillVisualizer(result) {
      const effectiveRate = result.units > 0 ? result.totalBill / result.units : 0;
      setText('res-effective-rate', fmtBahtPerUnit(effectiveRate));
      setText('res-yearly-total', fmtMoney(result.totalBill * 12));

      const advice = getUsageAdvice(result);
      setText('res-usage-signal', advice.label);
      setText('res-usage-signal-note', advice.note);

      setBillBar('res-bar-energy', 'res-bar-energy-text', result.energyCharge, result.totalBill);
      setBillBar('res-bar-ft', 'res-bar-ft-text', result.ftCharge, result.totalBill);
      setBillBar('res-bar-service', 'res-bar-service-text', result.serviceCharge, result.totalBill);
      setBillBar('res-bar-vat', 'res-bar-vat-text', result.vatAmount, result.totalBill);

      if (savingsList) {
        savingsList.innerHTML = '';
        advice.items.forEach((item) => {
          const li = document.createElement('li');
          li.textContent = item;
          savingsList.appendChild(li);
        });
      }
    }

    updateSubmitState();

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      clearValidation();

      const units = parseNum(fields.units.value);
      const provider = String(fields.provider.value || '');
      const customerType = String(fields.customerType.value || '');
      const ftInput = String(fields.ftRate.value).trim();
      const ftRate = ftInput === '' ? DEFAULT_ELECTRICITY_FT_RATE : parseNum(ftInput);

      const validity = {
        units: Number.isFinite(units) && units > 0,
        provider: provider === 'mea' || provider === 'pea',
        customerType: customerType === 'residential' || customerType === 'small_business',
        ftRate: Number.isFinite(ftRate) && ftRate >= 0,
      };

      if (!validity.units) setFieldError('units-error', 'กรุณากรอกจำนวนหน่วยมากกว่า 0');
      if (!validity.provider) setFieldError('provider-error', 'กรุณาเลือกการไฟฟ้า');
      if (!validity.customerType) setFieldError('customer-type-error', 'กรุณาเลือกประเภทผู้ใช้ไฟ');
      if (!validity.ftRate) setFieldError('ft-rate-error', 'ค่า Ft ต้องเป็นตัวเลขตั้งแต่ 0 ขึ้นไป');

      if (!Object.values(validity).every(Boolean)) {
        formError.classList.remove('hidden');
        resultsDiv.classList.add('hidden');
        sharePrompt?.classList.add('hidden');
        nextActionCard?.classList.add('hidden');
        updateSubmitState();
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'กำลังคำนวณ...';
      trackCalculatorStart('electricity_bill');

      const result = calculateElectricityBill({
        units,
        provider,
        customerType,
        ftRate,
      });

      setText('res-energy-charge', fmtMoney(result.energyCharge));
      setText('res-ft-charge', fmtMoney(result.ftCharge));
      setText('res-service-charge', fmtMoney(result.serviceCharge));
      setText('res-vat', fmtMoney(result.vatAmount));
      setText('res-total', fmtMoney(result.totalBill));
      setText('res-total-inline', fmtMoney(result.totalBill));

      setText('res-provider', result.provider === 'mea' ? 'MEA - การไฟฟ้านครหลวง' : 'PEA - การไฟฟ้าส่วนภูมิภาค');
      setText('res-customer-type', result.customerType === 'residential' ? 'บ้านอยู่อาศัย' : 'กิจการขนาดเล็ก');
      setText('res-tariff-code', result.tariffCode);
      setText('res-units', fmtUnits(result.units));
      setText('res-ft-rate', fmtRate(result.appliedFtRate));
      setText('res-subtotal', fmtMoney(result.subtotalBeforeVat));
      updateBillVisualizer(result);

      breakdownBody.innerHTML = '';
      result.tierBreakdown.forEach((tier) => {
        const row = document.createElement('tr');
        row.innerHTML = `
          <td class="px-3 py-2 text-gray-700">${tier.label}</td>
          <td class="px-3 py-2 text-right text-gray-700">${new Intl.NumberFormat('th-TH', { maximumFractionDigits: 2 }).format(tier.units)}</td>
          <td class="px-3 py-2 text-right text-gray-700">${new Intl.NumberFormat('th-TH', { minimumFractionDigits: 4, maximumFractionDigits: 4 }).format(tier.rate)}</td>
          <td class="px-3 py-2 text-right font-medium text-gray-900">${new Intl.NumberFormat('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(tier.amount)}</td>
        `;
        breakdownBody.appendChild(row);
      });

      const noteParts = [
        `รหัสอัตรา ${result.tariffCode}`,
        `ค่า Ft ที่ใช้ ${new Intl.NumberFormat('th-TH', { minimumFractionDigits: 4, maximumFractionDigits: 4 }).format(result.appliedFtRate)} บาท/หน่วย`,
        'ผลลัพธ์เป็นค่าประมาณ โปรดตรวจเทียบกับบิลจริงจาก PEA/MEA',
      ];
      setText('result-note', noteParts.join(' | '));

      resultsDiv.classList.remove('hidden');
      sharePrompt?.classList.remove('hidden');
      nextActionCard?.classList.remove('hidden');
      document.getElementById('affiliate-card')?.classList.remove('hidden');
      resultsDiv.scrollIntoView({ behavior: 'smooth', block: 'start' });

      submitBtn.disabled = false;
      submitBtn.textContent = 'คำนวณเลย';
      trackCalculatorComplete('electricity_bill', result.totalBill);
      trackCalculatorUsed('electricity_bill');
    });

    const resultObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          trackResultViewed('electricity_bill');
          resultObserver.disconnect();
        }
      });
    }, { threshold: 0.5 });
    resultObserver.observe(resultsDiv);
  </script>
</BaseLayout>
