---
import RelatedCalculators from '../../components/templates/RelatedCalculators.astro';
import RelatedArticles from '../../components/templates/RelatedArticles.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuardedAdSlot from '../../components/templates/GuardedAdSlot.astro';
import AffiliateCard from '../../components/templates/AffiliateCard.astro';
import FAQAccordion from '../../components/templates/FAQAccordion.astro';
import TrafficGrowthCluster from '../../components/templates/TrafficGrowthCluster.astro';
import ResultSharePrompt from '../../components/templates/ResultSharePrompt.astro';
import { carLoanGrowthLinks, recoveryGrowthLinks } from '../../data/traffic-growth-opportunities';

const pageTitle = 'คำนวณผ่อนรถ 2569 | ตารางผ่อนรถ ดาวน์ 20% 48/60/72/84 เดือน';
const pageDescription = 'คำนวณผ่อนรถปี 2569 พร้อมตารางผ่อนรถ เงินดาวน์ 20% ดอกเบี้ย flat rate งวด 48/60/72/84 เดือน และยอดจ่ายทั้งสัญญาก่อนสมัครสินเชื่อ';
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://www.kamnuanlek.com').replace(/\/$/, '');
const canonical = `${siteUrl}/คำนวณผ่อนรถ/`;
const carLoanRecoveryLinks = recoveryGrowthLinks
  .filter((item) => item.href !== '/คำนวณผ่อนรถ/')
  .slice(0, 5);

const faqData = [
  {
    question: 'คำนวณค่างวดรถยนต์อย่างไรให้ใกล้เคียงความจริงที่สุด?',
    answer: 'ให้ใส่ราคารถจริง เงินดาวน์จริง อัตราดอกเบี้ยจากไฟแนนซ์ และจำนวนงวดที่ต้องการ จากนั้นเปรียบเทียบอย่างน้อย 2-3 ข้อเสนอในเงื่อนไขเดียวกัน จะได้ค่างวดที่ใกล้เคียงความจริงมากที่สุด',
  },
  {
    question: 'เงินดาวน์รถควรจ่ายกี่เปอร์เซ็นต์?',
    answer: 'โดยทั่วไปเงินดาวน์ขั้นต่ำอยู่ที่ 10-20% ของราคารถ แนะนำให้ดาวน์ 20-25% เพื่อลดภาระค่างวดและดอกเบี้ยรวม ดาวน์มากยิ่งจ่ายดอกเบี้ยน้อย',
  },
  {
    question: 'ผ่อน 48/60/72/84 งวดต่างกันอย่างไร?',
    answer: 'งวดยิ่งสั้น ค่างวดต่อเดือนยิ่งสูงแต่ดอกเบี้ยรวมต่ำกว่า งวดยิ่งยาว ค่างวดต่อเดือนต่ำลงแต่ดอกเบี้ยรวมสูงขึ้น ควรเลือกระยะเวลาที่ค่างวดไม่เกิน 15-20% ของรายได้ต่อเดือน',
  },
  {
    question: 'ดอกเบี้ยต่าง 0.5% กระทบค่างวดเท่าไร?',
    answer: 'โดยทั่วไปอัตราดอกเบี้ยเพิ่มขึ้น 0.5% จะทำให้ค่างวดต่อเดือนและดอกเบี้ยรวมสูงขึ้นทันที โดยผลกระทบมากหรือน้อยขึ้นกับยอดจัดไฟแนนซ์และจำนวนงวดที่เลือก',
  },
  {
    question: 'รีไฟแนนซ์รถช่วยลดค่างวดได้จริงหรือไม่?',
    answer: 'ช่วยได้ในหลายกรณี หากอัตราดอกเบี้ยใหม่ต่ำลงหรือยืดระยะเวลาผ่อน แต่ควรคำนวณค่าใช้จ่ายประกอบ เช่น ค่าปิดบัญชีเดิมและค่าธรรมเนียมใหม่ เพื่อดูว่าลดค่างวดแล้วคุ้มจริงหรือไม่',
  },
  {
    question: 'ข้อผิดพลาดทั่วไปในการคำนวณผ่อนรถที่ต้องหลีกเลี่ยงคืออะไร?',
    answer: 'ข้อผิดพลาดทั่วไป ได้แก่ (1) ลืมบวกค่าประกันภัยรถยนต์และ พ.ร.บ. (ถ้าบังคับ) (2) ไม่ตรวจสอบอัตราดอกเบี้ยจริงจากไฟแนนซ์ (3) นำอัตรา effective rate มาคิดเป็น flat rate ผิดวิธี (4) ไม่คิดค่าจดทะเบียนและภาษีอื่น (5) ใช้ราคาสูงกว่าราคาตลาดจริง และ (6) ลืมตรวจจำนวนเดือนผ่อนให้ตรงกับสัญญา',
  },
  {
    question: 'วิธีคิดดอกเบี้ยรถแบบ flat rate คิดอย่างไร?',
    answer: 'สูตรหลักคือ ดอกเบี้ยรวม = ยอดจัดไฟแนนซ์ × อัตราดอกเบี้ยต่อปี × จำนวนปีผ่อน แล้วนำ (ยอดจัด + ดอกเบี้ยรวม) ÷ จำนวนงวด จะได้ค่างวดต่อเดือนโดยประมาณ',
  },
  {
    question: 'คำนวณผ่อนรถมือสองต้องดูอะไรเพิ่ม?',
    answer: 'ผ่อนรถมือสองควรตรวจ 4 จุดเพิ่มคือ (1) อัตราดอกเบี้ยมักสูงกว่ารถใหม่ (2) ระยะเวลาผ่อนสั้นกว่า (3) วงเงินอนุมัติขึ้นกับอายุรถ และ (4) ค่าใช้จ่ายวันออกรถ เช่น โอน/ประกัน/ค่าดำเนินการ',
  },
  {
    question: 'ตารางผ่อนรถใช้ดูอะไรบ้างก่อนตัดสินใจ?',
    answer: 'ตารางผ่อนรถช่วยดูค่างวดต่อเดือน ดอกเบี้ยรวม และยอดจ่ายทั้งสัญญาแบบเทียบหลายกรณี เช่น เปลี่ยนเงินดาวน์ 10-30% หรือเปลี่ยนระยะเวลาผ่อน 48-84 งวด เพื่อเลือกแผนที่เหมาะกับรายได้',
  },
  {
    question: 'ดาวน์รถ 20% ผ่อนเท่าไรต้องรู้ข้อมูลอะไรบ้าง?',
    answer: 'ต้องรู้ราคารถ เงินดาวน์ 20% อัตราดอกเบี้ยแบบ flat rate และจำนวนงวด เช่น 48/60/72/84 เดือน จากนั้นนำยอดจัดไฟแนนซ์และดอกเบี้ยรวมมาหารด้วยจำนวนงวด',
  },
  {
    question: 'คำนวณผ่อนรถกับค่างวดจริงต่างกันตรงไหน?',
    answer: 'เครื่องคำนวณช่วยประมาณค่างวดจากสูตรไฟแนนซ์ แต่ค่างวดจริงอาจต่างจากค่าธรรมเนียม ประกัน ภาษี โปรโมชัน ดอกเบี้ยเฉพาะบุคคล และเงื่อนไขของบริษัทไฟแนนซ์',
  },
];

const jsonLdWebApp = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'เครื่องคำนวณผ่อนรถ',
  description: pageDescription,
  url: canonical,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'All',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'THB' },
  inLanguage: 'th',
};

const jsonLdFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqData.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};

const jsonLdHowTo = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'วิธีคำนวณค่างวดรถยนต์ด้วยเครื่องคำนวณผ่อนรถ',
  description: 'คำนวณค่างวดรถยนต์รายเดือน เงินดาวน์ และดอกเบี้ยรวมด้วยอัตราดอกเบี้ยแบบ flat rate ที่ใช้กับสินเชื่อรถยนต์ในประเทศไทย',
  inLanguage: 'th',
  totalTime: 'PT1M',
  tool: [{ '@type': 'HowToTool', name: 'เครื่องคำนวณผ่อนรถออนไลน์ฟรี' }],
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'กรอกราคารถยนต์',
      text: 'กรอกราคารถยนต์ที่ต้องการซื้อในช่อง "ราคารถ (บาท)" เช่น 900,000 บาท สำหรับรถยนต์ใหม่ หรือราคาที่ตกลงกับผู้ขายสำหรับรถมือสอง',
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'ระบุเงินดาวน์และอัตราดอกเบี้ย',
      text: 'กรอกเปอร์เซ็นต์เงินดาวน์ (แนะนำ 20% ขึ้นไป) และอัตราดอกเบี้ยแบบ flat rate ตามที่ไฟแนนซ์เสนอ (รถใหม่ประมาณ 2.5–4% ต่อปี รถมือสองประมาณ 4–7% ต่อปี)',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'เลือกระยะเวลาผ่อนชำระ',
      text: 'เลือกจำนวนปีที่ต้องการผ่อน ตั้งแต่ 4–7 ปี (48–84 งวด) โดยผ่อนสั้นจะจ่ายดอกเบี้ยน้อยกว่าแต่ค่างวดต่อเดือนสูงกว่า',
    },
    {
      '@type': 'HowToStep',
      position: 4,
      name: 'กดคำนวณและดูผลลัพธ์',
      text: 'กดปุ่ม "คำนวณทันที" เพื่อดูค่างวดรายเดือน เงินดาวน์ ดอกเบี้ยรวม และค่าใช้จ่ายทั้งหมดตลอดสัญญา',
    },
    {
      '@type': 'HowToStep',
      position: 5,
      name: 'ตรวจสอบตารางผ่อนชำระ',
      text: 'คลิก "ตารางผ่อนชำระ" เพื่อดูรายละเอียดเงินต้น ดอกเบี้ย และยอดคงเหลือในแต่ละงวด เพื่อใช้วางแผนการเงินก่อนลงนามสัญญา',
    },
  ],
};

---

<BaseLayout noGenericHowTo={true} title={pageTitle} description={pageDescription} canonical={canonical} pageName="คำนวณผ่อนรถ">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdWebApp)} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdHowTo)} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />

  <article>
    <div class="mb-4 rounded-xl border border-sky-100 bg-sky-50 p-4">
      <p class="text-sm font-semibold text-sky-700">รู้ผลในไม่ถึง 30 วินาที</p>
      <p class="mt-1 text-sm text-slate-700">ข้อมูลไม่ถูกบันทึก และใช้เพื่อการคำนวณเท่านั้น</p>
      <p class="mt-1 text-xs font-medium text-sky-800">อัปเดตเกณฑ์ปี 2569 • อัปเดตเมื่อ: 21 เม.ย. 2569</p>
    </div>

    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-3">
      คำนวณผ่อนรถ 2569: เช็กค่างวดรถ 48/60/72/84 เดือน
    </h1>

    <div class="mb-4 inline-block rounded-lg border border-green-200 bg-green-50 px-3 py-2">
      <p class="text-xs font-semibold text-green-800">[อัปเดตตามอัตราดอกเบี้ยธนาคารแห่งประเทศไทย 2569]</p>
    </div>

    <p class="text-gray-600 mb-6">
      คำนวณค่างวดรถยนต์รายเดือน เงินดาวน์ ดอกเบี้ยรวม และยอดจ่ายทั้งสัญญา ด้วยอัตราดอกเบี้ยแบบคงที่ (flat rate) ที่ใช้กับสินเชื่อรถยนต์ในไทย
    </p>

    <section data-ai-overview-answer class="mb-6 rounded-xl border border-amber-100 bg-white p-4 shadow-sm sm:p-5" aria-labelledby="car-loan-answer">
      <p class="text-xs font-bold uppercase tracking-normal text-amber-700">คำตอบเร็ว</p>
      <h2 id="car-loan-answer" class="mt-1 text-lg font-bold text-slate-950">ผ่อนรถคำนวณจากอะไร</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-3">
        <div class="rounded-lg border border-slate-100 bg-slate-50 p-3">
          <strong class="block text-sm text-slate-950">สูตรค่างวด</strong>
          <span class="mt-1 block text-sm leading-6 text-slate-600">ค่างวด = (ยอดจัดไฟแนนซ์ + ดอกเบี้ยรวม) / จำนวนงวด</span>
        </div>
        <div class="rounded-lg border border-slate-100 bg-slate-50 p-3">
          <strong class="block text-sm text-slate-950">เงินดาวน์ 20%</strong>
          <span class="mt-1 block text-sm leading-6 text-slate-600">ดาวน์มากขึ้นช่วยลดยอดจัด ดอกเบี้ยรวม และความเสี่ยงผ่อนตึง</span>
        </div>
        <div class="rounded-lg border border-slate-100 bg-slate-50 p-3">
          <strong class="block text-sm text-slate-950">ตารางผ่อนรถ</strong>
          <span class="mt-1 block text-sm leading-6 text-slate-600">เทียบ 48/60/72/84 เดือน เพื่อดูค่างวดกับยอดจ่ายทั้งสัญญา</span>
        </div>
      </div>
    </section>

    <!-- Calculator Form -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 sm:p-6 mb-8">
      <form id="vehicle-form" class="space-y-5">
        <p id="vehicle-form-error" class="hidden rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm font-medium text-red-700">
          กรอกข้อมูลให้ครบก่อนคำนวณ
        </p>
        <div>
          <label for="car-price" class="block text-sm font-medium text-gray-700 mb-1">
            ราคารถ (บาท)
          </label>
          <input
            type="text"
            id="car-price"
            inputmode="numeric"
            placeholder="เช่น 900,000"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-base"
          />
          <p id="car-price-error" class="mt-1 hidden text-sm text-red-600"></p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <div>
            <label for="down-payment" class="block text-sm font-medium text-gray-700 mb-1">
              เงินดาวน์ (%)
            </label>
            <input
              type="text"
              id="down-payment"
              inputmode="decimal"
              placeholder="เช่น 20"
              value="20"
              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-base"
            />
          </div>
          <div>
            <label for="interest-rate" class="block text-sm font-medium text-gray-700 mb-1">
              อัตราดอกเบี้ย (% ต่อปี)
            </label>
            <input
              type="text"
              id="interest-rate"
              inputmode="decimal"
              placeholder="เช่น 3.5"
              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-base"
            />
            <p class="mt-1 text-xs text-gray-500">ใส่อัตราแบบ flat rate ตามไฟแนนซ์รถยนต์ไทย</p>
            <p id="interest-rate-error" class="mt-1 hidden text-sm text-red-600"></p>
          </div>
          <div>
            <label for="term-years" class="block text-sm font-medium text-gray-700 mb-1">
              ระยะเวลาผ่อน (ปี)
            </label>
            <select
              id="term-years"
              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-base bg-white"
            >
              <option value="4">4 ปี (48 งวด)</option>
              <option value="5" selected>5 ปี (60 งวด)</option>
              <option value="6">6 ปี (72 งวด)</option>
              <option value="7">7 ปี (84 งวด)</option>
            </select>
          </div>
          <div>
            <label for="monthly-income" class="block text-sm font-medium text-gray-700 mb-1">
              รายได้ต่อเดือน (บาท)
            </label>
            <input
              type="text"
              id="monthly-income"
              inputmode="numeric"
              placeholder="เช่น 50,000"
              value="50,000"
              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-base"
            />
            <p class="mt-1 text-xs text-gray-500">ใช้ประเมินภาระผ่อนรถเทียบรายได้</p>
            <p id="monthly-income-error" class="mt-1 hidden text-sm text-red-600"></p>
          </div>
        </div>

        <!-- Down payment amount display -->
        <div id="down-amount-display" class="text-sm text-gray-500 hidden">
          เงินดาวน์: <span id="down-amount-text" class="font-medium text-gray-700"></span> บาท | ยอดจัด: <span id="finance-amount-text" class="font-medium text-gray-700"></span> บาท
        </div>

        <button
          type="submit"
          id="vehicle-submit-btn"
          class="w-full sm:w-auto px-8 py-3 bg-primary-600 text-white font-semibold rounded-md hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 transition-colors text-base"
        >
          คำนวณทันที
        </button>
      </form>
    </div>

    <!-- Results -->
    <div id="results" class="hidden mb-8">
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 sm:p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">ผลการคำนวณ</h2>

        <!-- Summary Cards -->
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5 mb-6">
          <div class="bg-primary-50 rounded-lg p-4 text-center">
            <div class="text-sm text-gray-600 mb-1">ค่างวดต่อเดือน</div>
            <div id="res-monthly" class="text-xl font-bold text-primary-700">-</div>
          </div>
          <div class="bg-green-50 rounded-lg p-4 text-center">
            <div class="text-sm text-gray-600 mb-1">เงินดาวน์</div>
            <div id="res-down" class="text-xl font-bold text-green-700">-</div>
          </div>
          <div class="bg-red-50 rounded-lg p-4 text-center">
            <div class="text-sm text-gray-600 mb-1">ดอกเบี้ยรวม</div>
            <div id="res-interest" class="text-xl font-bold text-red-600">-</div>
          </div>
          <div class="bg-gray-50 rounded-lg p-4 text-center">
            <div class="text-sm text-gray-600 mb-1">ค่าใช้จ่ายทั้งหมด</div>
            <div id="res-total-cost" class="text-xl font-bold text-gray-700">-</div>
          </div>
          <div class="bg-blue-50 rounded-lg p-4 text-center">
