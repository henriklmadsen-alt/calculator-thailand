  <script>
    function parseNum(v: string): number {
      return Math.max(0, parseFloat(v.replace(/,/g, '')) || 0);
    }

    function hasInvalidNumber(v: string): boolean {
      const normalized = v.replace(/,/g, '').trim();
      return normalized !== '' && Number.isNaN(Number(normalized));
    }

    function fmt(n: number): string {
      return new Intl.NumberFormat('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);
    }

    const form = document.getElementById('vehicle-form') as HTMLFormElement;
    const submitBtn = document.getElementById('vehicle-submit-btn') as HTMLButtonElement;
    const formError = document.getElementById('vehicle-form-error') as HTMLElement;
    const nextActionCard = document.getElementById('vehicle-next-action') as HTMLElement;
    const sharePrompt = document.getElementById('vehicle-share-prompt') as HTMLElement | null;
    const resultsDiv = document.getElementById('results') as HTMLDivElement;
    const carPriceInput = document.getElementById('car-price') as HTMLInputElement;
    const downPaymentInput = document.getElementById('down-payment') as HTMLInputElement;
    const interestRateInput = document.getElementById('interest-rate') as HTMLInputElement;
    const monthlyIncomeInput = document.getElementById('monthly-income') as HTMLInputElement;
    let hasTrackedStart = false;

    function setFieldError(elementId: string, message: string) {
      const el = document.getElementById(elementId);
      if (!el) return;
      el.textContent = message;
      el.classList.remove('hidden');
    }

    function clearFieldError(elementId: string) {
      const el = document.getElementById(elementId);
      if (!el) return;
      el.textContent = '';
      el.classList.add('hidden');
    }

    function clearValidation() {
      clearFieldError('car-price-error');
      clearFieldError('interest-rate-error');
      clearFieldError('monthly-income-error');
      formError.classList.add('hidden');
    }

    function hideResultActions() {
      resultsDiv.classList.add('hidden');
      nextActionCard.classList.add('hidden');
      sharePrompt?.classList.add('hidden');
    }

    function updateSubmitState() {
      const ready = parseNum(carPriceInput.value) > 0 && parseNum(interestRateInput.value) > 0;
      submitBtn.disabled = !ready;
      submitBtn.textContent = ready ? 'คำนวณทันที' : 'กรอกข้อมูลให้ครบ';
      submitBtn.classList.toggle('opacity-70', !ready);
      submitBtn.classList.toggle('cursor-not-allowed', !ready);
    }

    // Live preview of down payment amount
    function updateDownPreview() {
      const price = parseNum(carPriceInput.value);
      const pct = parseFloat(downPaymentInput.value) || 0;
      const display = document.getElementById('down-amount-display') as HTMLElement;
      if (price > 0 && pct > 0) {
        const down = price * pct / 100;
        const finance = price - down;
        (document.getElementById('down-amount-text') as HTMLElement).textContent = fmt(down);
        (document.getElementById('finance-amount-text') as HTMLElement).textContent = fmt(finance);
        display.classList.remove('hidden');
      } else {
        display.classList.add('hidden');
      }
    }

    carPriceInput.addEventListener('input', updateDownPreview);
    downPaymentInput.addEventListener('input', updateDownPreview);
    carPriceInput.addEventListener('input', () => {
      clearFieldError('car-price-error');
      formError.classList.add('hidden');
      updateSubmitState();
    });
    interestRateInput.addEventListener('input', () => {
      clearFieldError('interest-rate-error');
      formError.classList.add('hidden');
      updateSubmitState();
    });
    monthlyIncomeInput.addEventListener('input', () => {
      clearFieldError('monthly-income-error');
      formError.classList.add('hidden');
    });
    updateSubmitState();

    form.addEventListener('input', () => {
      if (!hasTrackedStart) {
        trackCalculatorStart('vehicle');
        hasTrackedStart = true;
      }
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      clearValidation();

      const carPrice = parseNum(carPriceInput.value);
      const downPct = parseFloat(downPaymentInput.value) || 0;
      const annualRate = parseFloat(interestRateInput.value.replace(/,/g, '')) || 0;
      const monthlyIncome = parseNum(monthlyIncomeInput.value);
      const termYears = parseInt((document.getElementById('term-years') as HTMLSelectElement).value) || 5;
      const termMonths = termYears * 12;

      if (hasInvalidNumber(carPriceInput.value) || hasInvalidNumber(interestRateInput.value) || hasInvalidNumber(monthlyIncomeInput.value)) {
        formError.classList.remove('hidden');
        hideResultActions();
        if (hasInvalidNumber(carPriceInput.value)) {
          setFieldError('car-price-error', 'รูปแบบข้อมูลไม่ถูกต้อง');
          carPriceInput.focus();
        }
        if (hasInvalidNumber(interestRateInput.value)) {
          setFieldError('interest-rate-error', 'รูปแบบข้อมูลไม่ถูกต้อง');
          if (!hasInvalidNumber(carPriceInput.value)) {
            interestRateInput.focus();
          }
        }
        if (hasInvalidNumber(monthlyIncomeInput.value)) {
          setFieldError('monthly-income-error', 'รูปแบบข้อมูลไม่ถูกต้อง');
          if (!hasInvalidNumber(carPriceInput.value) && !hasInvalidNumber(interestRateInput.value)) {
            monthlyIncomeInput.focus();
          }
        }
        updateSubmitState();
        return;
      }

      if (carPrice <= 0) {
        formError.classList.remove('hidden');
        hideResultActions();
        setFieldError('car-price-error', 'กรุณากรอกจำนวนเงินมากกว่า 0');
        carPriceInput.focus();
        updateSubmitState();
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'กำลังคำนวณ...';
      if (!hasTrackedStart) {
        trackCalculatorStart('vehicle');
        hasTrackedStart = true;
      }

      const downPayment = carPrice * (downPct / 100);
      const financeAmount = carPrice - downPayment;
      const totalInterest = financeAmount * (annualRate / 100) * termYears;
      const totalPaid = financeAmount + totalInterest;
      const monthlyPayment = termMonths > 0 ? totalPaid / termMonths : 0;
      const totalCost = downPayment + totalPaid;
      const incomeRatio = monthlyIncome > 0 ? (monthlyPayment / monthlyIncome) * 100 : 0;
      const incomeRatioLabel = monthlyIncome > 0
        ? incomeRatio.toFixed(2) + '% ของรายได้ต่อเดือน'
        : '0.00% (ยังไม่ระบุรายได้)';

      // Update summary
      (document.getElementById('res-monthly') as HTMLElement).textContent = fmt(monthlyPayment) + ' บาท';
      (document.getElementById('res-down') as HTMLElement).textContent = fmt(downPayment) + ' บาท';
      (document.getElementById('res-interest') as HTMLElement).textContent = fmt(totalInterest) + ' บาท';
      (document.getElementById('res-total-cost') as HTMLElement).textContent = fmt(totalCost) + ' บาท';
      (document.getElementById('res-car-price') as HTMLElement).textContent = fmt(carPrice) + ' บาท';
      (document.getElementById('res-down-detail') as HTMLElement).textContent = fmt(downPayment) + ' บาท (' + downPct.toFixed(0) + '%)';
      (document.getElementById('res-finance') as HTMLElement).textContent = fmt(financeAmount) + ' บาท';
      (document.getElementById('res-rate') as HTMLElement).textContent = annualRate.toFixed(2) + '% ต่อปี';
      (document.getElementById('res-term') as HTMLElement).textContent = termMonths + ' งวด (' + termYears + ' ปี)';
      (document.getElementById('res-total-paid') as HTMLElement).textContent = fmt(totalPaid) + ' บาท';
      (document.getElementById('res-income-ratio') as HTMLElement).textContent = incomeRatio.toFixed(2) + '%';
      (document.getElementById('res-income-ratio-detail') as HTMLElement).textContent = incomeRatioLabel;

      // Amortization table
      const monthlyPrincipal = financeAmount / termMonths;
      const monthlyInterest = totalInterest / termMonths;
      const tbody = document.getElementById('schedule-body') as HTMLTableSectionElement;
      tbody.innerHTML = '';

      let balance = financeAmount;
      for (let m = 1; m <= termMonths; m++) {
        balance = Math.max(0, balance - monthlyPrincipal);
        const show = m <= 12 || m % 12 === 0 || m === termMonths;
        if (!show) continue;

        if (m > 13 && (m - 1) % 12 !== 0) {
          const sep = document.createElement('tr');
          sep.innerHTML = '<td colspan="5" class="py-1 text-center text-gray-400 text-xs">⋮</td>';
          tbody.appendChild(sep);
        }

        const tr = document.createElement('tr');
        tr.className = 'border-b border-gray-100';
        tr.innerHTML = `
          <td class="py-2 pr-2 text-gray-600">${m}</td>
          <td class="py-2 pr-2 text-right">${fmt(monthlyPayment)}</td>
          <td class="py-2 pr-2 text-right">${fmt(monthlyPrincipal)}</td>
          <td class="py-2 pr-2 text-right">${fmt(monthlyInterest)}</td>
          <td class="py-2 text-right">${fmt(balance)}</td>
        `;
        tbody.appendChild(tr);
      }

      resultsDiv.classList.remove('hidden');
      sharePrompt?.classList.remove('hidden');
      nextActionCard.classList.remove('hidden');
      resultsDiv.scrollIntoView({ behavior: 'smooth', block: 'start' });
      const affiliateCard = document.getElementById('affiliate-card') as HTMLElement | null;
      if (affiliateCard) affiliateCard.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = 'คำนวณทันที';
      trackCalculatorComplete('vehicle');
      trackCalculatorUsed('vehicle');
    });

    document.querySelectorAll('[data-next-action-link]').forEach((link) => {
      link.addEventListener('click', () => {
        if (typeof window.gtag === 'function') {
          const href = (link as HTMLAnchorElement).getAttribute('href') || '';
          window.gtag('event', 'next_action_click', {
            calculator: 'vehicle',
            target_href: href,
          });
        }
      });
    });

    const resultObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          trackResultViewed('vehicle');
          resultObserver.disconnect();
        }
      });
    }, { threshold: 0.5 });
    resultObserver.observe(resultsDiv);
  </script>
</BaseLayout>
