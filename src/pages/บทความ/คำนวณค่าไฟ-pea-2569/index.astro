---
import BlogPostLayout from '../../../layouts/BlogPostLayout.astro';
import ArticleCalculatorCTA from '../../../components/templates/ArticleCalculatorCTA.astro';
import AffiliateCard from '../../../components/templates/AffiliateCard.astro';

const title = 'คำนวณค่าไฟ PEA 2569 | ค่า Ft ล่าสุด + สูตรบิลบ้าน | Kamnuanlek';
const description = 'คำนวณค่าไฟ PEA 2569 สำหรับผู้ใช้ไฟส่วนภูมิภาค ใช้หน่วย kWh ค่า Ft 0.1623 บาท/หน่วย ค่าบริการ และ VAT 7% พร้อมตัวอย่างบ้านใช้ไฟ 300 หน่วยประมาณ 1,277.41 บาท';
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://www.kamnuanlek.com').replace(/\/$/, '');
const canonical = `${siteUrl}/บทความ/คำนวณค่าไฟ-pea-2569/`;
const affiliateUrl = '/go/roojai-partners/?sub_id=article-pea-electricity-2569';

const faqData = [
  {
    question: 'คำนวณค่าไฟ PEA 2569 ต้องใช้อะไรบ้าง?',
    answer:
      'ต้องใช้จำนวนหน่วยไฟ kWh จากบิลหรือมิเตอร์ ค่า Ft ของรอบบิล ค่าบริการรายเดือน และ VAT 7% จากนั้นคำนวณค่าไฟฐานตามขั้นบันไดก่อนบวกค่า Ft และภาษี',
  },
  {
    question: 'ค่า Ft PEA รอบพฤษภาคม-สิงหาคม 2569 เท่าไร?',
    answer:
      'ค่า Ft ที่ใช้ในตัวอย่างนี้คือ 0.1623 บาทต่อหน่วย สำหรับรอบพฤษภาคม-สิงหาคม 2569 ควรตรวจประกาศ PEA หรือ กกพ. อีกครั้งก่อนใช้กับบิลจริง',
  },
  {
    question: 'บ้านต่างจังหวัดใช้ไฟ 300 หน่วย ค่าไฟประมาณเท่าไร?',
    answer:
      'ถ้าใช้ไฟ 300 หน่วย ค่า Ft 0.1623 บาทต่อหน่วย และคิด VAT 7% ยอดประมาณการคือ 1,277.41 บาท โดยยอดจริงอาจต่างจากการปัดเศษหรือประเภทผู้ใช้ไฟ',
  },
];
---

<BlogPostLayout title={title} description={description} publishDate="2026-05-30" modifiedDate="2026-05-30" canonical={canonical} faqData={faqData}>
  <h1>คำนวณค่าไฟ PEA 2569: ค่า Ft ล่าสุด สูตรบิลบ้าน และตัวอย่าง 300 หน่วย</h1>

  <section class="not-prose my-6 rounded-xl border border-emerald-200 bg-emerald-50 p-4">
    <p class="text-sm font-semibold text-emerald-800">คำตอบเร็ว</p>
    <p class="mt-1 text-lg font-bold text-emerald-950">
      คำนวณค่าไฟ PEA ให้เริ่มจากหน่วย kWh จริง แล้วบวกค่าไฟฐาน + ค่าบริการ + ค่า Ft 0.1623 บาท/หน่วย ก่อนคิด VAT 7%
    </p>
    <p class="mt-2 text-sm text-emerald-900">
      ตัวอย่างบ้านใช้ไฟ 300 หน่วย รอบ Ft พฤษภาคม-สิงหาคม 2569 จะได้ค่าไฟประมาณ 1,277.41 บาท รวม VAT แล้ว ตรวจค่า Ft ล่าสุดเมื่อ 30 พฤษภาคม 2569
    </p>
  </section>

  <p>
    หน้านี้ทำไว้สำหรับคนที่ค้นหา <strong>คำนวณค่าไฟ PEA</strong> โดยเฉพาะ ไม่ว่าจะอยู่ต่างจังหวัด บ้านเดี่ยว ทาวน์เฮาส์
    หรือคอนโดที่ใช้บริการการไฟฟ้าส่วนภูมิภาค หลักการสำคัญคืออย่าเอาหน่วยไฟคูณราคาต่อหน่วยเดียวทั้งบิล
    เพราะค่าไฟบ้านไทยมีค่าไฟฐานแบบขั้นบันได ค่า Ft ค่าบริการ และ VAT รวมอยู่ด้วย
  </p>

  <ArticleCalculatorCTA
    title="คำนวณค่าไฟ PEA จากหน่วยจริง"
    description="ใส่จำนวน kWh เลือก PEA/MEA ปรับค่า Ft และดูยอดรวม VAT ได้ในหน้าเดียว"
    href="/คำนวณค่าไฟฟ้า/"
    buttonLabel="เปิดเครื่องคำนวณค่าไฟ PEA"
  />

  <AffiliateCard
    category="insurance"
    affiliateUrl={affiliateUrl}
    partnerName="Roojai Partners"
    headline="คำนวณค่าไฟแล้ว วางแผนงบรายเดือนต่อ"
    subtext="เมื่อรู้ค่าไฟบ้านแล้ว ใช้ตัวเลขนี้จัดงบครัวเรือนและตรวจข้อเสนอพาร์ทเนอร์ที่เกี่ยวข้อง"
    ctaText="ดูข้อเสนอจาก Roojai"
    isVisible={true}
  />

  <h2>สูตรคำนวณค่าไฟ PEA แบบใช้งานจริง</h2>
  <ol>
    <li>อ่านหน่วยไฟ kWh จากบิลหรือมิเตอร์รอบล่าสุด</li>
    <li>คำนวณค่าไฟฐานตามช่วงขั้นบันไดของบ้านอยู่อาศัย</li>
    <li>บวกค่าบริการรายเดือนตามกลุ่มผู้ใช้ไฟ</li>
    <li>บวกค่า Ft = หน่วยไฟ x ค่า Ft ของรอบบิล</li>
    <li>คิด VAT 7% จากยอดรวมก่อนภาษี</li>
  </ol>

  <h2>ตัวอย่างคำนวณค่าไฟ PEA 300 หน่วย</h2>
  <div class="not-prose my-4 overflow-x-auto">
    <table class="w-full min-w-[560px] border-collapse border border-gray-200 text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="border border-gray-200 px-3 py-2 text-left">รายการ</th>
          <th class="border border-gray-200 px-3 py-2 text-right">ยอดประมาณการ</th>
        </tr>
      </thead>
      <tbody>
        <tr><td class="border border-gray-200 px-3 py-2">ค่าไฟฐาน 300 หน่วย</td><td class="border border-gray-200 px-3 py-2 text-right">1,120.53 บาท</td></tr>
        <tr><td class="border border-gray-200 px-3 py-2">ค่าบริการรายเดือน</td><td class="border border-gray-200 px-3 py-2 text-right">24.62 บาท</td></tr>
        <tr><td class="border border-gray-200 px-3 py-2">ค่า Ft 0.1623 x 300</td><td class="border border-gray-200 px-3 py-2 text-right">48.69 บาท</td></tr>
        <tr><td class="border border-gray-200 px-3 py-2">รวมก่อน VAT</td><td class="border border-gray-200 px-3 py-2 text-right">1,193.84 บาท</td></tr>
        <tr><td class="border border-gray-200 px-3 py-2">VAT 7%</td><td class="border border-gray-200 px-3 py-2 text-right">83.57 บาท</td></tr>
        <tr class="bg-emerald-50"><td class="border border-gray-200 px-3 py-2"><strong>ยอดรวมโดยประมาณ</strong></td><td class="border border-gray-200 px-3 py-2 text-right"><strong>1,277.41 บาท</strong></td></tr>
      </tbody>
    </table>
  </div>

  <h2>คำค้นที่ควรใช้หน้านี้คู่กับเครื่องคำนวณ</h2>
  <ul>
    <li>คำนวณค่าไฟ PEA</li>
    <li>ค่าไฟ PEA 2569</li>
    <li>บ้านใช้ไฟ 300 หน่วย ค่าไฟเท่าไร</li>
    <li>1 kWh เท่ากับกี่บาท</li>
    <li>ค่าไฟห้องเช่า หน่วยละกี่บาท</li>
  </ul>

  <h2>อ่านต่อในกลุ่มค่าไฟฟ้า</h2>
  <ul>
    <li><a href="/คำนวณค่าไฟฟ้า/">คำนวณค่าไฟฟ้า PEA/MEA</a></li>
    <li><a href="/บทความ/1-kwh-เท่ากับกี่บาท-2569/">1 kWh เท่ากับกี่บาท 2569</a></li>
    <li><a href="/บทความ/บ้านใช้ไฟ-300-หน่วย-ค่าไฟเท่าไร/">บ้านใช้ไฟ 300 หน่วย ค่าไฟเท่าไร</a></li>
    <li><a href="/บทความ/บ้านใช้ไฟ-500-หน่วย-ค่าไฟเท่าไร-2569/">บ้านใช้ไฟ 500 หน่วย ค่าไฟเท่าไร</a></li>
    <li><a href="/บทความ/ค่าไฟห้องเช่าหน่วยละกี่บาท-2569/">ค่าไฟห้องเช่า หน่วยละกี่บาท 2569</a></li>
    <li><a href="/บทความ/ค่าไฟฟ้า-mea-กับ-pea/">ค่าไฟฟ้า MEA กับ PEA ต่างกันอย่างไร</a></li>
  </ul>

  <h2>แหล่งข้อมูลทางการ</h2>
  <ul>
    <li><a href="https://www.pea.co.th/our-services/tariff/ft" target="_blank" rel="noopener noreferrer">PEA: ค่า Ft</a></li>
    <li><a href="https://www.pea.co.th/our-services/tariff/ft-statistics" target="_blank" rel="noopener noreferrer">PEA: สถิติค่า Ft</a></li>
    <li><a href="https://www.erc.or.th/th/automatic" target="_blank" rel="noopener noreferrer">กกพ.: อัตราค่าไฟฟ้าโดยอัตโนมัติ</a></li>
  </ul>

  <h2>คำถามที่พบบ่อย</h2>
  {faqData.map((faq) => (
    <details class="mb-3 rounded-lg border border-gray-200 bg-white">
      <summary class="cursor-pointer px-4 py-3 font-medium text-gray-900">{faq.question}</summary>
      <p class="px-4 pb-4 text-sm text-gray-600">{faq.answer}</p>
    </details>
  ))}
</BlogPostLayout>
