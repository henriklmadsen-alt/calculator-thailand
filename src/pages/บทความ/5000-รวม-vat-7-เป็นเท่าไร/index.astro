---
import BlogPostLayout from '../../../layouts/BlogPostLayout.astro';
import ArticleCalculatorCTA from '../../../components/templates/ArticleCalculatorCTA.astro';

const title = '5,000 รวม VAT 7% เป็นเท่าไร ถอด VAT ได้เท่าไร | Kamnuanlek';
const description = '5,000 รวม VAT 7% ถอดภาษีได้ยอดก่อน VAT 4,672.90 บาท และ VAT 327.10 บาท พร้อมสูตรหาร 1.07 และเครื่องคำนวณ VAT';
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://www.kamnuanlek.com').replace(/\/$/, '');
const canonical = `${siteUrl}/บทความ/5000-รวม-vat-7-เป็นเท่าไร/`;
const checkedDate = '30 พฤษภาคม 2569';

const faqData = [
  {
    question: '5,000 รวม VAT 7% ถอด VAT ได้เท่าไร?',
    answer: 'ยอดก่อน VAT = 5,000 / 1.07 = 4,672.90 บาท และ VAT = 327.10 บาท',
  },
  {
    question: 'ถ้า 5,000 ยังไม่รวม VAT ต้องจ่ายเท่าไร?',
    answer: 'ถ้า 5,000 เป็นยอดก่อน VAT ให้บวก 7% จะได้ยอดรวม 5,350 บาท',
  },
  {
    question: 'ทำไมถอด VAT ต้องหาร 1.07?',
    answer: 'เพราะราคาที่รวม VAT แล้วเท่ากับราคาก่อนภาษี x 1.07 จึงต้องหาร 1.07 เพื่อย้อนกลับไปหายอดก่อนภาษี',
  },
];
---

<BlogPostLayout title={title} description={description} publishDate="2026-05-28" modifiedDate="2026-05-30" canonical={canonical} faqData={faqData}>
  <h1>5,000 รวม VAT 7% เป็นเท่าไร ถอด VAT ได้เท่าไร</h1>

  <section class="not-prose my-6 rounded-xl border border-sky-200 bg-sky-50 p-4">
    <p class="text-sm font-semibold text-sky-800">คำตอบเร็ว</p>
    <p class="mt-1 text-lg font-bold text-sky-950">ถ้า 5,000 บาทรวม VAT แล้ว ยอดก่อน VAT คือ 4,672.90 บาท และ VAT คือ 327.10 บาท</p>
    <p class="mt-1 text-sm text-sky-900">ตรวจอัตรา VAT 7% ล่าสุดเมื่อ {checkedDate}</p>
  </section>

  <ArticleCalculatorCTA
    title="คำนวณ VAT 7% จากยอดอื่น"
    description="เลือกบวก VAT หรือถอด VAT แล้วกรอกยอดรวมได้ทันที"
    href="/คำนวณภาษีมูลค่าเพิ่ม/"
    buttonLabel="เปิดเครื่องคำนวณ VAT"
  />

  <h2>สูตรถอด VAT จาก 5,000 บาท</h2>
  <ol>
    <li>ยอดก่อน VAT = 5,000 / 1.07 = 4,672.90 บาท</li>
    <li>VAT = 5,000 - 4,672.90 = 327.10 บาท</li>
    <li>ตรวจกลับ: 4,672.90 x 1.07 = ประมาณ 5,000 บาท</li>
  </ol>

  <h2>ถ้า 5,000 ยังไม่รวม VAT</h2>
  <p>ให้ใช้สูตร 5,000 x 1.07 = 5,350 บาท และ VAT เท่ากับ 350 บาท</p>

  <ul>
    <li><a href="/บทความ/10000-หาร-1-07-ถอด-vat/">10,000 หาร 1.07 ถอด VAT</a></li>
    <li><a href="/บทความ/ถอด-vat-จากราคารวม-สูตร-1-07/">ถอด VAT จากราคารวม สูตร 1.07</a></li>
    <li><a href="/บทความ/1070-หาร-1-07-ถอด-vat/">1,070 หาร 1.07 ถอด VAT</a></li>
    <li><a href="/บทความ/1000-บวก-vat-7-เป็นเท่าไร/">1,000 บวก VAT 7% เป็นเท่าไร</a></li>
    <li><a href="/คำนวณภาษีมูลค่าเพิ่ม/">คำนวณภาษีมูลค่าเพิ่ม</a></li>
    <li><a href="/คำนวณเปอร์เซ็นต์/">คำนวณเปอร์เซ็นต์</a></li>
  </ul>

  <h2>แหล่งข้อมูลทางการ</h2>
  <ul>
    <li><a href="https://www.rd.go.th/region/08/chiangrai/265/3664.html" target="_blank" rel="noopener noreferrer">กรมสรรพากร: ขยาย VAT 7% ถึง 30 กันยายน 2569</a></li>
    <li><a href="https://www.rd.go.th/59935.html" target="_blank" rel="noopener noreferrer">กรมสรรพากร: โครงสร้างภาษีมูลค่าเพิ่มรวม 7%</a></li>
  </ul>
</BlogPostLayout>
