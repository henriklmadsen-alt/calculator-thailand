---
import BlogPostLayout from '../../../layouts/BlogPostLayout.astro';
import ArticleCalculatorCTA from '../../../components/templates/ArticleCalculatorCTA.astro';

const title = 'โอที 1.5 เท่า คิดยังไง 2569 | Kamnuanlek';
const description = 'โอที 1.5 เท่า คิดยังไง สูตรค่าแรงต่อชั่วโมง x 1.5 x ชั่วโมง OT พร้อมตัวอย่างเงินเดือน 20,000 และเครื่องคำนวณค่าโอที';
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://www.kamnuanlek.com').replace(/\/$/, '');
const canonical = `${siteUrl}/บทความ/โอที-1-5-เท่า-คิดยังไง-2569/`;

const faqData = [
  {
    question: 'โอที 1.5 เท่า คิดยังไง?',
    answer: 'คำนวณค่าแรงต่อชั่วโมงจากเงินเดือนหารด้วยชั่วโมงทำงานปกติต่อเดือน แล้วคูณ 1.5 และคูณจำนวนชั่วโมง OT',
  },
  {
    question: 'เงินเดือน 20,000 ทำ OT 10 ชั่วโมงได้เท่าไร?',
    answer: 'ถ้าทำงาน 26 วัน วันละ 8 ชั่วโมง ค่าแรงต่อชั่วโมงประมาณ 96.15 บาท ค่า OT 1.5 เท่า 10 ชั่วโมงประมาณ 1,442.31 บาท',
  },
  {
    question: 'โอที 1.5 เท่าใช้กับวันไหน?',
    answer: 'โดยทั่วไปใช้กับการทำงานล่วงเวลาในวันทำงานปกติ ส่วนวันหยุดต้องแยกกรณี 2 เท่า หรือ 3 เท่าตามลักษณะชั่วโมงทำงาน',
  },
];
---

<BlogPostLayout title={title} description={description} publishDate="2026-05-28" modifiedDate="2026-05-28" canonical={canonical} faqData={faqData}>
  <h1>โอที 1.5 เท่า คิดยังไง 2569</h1>

  <section class="not-prose my-6 rounded-xl border border-indigo-200 bg-indigo-50 p-4">
    <p class="text-sm font-semibold text-indigo-800">คำตอบเร็ว</p>
    <p class="mt-1 text-lg font-bold text-indigo-950">OT 1.5 เท่า = ค่าแรงต่อชั่วโมง x 1.5 x จำนวนชั่วโมงล่วงเวลา</p>
  </section>

  <ArticleCalculatorCTA
    title="คำนวณค่าโอทีจากเงินเดือนจริง"
    description="กรอกเงินเดือน วันทำงาน และชั่วโมง OT เพื่อแยกยอด 1.5x 2x 3x"
    href="/คำนวณค่าโอที/"
    buttonLabel="เปิดเครื่องคำนวณค่าโอที"
  />

  <h2>สูตรโอที 1.5 เท่า</h2>
  <ol>
    <li>ค่าแรงต่อชั่วโมง = เงินเดือน / (วันทำงานต่อเดือน x ชั่วโมงทำงานต่อวัน)</li>
    <li>ค่า OT = ค่าแรงต่อชั่วโมง x 1.5 x ชั่วโมง OT</li>
  </ol>

  <h2>ตัวอย่างเงินเดือน 20,000 ทำ OT 10 ชั่วโมง</h2>
  <p>ถ้าทำงาน 26 วันต่อเดือน วันละ 8 ชั่วโมง ค่าแรงต่อชั่วโมง = 20,000 / 208 = 96.15 บาท</p>
  <p>ค่า OT 1.5 เท่า 10 ชั่วโมง = 96.15 x 1.5 x 10 = 1,442.31 บาท</p>

  <ul>
    <li><a href="/คำนวณค่าโอที/">คำนวณค่าโอที</a></li>
    <li><a href="/คำนวณเงินเดือนสุทธิ/">คำนวณเงินเดือนสุทธิ</a></li>
    <li><a href="/บทความ/เงินเดือน-20000-โอที-10-ชั่วโมง/">เงินเดือน 20,000 OT 10 ชั่วโมง</a></li>
  </ul>
</BlogPostLayout>
