---
import BlogPostLayout from '../../../layouts/BlogPostLayout.astro';
import ArticleCalculatorCTA from '../../../components/templates/ArticleCalculatorCTA.astro';

const title = '1,000 บวก VAT 7% เป็นเท่าไร? ราคารวม VAT + ภาษี | Kamnuanlek';
const description = '1,000 บวก VAT 7% เท่ากับ 1,070 บาท โดย VAT คือ 70 บาท พร้อมสูตรคูณ 1.07 สูตรถอดกลับ และเครื่องคำนวณ VAT ฟรี';
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://www.kamnuanlek.com').replace(/\/$/, '');
const canonical = `${siteUrl}/บทความ/1000-บวก-vat-7-เป็นเท่าไร/`;
const checkedDate = '30 พฤษภาคม 2569';

const faqData = [
  {
    question: '1,000 บวก VAT 7% เป็นเท่าไร?',
    answer: '1,000 x 1.07 = 1,070 บาท โดย VAT 7% คือ 70 บาท',
  },
  {
    question: 'ถ้า 1,000 บาทรวม VAT แล้ว ถอด VAT ได้เท่าไร?',
    answer: 'ถ้า 1,000 บาทเป็นราคารวม VAT แล้ว ราคาก่อน VAT = 1,000 / 1.07 = 934.58 บาท และ VAT = 65.42 บาท',
  },
  {
    question: 'สูตรบวก VAT ใช้ 1.07 หรือ 0.07?',
    answer: 'ใช้ x 0.07 เมื่อต้องการหาเฉพาะจำนวน VAT และใช้ x 1.07 เมื่อต้องการราคารวม VAT',
  },
];
---

<BlogPostLayout title={title} description={description} publishDate="2026-05-30" modifiedDate="2026-05-30" canonical={canonical} faqData={faqData}>
  <h1>1,000 บวก VAT 7% เป็นเท่าไร?</h1>

  <section class="not-prose my-6 rounded-xl border border-emerald-200 bg-emerald-50 p-4">
    <p class="text-sm font-semibold text-emerald-800">คำตอบเร็ว</p>
    <p class="mt-1 text-xl font-bold text-emerald-950">1,000 x 1.07 = 1,070 บาท</p>
    <p class="mt-1 text-sm text-emerald-900">VAT 7% คือ 70 บาท ตรวจอัตรา VAT ล่าสุดเมื่อ {checkedDate}</p>
  </section>

  <p>
    ถ้าราคา 1,000 บาทเป็นราคาก่อนภาษี การบวก VAT 7% ให้คูณ 1.07 โดยตรง
    เหมาะกับการทำใบเสนอราคา ออกใบกำกับภาษี หรือเช็กราคาขายก่อนส่งให้ลูกค้า
  </p>

  <ArticleCalculatorCTA
    title="คำนวณ VAT 7% จากยอดอื่น"
    description="บวก VAT ถอด VAT และคำนวณหลายรายการได้ในหน้าเดียว"
    href="/คำนวณภาษีมูลค่าเพิ่ม/"
    buttonLabel="เปิดเครื่องคำนวณ VAT"
  />

  <h2>วิธีคิด 1,000 บวก VAT</h2>
  <ol>
    <li>ราคาก่อน VAT = 1,000 บาท</li>
    <li>VAT 7% = 1,000 x 0.07 = 70 บาท</li>
    <li>ราคารวม VAT = 1,000 + 70 = 1,070 บาท</li>
  </ol>

  <h2>ถ้า 1,000 บาทเป็นราคารวม VAT แล้ว</h2>
  <p>
    กรณีนี้ต้องถอด VAT ไม่ใช่บวก VAT: 1,000 ÷ 1.07 = 934.58 บาทก่อน VAT และ VAT คือ 65.42 บาท
  </p>

  <h2>ตัวอย่างยอดใกล้เคียง</h2>
  <table class="w-full text-sm border-collapse my-4">
    <thead>
      <tr class="border-b border-gray-200 text-left">
        <th class="py-2 pr-2">ราคาก่อน VAT</th>
        <th class="py-2 pr-2 text-right">VAT 7%</th>
        <th class="py-2 text-right">ราคารวม VAT</th>
      </tr>
    </thead>
    <tbody>
      <tr class="border-b border-gray-100"><td class="py-2 pr-2">500</td><td class="py-2 pr-2 text-right">35</td><td class="py-2 text-right">535</td></tr>
      <tr class="border-b border-gray-100"><td class="py-2 pr-2">1,000</td><td class="py-2 pr-2 text-right">70</td><td class="py-2 text-right">1,070</td></tr>
      <tr><td class="py-2 pr-2">10,000</td><td class="py-2 pr-2 text-right">700</td><td class="py-2 text-right">10,700</td></tr>
    </tbody>
  </table>

  <h2>อ่านต่อในกลุ่ม VAT</h2>
  <ul>
    <li><a href="/คำนวณภาษีมูลค่าเพิ่ม/">คำนวณ VAT 7%</a></li>
    <li><a href="/บทความ/1070-หาร-1-07-ถอด-vat/">1,070 หาร 1.07 ถอด VAT</a></li>
    <li><a href="/บทความ/10000-หาร-1-07-ถอด-vat/">10,000 หาร 1.07 ถอด VAT</a></li>
    <li><a href="/บทความ/ถอด-vat-จากราคารวม-สูตร-1-07/">ถอด VAT จากราคารวม สูตร 1.07</a></li>
  </ul>

  <h2>แหล่งข้อมูลทางการ</h2>
  <ul>
    <li><a href="https://www.rd.go.th/region/08/chiangrai/265/3664.html" target="_blank" rel="noopener noreferrer">กรมสรรพากร: ขยาย VAT 7% ถึง 30 กันยายน 2569</a></li>
    <li><a href="https://www.rd.go.th/59935.html" target="_blank" rel="noopener noreferrer">กรมสรรพากร: โครงสร้างภาษีมูลค่าเพิ่มรวม 7%</a></li>
  </ul>

  <h2>คำถามที่พบบ่อย</h2>
  {faqData.map((faq) => (
    <details class="mb-3 rounded-lg border border-gray-200 bg-white">
      <summary class="cursor-pointer px-4 py-3 font-medium text-gray-900">{faq.question}</summary>
      <p class="px-4 pb-4 text-sm text-gray-600">{faq.answer}</p>
    </details>
  ))}
</BlogPostLayout>
