---
import BlogPostLayout from '../../../layouts/BlogPostLayout.astro';
import ArticleCalculatorCTA from '../../../components/templates/ArticleCalculatorCTA.astro';

const title = 'เกิดปี 2535 อายุเท่าไรในปี 2569 | Kamnuanlek';
const description = 'เกิดปี 2535 อายุเท่าไรในปี 2569 วิธีคิดอายุจาก พ.ศ. เป็น ค.ศ. และตรวจว่าเกิดวันเกิดแล้วหรือยัง พร้อมเครื่องคำนวณอายุ';
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://www.kamnuanlek.com').replace(/\/$/, '');
const canonical = `${siteUrl}/บทความ/เกิดปี-2535-อายุเท่าไร-2569/`;

const faqData = [
  {
    question: 'เกิดปี 2535 อายุเท่าไรในปี 2569?',
    answer: 'ปี 2569 ลบ 2535 ได้ 34 ปี แต่ถ้ายังไม่ถึงวันเกิดในปี 2569 อายุจริงจะยังเป็น 33 ปี',
  },
  {
    question: 'ทำไมต้องดูวันเกิดด้วย?',
    answer: 'เพราะอายุเต็มปีจะเพิ่มในวันเกิดเท่านั้น ถ้าใช้กับเอกสาร สมัครงาน หรือประกัน ควรคำนวณจากวัน เดือน ปีเกิดจริง',
  },
  {
    question: 'พ.ศ. 2535 คือ ค.ศ. อะไร?',
    answer: 'พ.ศ. 2535 เท่ากับ ค.ศ. 1992 โดยนำ พ.ศ. ลบ 543',
  },
];
---

<BlogPostLayout title={title} description={description} publishDate="2026-05-28" modifiedDate="2026-05-28" canonical={canonical} faqData={faqData}>
  <h1>เกิดปี 2535 อายุเท่าไรในปี 2569</h1>

  <section class="not-prose my-6 rounded-xl border border-blue-200 bg-blue-50 p-4">
    <p class="text-sm font-semibold text-blue-800">คำตอบเร็ว</p>
    <p class="mt-1 text-lg font-bold text-blue-950">เกิดปี 2535 จะอายุ 34 ปีในปี 2569 ถ้าวันเกิดปีนี้ผ่านแล้ว และอายุ 33 ปีถ้ายังไม่ถึงวันเกิด</p>
  </section>

  <p>
    การเอา 2569 - 2535 ได้ 34 เป็นเพียงอายุแบบคร่าว ๆ เท่านั้น ถ้าต้องใช้กับเอกสารหรือแบบฟอร์มที่ต้องระบุอายุเต็ม
    ควรกรอกวันเกิดจริงเพื่อให้ระบบนับปี เดือน และวันได้ถูกต้อง
  </p>

  <ArticleCalculatorCTA
    title="คำนวณอายุจากวันเกิดจริง"
    description="กรอกวัน เดือน ปีเกิด และเลือก พ.ศ./ค.ศ. เพื่อดูอายุเป็นปี เดือน วัน"
    href="/คำนวณอายุ/"
    buttonLabel="เปิดเครื่องคำนวณอายุ"
  />

  <h2>วิธีคิดอายุคนเกิดปี 2535</h2>
  <ol>
    <li>เริ่มจาก 2569 - 2535 = 34</li>
    <li>ถ้าวันเกิดในปี 2569 ผ่านแล้ว อายุเต็มคือ 34 ปี</li>
    <li>ถ้ายังไม่ถึงวันเกิด อายุเต็มคือ 33 ปี</li>
  </ol>

  <h2>ลิงก์ที่เกี่ยวข้อง</h2>
  <ul>
    <li><a href="/คำนวณอายุ/">คำนวณอายุวันนี้</a></li>
    <li><a href="/บทความ/คำนวณอายุวันนี้-จากวันเกิด/">คำนวณอายุวันนี้จากวันเกิด</a></li>
    <li><a href="/บทความ/คำนวณอายุ-จากวันเกิด-2569-ปี-เดือน-วัน/">คำนวณอายุจากวันเกิด 2569</a></li>
  </ul>
</BlogPostLayout>
