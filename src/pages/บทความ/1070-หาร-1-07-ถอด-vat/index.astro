---
import BlogPostLayout from '../../../layouts/BlogPostLayout.astro';
import ArticleCalculatorCTA from '../../../components/templates/ArticleCalculatorCTA.astro';

const title = '1,070 หาร 1.07 ถอด VAT เท่ากับเท่าไร? ราคาก่อน VAT + ภาษี | Kamnuanlek';
const description = '1,070 หาร 1.07 เท่ากับ 1,000 บาทก่อน VAT และ VAT คือ 70 บาท พร้อมสูตรถอด VAT 7% และเครื่องคำนวณ VAT ฟรี';
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://www.kamnuanlek.com').replace(/\/$/, '');
const canonical = `${siteUrl}/บทความ/1070-หาร-1-07-ถอด-vat/`;
const checkedDate = '30 พฤษภาคม 2569';

const faqData = [
  {
    question: '1,070 หาร 1.07 เท่ากับเท่าไร?',
    answer: '1,070 ÷ 1.07 = 1,000 บาท เป็นราคาก่อน VAT และ VAT คือ 70 บาท',
  },
  {
    question: '1,070 บาทเป็นราคารวม VAT ใช่ไหม?',
    answer: 'ถ้าราคาก่อน VAT คือ 1,000 บาท แล้วบวก VAT 7% จะได้ราคารวม 1,070 บาท',
  },
  {
    question: 'ทำไมถอด VAT ต้องหาร 1.07?',
    answer: 'เพราะราคารวม VAT = ราคาก่อน VAT x 1.07 การถอดกลับจึงใช้ราคารวม VAT ÷ 1.07',
  },
];
---

<BlogPostLayout title={title} description={description} publishDate="2026-05-30" modifiedDate="2026-05-30" canonical={canonical} faqData={faqData}>
  <h1>1,070 หาร 1.07 ถอด VAT เท่ากับเท่าไร?</h1>

  <section class="not-prose my-6 rounded-xl border border-indigo-200 bg-indigo-50 p-4">
    <p class="text-sm font-semibold text-indigo-800">คำตอบเร็ว</p>
    <p class="mt-1 text-xl font-bold text-indigo-950">1,070 ÷ 1.07 = 1,000 บาทก่อน VAT</p>
    <p class="mt-1 text-sm text-indigo-900">VAT 7% = 70 บาท และราคารวม VAT = 1,070 บาท ตรวจอัตรา VAT ล่าสุดเมื่อ {checkedDate}</p>
  </section>

  <p>
    คำค้น 1,070 หาร 1.07 มักใช้ตอนต้องการถอด VAT จากราคารวมภาษีแล้ว
    ถ้าราคารวม VAT คือ 1,070 บาท ยอดก่อน VAT จะเท่ากับ 1,000 บาทพอดี
  </p>

  <ArticleCalculatorCTA
    title="ถอด VAT จากราคารวมทุกยอด"
    description="กรอกยอดรวม VAT แล้วดูยอดก่อนภาษีและจำนวน VAT ได้ทันที"
    href="/คำนวณภาษีมูลค่าเพิ่ม/"
    buttonLabel="เปิดเครื่องคำนวณ VAT"
  />

  <h2>วิธีคำนวณ</h2>
  <ol>
    <li>ราคารวม VAT = 1,070 บาท</li>
    <li>ราคาก่อน VAT = 1,070 ÷ 1.07 = 1,000 บาท</li>
    <li>VAT = 1,070 - 1,000 = 70 บาท</li>
  </ol>

  <h2>ตรวจกลับด้วยสูตรบวก VAT</h2>
  <p>
    เมื่อนำราคาก่อน VAT 1,000 บาทไปคูณ 1.07 จะได้ 1,070 บาท จึงยืนยันได้ว่าการถอด VAT ถูกต้อง
  </p>

  <h2>อ่านต่อในกลุ่ม VAT</h2>
  <ul>
    <li><a href="/บทความ/1000-บวก-vat-7-เป็นเท่าไร/">1,000 บวก VAT 7% เป็นเท่าไร</a></li>
    <li><a href="/บทความ/10000-หาร-1-07-ถอด-vat/">10,000 หาร 1.07 ถอด VAT</a></li>
    <li><a href="/บทความ/5000-รวม-vat-7-เป็นเท่าไร/">5,000 รวม VAT 7% ถอดเท่าไร</a></li>
    <li><a href="/บทความ/ภาษีมูลค่าเพิ่ม-7-คิดยังไง-สูตรบวกภาษี-ถอดภาษี-ตั้งราคาขายให้ไม่ขาดทุน/">VAT 7% คิดยังไง</a></li>
  </ul>

  <h2>แหล่งข้อมูลทางการ</h2>
  <ul>
    <li><a href="https://www.rd.go.th/region/08/chiangrai/265/3664.html" target="_blank" rel="noopener noreferrer">กรมสรรพากร: ขยาย VAT 7% ถึง 30 กันยายน 2569</a></li>
    <li><a href="https://www.rd.go.th/59935.html" target="_blank" rel="noopener noreferrer">กรมสรรพากร: โครงสร้างภาษีมูลค่าเพิ่มรวม 7%</a></li>
  </ul>

  <h2>คำถามที่พบบ่อย</h2>
  {faqData.map((faq) => (
    <details class="mb-3 rounded-lg border border-gray-200 bg-white">
      <summary class="cursor-pointer px-4 py-3 font-medium text-gray-900">{faq.question}</summary>
      <p class="px-4 pb-4 text-sm text-gray-600">{faq.answer}</p>
    </details>
  ))}
</BlogPostLayout>
