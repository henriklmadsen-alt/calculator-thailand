---
import BlogPostLayout from '../../../layouts/BlogPostLayout.astro';
import ArticleCalculatorCTA from '../../../components/templates/ArticleCalculatorCTA.astro';

const title = 'คำนวณอายุวันนี้จากวันเกิด เป็นปี เดือน วัน | Kamnuanlek';
const description = 'วิธีคำนวณอายุวันนี้จากวันเกิดเป็นปี เดือน วัน แปลง พ.ศ. เป็น ค.ศ. พร้อมตัวอย่าง ณ วันที่ 26 พฤษภาคม 2569 และเครื่องคำนวณอายุฟรี';
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://www.kamnuanlek.com').replace(/\/$/, '');
const canonical = `${siteUrl}/บทความ/คำนวณอายุวันนี้-จากวันเกิด/`;

const faqData = [
  {
    question: 'คำนวณอายุวันนี้ต้องใช้ข้อมูลอะไร?',
    answer: 'ใช้วัน เดือน ปีเกิด และวันที่ต้องการเทียบ ถ้าไม่กำหนดวันที่ ระบบจะใช้วันที่ปัจจุบันของเครื่องผู้ใช้',
  },
  {
    question: 'พ.ศ. แปลงเป็น ค.ศ. อย่างไร?',
    answer: 'นำปี พ.ศ. ลบ 543 เช่น พ.ศ. 2539 เท่ากับ ค.ศ. 1996',
  },
  {
    question: 'ทำไมอายุแบบปีเต็มกับจำนวนวันรวมไม่เหมือนกัน?',
    answer: 'อายุปีเต็มนับจากวันเกิดครบรอบปี ส่วนจำนวนวันรวมนับทุกวันตั้งแต่วันเกิดถึงวันที่เทียบ จึงใช้คนละมุมมอง',
  },
];
---

<BlogPostLayout
  title={title}
  description={description}
  publishDate="2026-05-26"
  modifiedDate="2026-05-26"
  canonical={canonical}
  faqData={faqData}
>
  <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4">คำนวณอายุวันนี้จากวันเกิด</h1>

  <section class="not-prose my-6 rounded-xl border border-violet-200 bg-violet-50 p-4">
    <p class="text-sm font-semibold text-violet-800">คำตอบเร็ว</p>
    <p class="mt-1 text-lg font-bold text-violet-950">
      ให้เอาวันที่ต้องการเทียบลบวันเกิด แล้วแยกผลเป็นปี เดือน วัน ถ้าใช้ พ.ศ. ให้ลบ 543 ก่อนคำนวณ
    </p>
    <p class="mt-1 text-sm text-violet-900">ตัวอย่างในบทความนี้อ้างอิงวันที่ 26 พฤษภาคม 2569</p>
  </section>

  <p>
    การคำนวณอายุวันนี้ไม่ใช่แค่เอาปีปัจจุบันลบปีเกิด เพราะต้องดูด้วยว่าวันเกิดในปีนี้ผ่านไปแล้วหรือยัง เครื่องคำนวณจึงควรนับเป็นปี เดือน วัน เพื่อให้ใช้กับเอกสาร สมัครงาน ประกัน หรือการวางแผนครอบครัวได้แม่นยำขึ้น
  </p>

  <ArticleCalculatorCTA
    title="คำนวณอายุจากวันเกิดทันที"
    description="รองรับ พ.ศ./ค.ศ. แสดงอายุปี เดือน วัน วันเกิดครั้งหน้า ราศี และ Generation"
    href="/คำนวณอายุ/"
    buttonLabel="เปิดเครื่องคำนวณอายุ"
  />

  <h2>สูตรคิดแบบเข้าใจง่าย</h2>
  <ol>
    <li>แปลงปีเกิดเป็น ค.ศ. ถ้ากรอกเป็น พ.ศ.</li>
    <li>เทียบวันเกิดกับวันที่ต้องการคำนวณ</li>
    <li>ถ้าวันเกิดปีนี้ยังไม่ถึง ให้ลบอายุปีเต็มลง 1 ปี</li>
    <li>คำนวณเดือนและวันที่เหลือตามปฏิทินจริง</li>
  </ol>

  <h2>ตัวอย่าง</h2>
  <p>
    ถ้าเกิดวันที่ 1 มกราคม 2539 ให้แปลงเป็น 1 มกราคม 1996 ก่อน จากนั้นเทียบกับวันที่ 26 พฤษภาคม 2569 หรือ 26 พฤษภาคม 2026 จะได้อายุ 30 ปี 4 เดือน 25 วันโดยประมาณ
  </p>

  <h2>ลิงก์ที่ควรใช้ต่อ</h2>
  <ul>
    <li><a href="/คำนวณอายุ/">คำนวณอายุ</a></li>
    <li><a href="/คำนวณวันคลอด/">คำนวณวันคลอด</a></li>
    <li><a href="/บทความ/คำนวณอายุ-จากวันเกิด-2569-ปี-เดือน-วัน/">คำนวณอายุจากวันเกิด 2569 แบบละเอียด</a></li>
  </ul>

  <h2>คำถามที่พบบ่อย</h2>
  {faqData.map((faq) => (
    <details class="mb-3 rounded-lg border border-gray-200 bg-white">
      <summary class="cursor-pointer px-4 py-3 font-medium text-gray-900">{faq.question}</summary>
      <p class="px-4 pb-4 text-sm text-gray-600">{faq.answer}</p>
    </details>
  ))}
</BlogPostLayout>
