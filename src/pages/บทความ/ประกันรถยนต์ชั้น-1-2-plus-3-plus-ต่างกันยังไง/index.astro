---
import BlogPostLayout from '../../../layouts/BlogPostLayout.astro';
import ArticleCalculatorCTA from '../../../components/templates/ArticleCalculatorCTA.astro';
import AffiliateCard from '../../../components/templates/AffiliateCard.astro';

const title = 'ประกันชั้น 1 2+ 3+ ต่างกันยังไง เลือกชั้นไหนดี 2569 | Kamnuanlek';
const description = 'ประกันรถยนต์ชั้น 1 2+ 3+ ต่างกันยังไง ตารางเทียบความคุ้มครอง รถใหม่ รถเก่า รถยังผ่อน ควรเลือกชั้นไหน พร้อมเครื่องคำนวณเบี้ยประกัน';
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://www.kamnuanlek.com').replace(/\/$/, '');
const canonical = `${siteUrl}/บทความ/ประกันรถยนต์ชั้น-1-2-plus-3-plus-ต่างกันยังไง/`;
const sourceVerifiedDate = '30 พฤษภาคม 2569';

const faqData = [
  {
    question: 'ประกันชั้น 1 กับ 2+ ต่างกันยังไง?',
    answer: 'ชั้น 1 คุ้มครองรถตัวเองกว้างที่สุด รวมชนเอง ไม่มีคู่กรณี ไฟไหม้ โจรกรรม และโดยทั่วไปมีน้ำท่วมตามเงื่อนไขกรมธรรม์ ส่วนชั้น 2+ คุ้มครองรถตัวเองเมื่อชนกับยานพาหนะที่มีคู่กรณี และมักคุ้มครองไฟไหม้/โจรกรรม แต่ไม่กว้างเท่าชั้น 1',
  },
  {
    question: 'ชั้น 2+ กับ 3+ ต่างกันยังไง?',
    answer: 'ทั้ง 2+ และ 3+ มักคุ้มครองรถตัวเองเฉพาะกรณีชนกับยานพาหนะที่มีคู่กรณี แต่ชั้น 2+ เพิ่มไฟไหม้และโจรกรรม ในขณะที่ 3+ มักไม่มีไฟไหม้และโจรกรรม',
  },
  {
    question: 'รถยังผ่อนควรทำประกันชั้นไหน?',
    answer: 'รถที่ยังผ่อนอยู่ควรเริ่มจากชั้น 1 เพราะสัญญาไฟแนนซ์หลายกรณีกำหนดให้มีความคุ้มครองสูงเพื่อป้องกันความเสียหายต่อหลักประกัน',
  },
];
---

<BlogPostLayout
  title={title}
  description={description}
  publishDate="2026-05-30"
  modifiedDate="2026-05-30"
  canonical={canonical}
  faqData={faqData}
>
  <h1 class="mb-4 text-2xl font-bold text-gray-900 sm:text-3xl">
    ประกันรถยนต์ชั้น 1 2+ 3+ ต่างกันยังไง
  </h1>

  <section data-ai-overview-answer class="not-prose my-6 rounded-xl border border-amber-200 bg-amber-50 p-4">
    <p class="text-sm font-semibold text-amber-800">คำตอบเร็ว</p>
    <p class="mt-1 text-lg font-bold text-amber-950">
      ชั้น 1 เหมาะกับรถใหม่ รถแพง หรือรถยังผ่อน เพราะคุ้มครองรถตัวเองกว้างที่สุด ส่วนชั้น 2+ เหมาะกับรถอายุประมาณ 3-7 ปีที่ต้องการลดเบี้ยแต่ยังอยากได้ไฟไหม้/โจรกรรม และชั้น 3+ เหมาะกับรถเก่าที่ต้องการเบี้ยต่ำแต่ยังอยากคุ้มครองกรณีชนกับรถคู่กรณี
    </p>
    <p class="mt-2 text-xs text-amber-800">ตรวจแหล่งอ้างอิง คปภ. เมื่อ {sourceVerifiedDate}</p>
  </section>

  <p>
    คำค้นว่า "ประกันชั้น 1 2+ 3+ ต่างกันยังไง" เป็นคำถามก่อนซื้อที่สำคัญ เพราะถ้าเลือกผิดชั้น
    อาจจ่ายแพงเกินจำเป็น หรือประหยัดเกินไปจนความคุ้มครองไม่พอ บทความนี้สรุปแบบใช้งานจริง
    แล้วพาไปคำนวณเบี้ยตามมูลค่ารถของคุณ
  </p>

  <ArticleCalculatorCTA
    title="คำนวณเบี้ยประกันรถของคุณก่อนเลือกชั้น"
    description="กรอกมูลค่ารถ อายุรถ และอายุผู้ขับ เพื่อเทียบชั้น 1, 2+, 3+ ในหน้าเดียว"
    href="/คำนวณค่าประกันรถยนต์/"
    buttonLabel="เปิดเครื่องคำนวณประกันรถยนต์"
  />

  <h2>ตารางเทียบชั้น 1, 2+, 3+</h2>
  <div class="not-prose my-4 overflow-x-auto">
    <table class="w-full min-w-[640px] border-collapse border border-gray-200 text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="border border-gray-200 px-3 py-2 text-left">ความคุ้มครอง</th>
          <th class="border border-gray-200 px-3 py-2 text-center">ชั้น 1</th>
          <th class="border border-gray-200 px-3 py-2 text-center">ชั้น 2+</th>
          <th class="border border-gray-200 px-3 py-2 text-center">ชั้น 3+</th>
        </tr>
      </thead>
      <tbody>
        <tr><td class="border border-gray-200 px-3 py-2">รถตัวเองเสียหายแบบไม่มีคู่กรณี</td><td class="border border-gray-200 px-3 py-2 text-center">มี</td><td class="border border-gray-200 px-3 py-2 text-center">ไม่มี</td><td class="border border-gray-200 px-3 py-2 text-center">ไม่มี</td></tr>
        <tr class="bg-gray-50"><td class="border border-gray-200 px-3 py-2">รถตัวเองเมื่อชนกับยานพาหนะ</td><td class="border border-gray-200 px-3 py-2 text-center">มี</td><td class="border border-gray-200 px-3 py-2 text-center">มี</td><td class="border border-gray-200 px-3 py-2 text-center">มี</td></tr>
        <tr><td class="border border-gray-200 px-3 py-2">ไฟไหม้ / โจรกรรม</td><td class="border border-gray-200 px-3 py-2 text-center">มี</td><td class="border border-gray-200 px-3 py-2 text-center">มี</td><td class="border border-gray-200 px-3 py-2 text-center">ส่วนใหญ่ไม่มี</td></tr>
        <tr class="bg-gray-50"><td class="border border-gray-200 px-3 py-2">บุคคลภายนอก</td><td class="border border-gray-200 px-3 py-2 text-center">มี</td><td class="border border-gray-200 px-3 py-2 text-center">มี</td><td class="border border-gray-200 px-3 py-2 text-center">มี</td></tr>
        <tr><td class="border border-gray-200 px-3 py-2">ค่าเบี้ยโดยทั่วไป</td><td class="border border-gray-200 px-3 py-2 text-center">สูงสุด</td><td class="border border-gray-200 px-3 py-2 text-center">กลาง</td><td class="border border-gray-200 px-3 py-2 text-center">ต่ำกว่า 2+</td></tr>
      </tbody>
    </table>
  </div>

  <h2>เลือกชั้นไหนดีตามสถานการณ์</h2>
  <ul>
    <li><strong>รถใหม่ 0-3 ปี หรือยังผ่อน:</strong> เริ่มดูชั้น 1 ก่อน เพราะค่าซ่อมและมูลค่ารถยังสูง</li>
    <li><strong>รถอายุ 4-7 ปี:</strong> เทียบชั้น 2+ กับชั้น 1 ถ้าต้องการลดเบี้ยแต่ยังห่วงไฟไหม้/โจรกรรม</li>
    <li><strong>รถเก่า 7 ปีขึ้นไป:</strong> เทียบชั้น 3+ หรือชั้น 3 ถ้ามูลค่ารถลดลงและต้องการควบคุมเบี้ยรายปี</li>
  </ul>

  <AffiliateCard
    category="insurance"
    affiliateUrl="/go/roojai-partners/?sub_id=article-car-insurance-class-comparison"
    partnerName="Roojai Partners"
    ctaText="ดูข้อเสนอหลังคำนวณ"
    subtext="คำนวณเบี้ยและใช้ผลลัพธ์เป็นฐานก่อนดูข้อเสนอพาร์ทเนอร์"
    isVisible={true}
  />

  <h2>แหล่งอ้างอิง</h2>
  <ul>
    <li><a href="https://www.oic.or.th/th/consumer/insurance/non-life/motor" target="_blank" rel="noopener noreferrer">สำนักงาน คปภ. - ประกันภัยรถยนต์</a></li>
    <li><a href="https://oiceservice.oic.or.th/" target="_blank" rel="noopener noreferrer">OIC e-Service - ตารางคำนวณเบื้องต้นสำหรับประกันภัยรถยนต์</a></li>
  </ul>

  <h2>อ่านต่อ</h2>
  <ul>
    <li><a href="/บทความ/รถเก่า-7-ปี-ควรทำประกันชั้นไหน/">รถเก่า 7 ปีควรทำประกันชั้นไหน</a></li>
    <li><a href="/บทความ/รถ-700000-ประกันชั้น-1-เท่าไร/">รถ 700,000 ประกันชั้น 1 เท่าไร</a></li>
    <li><a href="/คำนวณผ่อนรถ/">คำนวณผ่อนรถ</a> เพื่อดูภาระค่างวดรวมกับเบี้ยประกัน</li>
  </ul>
</BlogPostLayout>
