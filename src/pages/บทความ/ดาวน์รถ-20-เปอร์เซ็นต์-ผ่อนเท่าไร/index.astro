---
import BlogPostLayout from '../../../layouts/BlogPostLayout.astro';
import ArticleCalculatorCTA from '../../../components/templates/ArticleCalculatorCTA.astro';

const title = 'ดาวน์รถ 20% ผ่อนเท่าไร? ตัวอย่าง 700,000 ถึง 1,200,000 บาท | Kamnuanlek';
const description = 'ดาวน์รถ 20% ผ่อนเท่าไร ตัวอย่างรถ 700,000 900,000 และ 1,200,000 บาท ดอกเบี้ย flat rate 3% ผ่อน 60 เดือน พร้อมลิงก์คำนวณผ่อนรถ';
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://www.kamnuanlek.com').replace(/\/$/, '');
const canonical = `${siteUrl}/บทความ/ดาวน์รถ-20-เปอร์เซ็นต์-ผ่อนเท่าไร/`;

const faqData = [
  {
    question: 'ดาวน์รถ 20% ผ่อนเท่าไร?',
    answer: 'ขึ้นอยู่กับราคารถ ดอกเบี้ย และระยะเวลาผ่อน เช่น รถ 900,000 บาท ดาวน์ 20% ดอกเบี้ย flat rate 3% ผ่อน 60 เดือน จะผ่อนประมาณ 13,800 บาทต่อเดือน',
  },
  {
    question: 'ดาวน์ 20% ช่วยลดค่างวดอย่างไร?',
    answer: 'เงินดาวน์ 20% ลดเงินต้นที่ต้องจัดไฟแนนซ์ ทำให้ดอกเบี้ยรวมและค่างวดต่อเดือนลดลงเมื่อเทียบกับดาวน์ต่ำกว่า',
  },
  {
    question: 'ควรให้ค่างวดรถไม่เกินกี่เปอร์เซ็นต์ของเงินเดือน?',
    answer: 'โดยทั่วไปควรคุมค่างวดรถไม่เกิน 25-30% ของรายได้สุทธิต่อเดือน และต้องเผื่อประกัน น้ำมัน ซ่อมบำรุง และภาษีรถด้วย',
  },
];
---

<BlogPostLayout
  title={title}
  description={description}
  publishDate="2026-05-26"
  modifiedDate="2026-05-26"
  canonical={canonical}
  faqData={faqData}
>
  <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4">ดาวน์รถ 20% ผ่อนเท่าไร?</h1>

  <section class="not-prose my-6 rounded-xl border border-amber-200 bg-amber-50 p-4">
    <p class="text-sm font-semibold text-amber-800">คำตอบเร็ว</p>
    <p class="mt-1 text-lg font-bold text-amber-950">
      ถ้าดอกเบี้ย flat rate 3% และผ่อน 60 เดือน รถ 700,000 บาทผ่อนประมาณ 10,733 บาท/เดือน, รถ 900,000 บาทผ่อนประมาณ 13,800 บาท/เดือน, รถ 1,200,000 บาทผ่อนประมาณ 18,400 บาท/เดือน
    </p>
  </section>

  <p>
    เงินดาวน์ 20% เป็นจุดตั้งต้นที่หลายคนใช้ก่อนยื่นไฟแนนซ์ เพราะช่วยลดเงินกู้และดอกเบี้ยรวม บทความนี้ใช้ตัวอย่างดอกเบี้ย flat rate 3% ต่อปี ระยะเวลา 5 ปี หรือ 60 เดือน เพื่อให้เห็นภาพเร็ว
  </p>

  <ArticleCalculatorCTA
    title="คำนวณผ่อนรถจากเงื่อนไขจริง"
    description="ปรับราคารถ เงินดาวน์ ดอกเบี้ย และงวดผ่อนเองได้ทันที"
    href="/คำนวณผ่อนรถ/"
    buttonLabel="เปิดเครื่องคำนวณผ่อนรถ"
  />

  <h2>ตารางตัวอย่างดาวน์ 20%</h2>
  <div class="overflow-x-auto my-4">
    <table class="w-full border-collapse text-sm">
      <thead>
        <tr class="bg-gray-50">
          <th class="border border-gray-200 px-3 py-2 text-left">ราคารถ</th>
          <th class="border border-gray-200 px-3 py-2 text-right">เงินดาวน์ 20%</th>
          <th class="border border-gray-200 px-3 py-2 text-right">ยอดจัดไฟแนนซ์</th>
          <th class="border border-gray-200 px-3 py-2 text-right">ค่างวดประมาณ</th>
        </tr>
      </thead>
      <tbody>
        <tr><td class="border border-gray-200 px-3 py-2">700,000</td><td class="border border-gray-200 px-3 py-2 text-right">140,000</td><td class="border border-gray-200 px-3 py-2 text-right">560,000</td><td class="border border-gray-200 px-3 py-2 text-right font-semibold">10,733</td></tr>
        <tr class="bg-gray-50"><td class="border border-gray-200 px-3 py-2">900,000</td><td class="border border-gray-200 px-3 py-2 text-right">180,000</td><td class="border border-gray-200 px-3 py-2 text-right">720,000</td><td class="border border-gray-200 px-3 py-2 text-right font-semibold">13,800</td></tr>
        <tr><td class="border border-gray-200 px-3 py-2">1,200,000</td><td class="border border-gray-200 px-3 py-2 text-right">240,000</td><td class="border border-gray-200 px-3 py-2 text-right">960,000</td><td class="border border-gray-200 px-3 py-2 text-right font-semibold">18,400</td></tr>
      </tbody>
    </table>
  </div>

  <h2>สูตรที่ใช้</h2>
  <ol>
    <li>เงินดาวน์ = ราคารถ x 20%</li>
    <li>ยอดจัดไฟแนนซ์ = ราคารถ - เงินดาวน์</li>
    <li>ดอกเบี้ยรวมแบบ flat rate = ยอดจัดไฟแนนซ์ x ดอกเบี้ยต่อปี x จำนวนปี</li>
    <li>ค่างวด = (ยอดจัดไฟแนนซ์ + ดอกเบี้ยรวม) ÷ จำนวนเดือน</li>
  </ol>

  <h2>อย่าดูแค่ค่างวด</h2>
  <p>
    ก่อนตัดสินใจควรรวมค่าใช้จ่ายอื่น เช่น ประกันรถยนต์ ภาษีรถ ค่าน้ำมัน ค่าบำรุงรักษา และเงินสำรองฉุกเฉิน หากค่างวดทำให้เงินสดตึงเกินไป ควรเพิ่มเงินดาวน์ ลดราคารถ หรือเลือกงวดที่เหมาะสมกว่า
  </p>

  <ul>
    <li><a href="/คำนวณเงินเดือนสุทธิ/">คำนวณเงินเดือนสุทธิ</a> เพื่อดูรายได้หลังหักภาษี</li>
    <li><a href="/คำนวณเบี้ยประกันรถยนต์/">คำนวณเบี้ยประกันรถยนต์</a></li>
    <li><a href="/บทความ/รถ-700000-ประกันชั้น-1-เท่าไร/">รถ 700,000 ประกันชั้น 1 เท่าไร</a></li>
    <li><a href="/บทความ/ประกันรถยนต์ชั้น-1-2-plus-3-plus-ต่างกันยังไง/">ประกันชั้น 1 2+ 3+ ต่างกันยังไง</a></li>
    <li><a href="/คำนวณค่าภาษีรถยนต์/">คำนวณค่าภาษีรถยนต์</a></li>
  </ul>

  <h2>คำถามที่พบบ่อย</h2>
  {faqData.map((faq) => (
    <details class="mb-3 rounded-lg border border-gray-200 bg-white">
      <summary class="cursor-pointer px-4 py-3 font-medium text-gray-900">{faq.question}</summary>
      <p class="px-4 pb-4 text-sm text-gray-600">{faq.answer}</p>
    </details>
  ))}
</BlogPostLayout>
