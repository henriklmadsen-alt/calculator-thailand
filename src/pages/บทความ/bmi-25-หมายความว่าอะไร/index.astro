---
import BlogPostLayout from '../../../layouts/BlogPostLayout.astro';
import ArticleCalculatorCTA from '../../../components/templates/ArticleCalculatorCTA.astro';

const title = 'BMI 25 หมายความว่าอะไร สูง 170 หนักเท่าไร | Kamnuanlek';
const description = 'BMI 25 หมายความว่าอะไร วิธีคำนวณน้ำหนักจากส่วนสูง ตัวอย่างสูง 170 ซม. BMI 25 เท่ากับประมาณ 72.25 กก. พร้อมเครื่องคำนวณ BMI';
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://www.kamnuanlek.com').replace(/\/$/, '');
const canonical = `${siteUrl}/บทความ/bmi-25-หมายความว่าอะไร/`;

const faqData = [
  {
    question: 'BMI 25 หมายความว่าอะไร?',
    answer: 'BMI 25 เป็นจุดเริ่มต้นของกลุ่มน้ำหนักเกินตามเกณฑ์ทั่วไป แต่ควรดูรอบเอว มวลกล้ามเนื้อ อายุ และสุขภาพร่วมด้วย',
  },
  {
    question: 'สูง 170 ซม. ถ้า BMI 25 จะหนักเท่าไร?',
    answer: 'น้ำหนัก = BMI x ส่วนสูงเมตร x ส่วนสูงเมตร = 25 x 1.70 x 1.70 = 72.25 กิโลกรัม',
  },
  {
    question: 'BMI 25 ต้องลดน้ำหนักทันทีไหม?',
    answer: 'ควรใช้เป็นสัญญาณให้ตรวจพฤติกรรมสุขภาพและปรึกษาผู้เชี่ยวชาญหากมีโรคประจำตัว ไม่ควรใช้ BMI ตัวเดียวตัดสินสุขภาพทั้งหมด',
  },
];
---

<BlogPostLayout title={title} description={description} publishDate="2026-05-28" modifiedDate="2026-05-28" canonical={canonical} faqData={faqData}>
  <h1>BMI 25 หมายความว่าอะไร สูง 170 หนักเท่าไร</h1>

  <section class="not-prose my-6 rounded-xl border border-rose-200 bg-rose-50 p-4">
    <p class="text-sm font-semibold text-rose-800">คำตอบเร็ว</p>
    <p class="mt-1 text-lg font-bold text-rose-950">ถ้าสูง 170 ซม. และ BMI 25 น้ำหนักจะอยู่ประมาณ 72.25 กิโลกรัม</p>
  </section>

  <ArticleCalculatorCTA
    title="คำนวณ BMI จากส่วนสูงและน้ำหนัก"
    description="กรอกส่วนสูง น้ำหนัก เพศ และอายุเพื่อดูค่า BMI พร้อมคำแปลผล"
    href="/คำนวณ-bmi/"
    buttonLabel="เปิดเครื่องคำนวณ BMI"
  />

  <h2>สูตร BMI 25</h2>
  <p>BMI = น้ำหนัก (กก.) / ส่วนสูงเมตร² ดังนั้นถ้าต้องการหาน้ำหนักจาก BMI ให้กลับสูตรเป็น:</p>
  <p><strong>น้ำหนัก = BMI x ส่วนสูงเมตร x ส่วนสูงเมตร</strong></p>

  <h2>ตัวอย่างสูง 170 ซม.</h2>
  <ol>
    <li>แปลงส่วนสูง 170 ซม. เป็น 1.70 เมตร</li>
    <li>น้ำหนัก = 25 x 1.70 x 1.70</li>
    <li>น้ำหนัก = 72.25 กิโลกรัม</li>
  </ol>

  <ul>
    <li><a href="/คำนวณ-bmi/">คำนวณ BMI</a></li>
    <li><a href="/บทความ/bmi-27-หมายความว่าอะไร/">BMI 27 หมายความว่าอะไร</a></li>
    <li><a href="/บทความ/วิธีวัด-bmi-อย่างถูกต้อง/">วิธีวัด BMI อย่างถูกต้อง</a></li>
  </ul>
</BlogPostLayout>
