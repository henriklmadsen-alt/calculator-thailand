---
import BlogPostLayout from '../../../layouts/BlogPostLayout.astro';
import ArticleCalculatorCTA from '../../../components/templates/ArticleCalculatorCTA.astro';

const title = 'ถอด VAT จากราคารวม สูตรหาร 1.07 พร้อมตัวอย่าง 2569 | Kamnuanlek';
const description = 'สูตรถอด VAT จากราคารวมคือ ราคารวม VAT หาร 1.07 พร้อมตัวอย่าง 1,070, 5,000, 10,000 บาท และลิงก์เครื่องคำนวณ VAT 7%';
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://www.kamnuanlek.com').replace(/\/$/, '');
const canonical = `${siteUrl}/บทความ/ถอด-vat-จากราคารวม-สูตร-1-07/`;
const checkedDate = '30 พฤษภาคม 2569';

const faqData = [
  {
    question: 'สูตรถอด VAT จากราคารวมคืออะไร?',
    answer: 'ราคาก่อน VAT = ราคารวม VAT ÷ 1.07 และ VAT = ราคารวม VAT - ราคาก่อน VAT',
  },
  {
    question: 'ถอด VAT ต่างจากบวก VAT อย่างไร?',
    answer: 'ถอด VAT ใช้เมื่อราคาที่มีอยู่รวมภาษีแล้ว ส่วนบวก VAT ใช้เมื่อราคาที่มีอยู่ยังไม่รวมภาษี',
  },
  {
    question: 'ถอด VAT ใช้กับใบกำกับภาษีได้ไหม?',
    answer: 'ใช้ช่วยตรวจยอดได้ แต่เอกสารจริงควรอิงระบบบัญชีและหลักเกณฑ์ของกรมสรรพากร',
  },
];

const examples = [
  { total: '1,070', before: '1,000.00', vat: '70.00' },
  { total: '5,000', before: '4,672.90', vat: '327.10' },
  { total: '10,000', before: '9,345.79', vat: '654.21' },
];
---

<BlogPostLayout title={title} description={description} publishDate="2026-05-30" modifiedDate="2026-05-30" canonical={canonical} faqData={faqData}>
  <h1>ถอด VAT จากราคารวม สูตรหาร 1.07 พร้อมตัวอย่าง</h1>

  <section class="not-prose my-6 rounded-xl border border-sky-200 bg-sky-50 p-4">
    <p class="text-sm font-semibold text-sky-800">คำตอบเร็ว</p>
    <p class="mt-1 text-xl font-bold text-sky-950">ราคารวม VAT ÷ 1.07 = ราคาก่อน VAT</p>
    <p class="mt-1 text-sm text-sky-900">จากนั้นนำราคารวม VAT - ราคาก่อน VAT เพื่อหา VAT 7% ตรวจอัตรา VAT ล่าสุดเมื่อ {checkedDate}</p>
  </section>

  <p>
    การถอด VAT ใช้เมื่อยอดที่คุณมีเป็นยอดรวมภาษีแล้ว เช่น ใบเสร็จหรือราคาขายที่ระบุว่า “รวม VAT”
    สูตรหลักคือหาร 1.07 เพื่อย้อนกลับไปหาฐานก่อนภาษี
  </p>

  <ArticleCalculatorCTA
    title="ถอด VAT จากราคารวมอัตโนมัติ"
    description="เลือกโหมดแยก VAT แล้วกรอกยอดรวม เช่น 1070, 5000 หรือ 10000"
    href="/คำนวณภาษีมูลค่าเพิ่ม/"
    buttonLabel="เปิดเครื่องคำนวณ VAT"
  />

  <h2>สูตรถอด VAT</h2>
  <ul>
    <li>ราคาก่อน VAT = ราคารวม VAT ÷ 1.07</li>
    <li>VAT = ราคารวม VAT - ราคาก่อน VAT</li>
    <li>ตรวจกลับ = ราคาก่อน VAT x 1.07 ควรได้ใกล้เคียงราคารวมเดิม</li>
  </ul>

  <h2>ตารางตัวอย่างถอด VAT</h2>
  <table class="w-full text-sm border-collapse my-4">
    <thead>
      <tr class="border-b border-gray-200 text-left">
        <th class="py-2 pr-2">ราคารวม VAT</th>
        <th class="py-2 pr-2 text-right">ราคาก่อน VAT</th>
        <th class="py-2 text-right">VAT 7%</th>
      </tr>
    </thead>
    <tbody>
      {examples.map((item) => (
        <tr class="border-b border-gray-100">
          <td class="py-2 pr-2">{item.total}</td>
          <td class="py-2 pr-2 text-right">{item.before}</td>
          <td class="py-2 text-right">{item.vat}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2>อย่าสับสนระหว่างบวก VAT กับถอด VAT</h2>
  <p>
    ถ้ายอดเดิมยังไม่รวม VAT ให้คูณ 1.07 แต่ถ้ายอดเดิมรวม VAT แล้ว ให้หาร 1.07
    การใช้สูตรผิดจะทำให้ใบเสนอราคา กำไร และเอกสารบัญชีคลาดเคลื่อนทันที
  </p>

  <h2>อ่านต่อในกลุ่ม VAT</h2>
  <ul>
    <li><a href="/บทความ/1000-บวก-vat-7-เป็นเท่าไร/">1,000 บวก VAT 7% เป็นเท่าไร</a></li>
    <li><a href="/บทความ/1070-หาร-1-07-ถอด-vat/">1,070 หาร 1.07 ถอด VAT</a></li>
    <li><a href="/บทความ/10000-หาร-1-07-ถอด-vat/">10,000 หาร 1.07 ถอด VAT</a></li>
    <li><a href="/คำนวณ-vat-หลายรายการ/">คำนวณ VAT หลายรายการ</a></li>
  </ul>

  <h2>แหล่งข้อมูลทางการ</h2>
  <ul>
    <li><a href="https://www.rd.go.th/region/08/chiangrai/265/3664.html" target="_blank" rel="noopener noreferrer">กรมสรรพากร: ขยาย VAT 7% ถึง 30 กันยายน 2569</a></li>
    <li><a href="https://www.rd.go.th/59935.html" target="_blank" rel="noopener noreferrer">กรมสรรพากร: โครงสร้างภาษีมูลค่าเพิ่มรวม 7%</a></li>
  </ul>

  <h2>คำถามที่พบบ่อย</h2>
  {faqData.map((faq) => (
    <details class="mb-3 rounded-lg border border-gray-200 bg-white">
      <summary class="cursor-pointer px-4 py-3 font-medium text-gray-900">{faq.question}</summary>
      <p class="px-4 pb-4 text-sm text-gray-600">{faq.answer}</p>
    </details>
  ))}
</BlogPostLayout>
