---
import BlogPostLayout from '../../../layouts/BlogPostLayout.astro';
import ArticleCalculatorCTA from '../../../components/templates/ArticleCalculatorCTA.astro';
import AffiliateCard from '../../../components/templates/AffiliateCard.astro';

const title = 'รถเก่า 7 ปี ควรทำประกันชั้นไหน 2569 | Kamnuanlek';
const description = 'รถเก่า 7 ปีควรทำประกันชั้นไหน เทียบชั้น 1, 2+, 3+, 3 ตามมูลค่ารถ งบเบี้ย และความเสี่ยง พร้อมเครื่องคำนวณเบี้ยประกันรถยนต์';
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://www.kamnuanlek.com').replace(/\/$/, '');
const canonical = `${siteUrl}/บทความ/รถเก่า-7-ปี-ควรทำประกันชั้นไหน/`;
const sourceVerifiedDate = '30 พฤษภาคม 2569';

const faqData = [
  {
    question: 'รถเก่า 7 ปีทำประกันชั้น 1 ได้ไหม?',
    answer: 'ทำได้ในบางบริษัท แต่ขึ้นกับยี่ห้อ รุ่น สภาพรถ ประวัติเคลม และทุนประกัน บริษัทประกันบางแห่งจำกัดอายุรถสำหรับชั้น 1 หรือเสนอเบี้ยที่สูงจนไม่คุ้ม',
  },
  {
    question: 'รถอายุ 7 ปีควรเลือกชั้น 2+ หรือ 3+?',
    answer: 'ถ้ายังกังวลเรื่องไฟไหม้หรือโจรกรรม ให้เริ่มเทียบชั้น 2+ ถ้าต้องการลดเบี้ยและรับความเสี่ยงไฟไหม้/โจรกรรมเองได้ ชั้น 3+ อาจเหมาะกว่า',
  },
  {
    question: 'รถเก่ามูลค่าต่ำควรดูอะไรเป็นอันดับแรก?',
    answer: 'ดูมูลค่ารถปัจจุบัน เทียบกับเบี้ยต่อปีและค่าซ่อมที่รับเองได้ ถ้าเบี้ยชั้น 1 ใกล้เคียงค่าซ่อมใหญ่หลายส่วน อาจลดเป็นชั้น 2+ หรือ 3+',
  },
];
---

<BlogPostLayout
  title={title}
  description={description}
  publishDate="2026-05-30"
  modifiedDate="2026-05-30"
  canonical={canonical}
  faqData={faqData}
>
  <h1 class="mb-4 text-2xl font-bold text-gray-900 sm:text-3xl">
    รถเก่า 7 ปี ควรทำประกันชั้นไหน
  </h1>

  <section data-ai-overview-answer class="not-prose my-6 rounded-xl border border-amber-200 bg-amber-50 p-4">
    <p class="text-sm font-semibold text-amber-800">คำตอบเร็ว</p>
    <p class="mt-1 text-lg font-bold text-amber-950">
      รถอายุ 7 ปีควรเริ่มเทียบชั้น 2+ กับ 3+ ก่อน ถ้ารถยังมีมูลค่าสูงหรือยังอยากคุ้มครองไฟไหม้/โจรกรรม ให้ดูชั้น 2+ ถ้าต้องการลดเบี้ยและยอมรับความเสี่ยงค่าซ่อมรถตัวเองได้ ให้ดูชั้น 3+ หรือชั้น 3
    </p>
    <p class="mt-2 text-xs text-amber-800">ตรวจแหล่งอ้างอิง คปภ. เมื่อ {sourceVerifiedDate}</p>
  </section>

  <p>
    รถอายุ 7 ปีเป็นจุดที่หลายคนเริ่มลังเลว่าจะต่อชั้น 1 ต่อไป หรือปรับเป็นชั้น 2+ / 3+
    เพราะมูลค่ารถลดลง แต่เบี้ยชั้น 1 ยังสูง การตัดสินใจควรดูจากมูลค่ารถจริง งบเบี้ยต่อปี
    และความเสี่ยงที่รับเองได้
  </p>

  <ArticleCalculatorCTA
    title="เทียบเบี้ยรถเก่าก่อนต่อประกัน"
    description="ใส่มูลค่ารถ อายุรถ และประวัติเคลม เพื่อดูช่วงเบี้ยแต่ละชั้น"
    href="/คำนวณเบี้ยประกันรถยนต์/"
    buttonLabel="คำนวณเบี้ยประกันรถยนต์"
  />

  <h2>แนวทางเลือกประกันสำหรับรถอายุ 7 ปี</h2>
  <div class="not-prose my-4 overflow-x-auto">
    <table class="w-full min-w-[620px] border-collapse border border-gray-200 text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="border border-gray-200 px-3 py-2 text-left">สถานการณ์</th>
          <th class="border border-gray-200 px-3 py-2 text-left">ชั้นที่ควรเริ่มเทียบ</th>
          <th class="border border-gray-200 px-3 py-2 text-left">เหตุผล</th>
        </tr>
      </thead>
      <tbody>
        <tr><td class="border border-gray-200 px-3 py-2">รถยังผ่อน หรือมูลค่ายังสูง</td><td class="border border-gray-200 px-3 py-2 font-semibold">ชั้น 1 หรือ 2+</td><td class="border border-gray-200 px-3 py-2">ยังต้องคุมความเสี่ยงค่าซ่อมและทุนประกัน</td></tr>
        <tr class="bg-gray-50"><td class="border border-gray-200 px-3 py-2">รถใช้งานทุกวันในเมือง</td><td class="border border-gray-200 px-3 py-2 font-semibold">ชั้น 2+</td><td class="border border-gray-200 px-3 py-2">สมดุลระหว่างเบี้ยกับความคุ้มครองรถตัวเองเมื่อมีคู่กรณี</td></tr>
        <tr><td class="border border-gray-200 px-3 py-2">รถมูลค่าลดลงมาก</td><td class="border border-gray-200 px-3 py-2 font-semibold">ชั้น 3+ หรือ 3</td><td class="border border-gray-200 px-3 py-2">ลดค่าเบี้ยต่อปีและเน้นคุ้มครองบุคคลภายนอก</td></tr>
      </tbody>
    </table>
  </div>

  <h2>เช็กลิสต์ก่อนลดชั้นประกัน</h2>
  <ol>
    <li>เช็กราคาตลาดรถปัจจุบัน ไม่ใช้ราคาซื้อเมื่อหลายปีก่อน</li>
    <li>ดูทุนประกันที่บริษัทเสนอว่าใกล้เคียงมูลค่ารถจริงหรือไม่</li>
    <li>เทียบเบี้ยชั้น 1 กับ 2+ ถ้าต่างกันหลายพันบาทต่อปี ให้ดูความคุ้มครองที่เสียไป</li>
    <li>ประเมินเงินสำรองค่าซ่อม ถ้าชนเองแล้วไม่มีประกันรถตัวเอง คุณจ่ายเองไหวไหม</li>
  </ol>

  <AffiliateCard
    category="insurance"
    affiliateUrl="/go/roojai-partners/?sub_id=article-old-car-insurance"
    partnerName="Roojai Partners"
    ctaText="ดูข้อเสนอหลังคำนวณ"
    subtext="ใช้ผลคำนวณเบี้ยเป็นฐานก่อนดูข้อเสนอพาร์ทเนอร์"
    isVisible={true}
  />

  <h2>แหล่งอ้างอิง</h2>
  <ul>
    <li><a href="https://www.oic.or.th/th/consumer/insurance/non-life/motor" target="_blank" rel="noopener noreferrer">สำนักงาน คปภ. - ประกันภัยรถยนต์</a></li>
    <li><a href="https://oiceservice.oic.or.th/" target="_blank" rel="noopener noreferrer">OIC e-Service - ตารางคำนวณเบื้องต้นสำหรับประกันภัยรถยนต์</a></li>
  </ul>

  <h2>อ่านต่อ</h2>
  <ul>
    <li><a href="/บทความ/ประกันรถยนต์ชั้น-1-2-plus-3-plus-ต่างกันยังไง/">ประกันชั้น 1, 2+, 3+ ต่างกันยังไง</a></li>
    <li><a href="/คำนวณค่าประกันรถยนต์/">คำนวณค่าประกันรถยนต์</a></li>
    <li><a href="/คำนวณค่าภาษีรถยนต์/">คำนวณค่าภาษีรถยนต์ประจำปี</a></li>
  </ul>
</BlogPostLayout>
