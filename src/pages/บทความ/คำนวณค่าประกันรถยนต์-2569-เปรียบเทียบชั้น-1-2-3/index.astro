  <h2>เปรียบเทียบชั้นประกันรถยนต์ 2569 (รถมูลค่า 600,000 บาท)</h2>

  <div class="not-prose my-4 overflow-x-auto">
    <table class="w-full min-w-[580px] border-collapse border border-gray-200 text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="border border-gray-200 px-3 py-2 text-left">ชั้นประกัน</th>
          <th class="border border-gray-200 px-3 py-2 text-left">ครอบคลุม</th>
          <th class="border border-gray-200 px-3 py-2 text-left">เบี้ยประมาณ (รถ 600k)</th>
          <th class="border border-gray-200 px-3 py-2 text-left">เหมาะสำหรับ</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="border border-gray-200 px-3 py-2 font-medium">ชั้น 1</td>
          <td class="border border-gray-200 px-3 py-2">ครบทุกกรณี รวมโจรกรรม</td>
          <td class="border border-gray-200 px-3 py-2">15,000–25,000/ปี</td>
          <td class="border border-gray-200 px-3 py-2">รถใหม่, ยังผ่อน</td>
        </tr>
        <tr class="bg-gray-50">
          <td class="border border-gray-200 px-3 py-2 font-medium">ชั้น 2+</td>
          <td class="border border-gray-200 px-3 py-2">ชนแล้วหนี, ไฟไหม้, โจรกรรม</td>
          <td class="border border-gray-200 px-3 py-2">7,000–12,000/ปี</td>
          <td class="border border-gray-200 px-3 py-2">รถอายุ 1–5 ปี</td>
        </tr>
        <tr>
          <td class="border border-gray-200 px-3 py-2 font-medium">ชั้น 3+</td>
          <td class="border border-gray-200 px-3 py-2">ชนแล้วหนี</td>
          <td class="border border-gray-200 px-3 py-2">4,000–7,000/ปี</td>
          <td class="border border-gray-200 px-3 py-2">รถอายุ 5–10 ปี</td>
        </tr>
        <tr class="bg-gray-50">
          <td class="border border-gray-200 px-3 py-2 font-medium">ชั้น 3</td>
          <td class="border border-gray-200 px-3 py-2">คู่กรณีเท่านั้น</td>
          <td class="border border-gray-200 px-3 py-2">2,500–5,000/ปี</td>
          <td class="border border-gray-200 px-3 py-2">รถเก่า ทุนน้อย</td>
        </tr>
        <tr>
          <td class="border border-gray-200 px-3 py-2 font-medium">พรบ.</td>
