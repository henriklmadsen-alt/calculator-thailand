        </tr>
        <tr>
          <td class="border border-gray-200 px-3 py-2">บาดเจ็บ/เสียชีวิตบุคคลภายนอก</td>
          <td class="border border-gray-200 px-3 py-2 text-center">✓</td>
          <td class="border border-gray-200 px-3 py-2 text-center">✓</td>
          <td class="border border-gray-200 px-3 py-2 text-center">✓</td>
