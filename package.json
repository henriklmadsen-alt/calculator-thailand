{
  "name": "calculator-thailand",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/generate-release-metadata.mjs && npx astro build && node scripts/generate-sitemap.mjs",
    "preview": "astro preview",
    "start": "node server.mjs",
    "astro": "astro",
    "audit:affiliate": "node scripts/verify-affiliate-config.mjs",
    "audit:gsc": "node scripts/verify-gsc-setup.mjs",
    "audit:google": "node scripts/verify-google-data-connections.mjs",
    "audit:traffic-recovery": "node scripts/seo-traffic-recovery-audit.mjs",
    "audit:index-quality": "node scripts/index-quality-policy-audit.mjs",
    "audit:cwv-weekly": "node scripts/weekly-cwv-monitor.mjs",
    "audit:freshness": "node scripts/content-freshness-queue.mjs",
    "postdeploy:indexing": "node scripts/submit-sitemaps-to-gsc.mjs && node scripts/submit-indexnow.mjs --site-url https://www.kamnuanlek.com",
    "report:seo": "node scripts/generate-seo-growth-report.mjs",
    "report:indexation-queue": "node scripts/indexation-priority-queue.mjs",
    "report:gsc-gaps": "node scripts/gsc-query-gap-planner.mjs",
    "report:promotion-pack": "node scripts/manual-promotion-pack.mjs",
    "report:serp-titles": "node scripts/serp-title-compare.mjs",
    "growth:daily-loop": "node scripts/growth-daily-loop.mjs",
    "check": "npm run build",
    "ceo:survival-check": "node scripts/ceo_survival_check.mjs",
    "ceo:weekly-review": "node scripts/generate_weekly_ceo_ops_review.mjs",
    "ceo:cmo-loop": "node scripts/ceo_cmo_handoff_loop.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@astrojs/node": "^10.1.1",
    "@sentry/astro": "^10.50.0",
    "@sentry/tracing": "^7.120.4",
    "@tailwindcss/postcss": "^4.3.0",
    "astro": "^6.3.7",
    "google-auth-library": "^10.6.2",
    "googleapis": "^172.0.0",
    "html2canvas": "^1.4.1",
    "pg": "^8.13.0",
    "postcss": "^8.5.15",
    "stripe": "^22.0.2",
    "tailwindcss": "^4.3.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  }
}
